    + getProgress() : int
  }

  class Kegiatan {
    # id : bigint <<PK>>
    --
    + proker_id : bigint <<FK>>
    + nama_kegiatan : string
    + deskripsi : text
    + tanggal_mulai : date
    + tanggal_selesai : date
    + tempat : string
