@startuml CLASS_FULL_COMPLETE_SYSTEM
!theme plain
title Class Diagram - SILAB Complete System (Full Detail)

skinparam classAttributeIconSize 0
skinparam linetype ortho

' ============================================
' PACKAGE: CORE AUTHENTICATION
' ============================================
package "Core Authentication & Authorization" <<Rectangle>> #FFE4B5 {
  
  class User {
    # id : bigint <<PK>>
    --
    + name : string
    + username : string <<unique>>
    + email : string <<unique>>
    + password : string
    + nim : string {nullable}
    + phone : string
    + address : text
    + avatar : string
    + email_verified_at : timestamp
    + remember_token : string
    + created_at : timestamp
    + updated_at : timestamp
    --
    + hasRole(role : string) : bool
    + hasPermissionTo(permission : string) : bool
    + assignRole(role : Role) : void
    + givePermissionTo(permission : Permission) : void
    + getCurrentKepengurusan() : ?KepengurusanLab
    + getCurrentLab() : ?Laboratorium
    + isActiveInKepengurusan(id : int) : bool
  }

  class Role {
    # id : bigint <<PK>>
    --
    + name : string <<unique>>
    + guard_name : string
    + created_at : timestamp
    + updated_at : timestamp
    --
    + givePermissionTo(permission : Permission) : void
    + hasPermissionTo(permission : string) : bool
    + syncPermissions(permissions : array) : void
  }

  class Permission {
    # id : bigint <<PK>>
    --
    + name : string <<unique>>
    + guard_name : string
    + created_at : timestamp
    + updated_at : timestamp
  }

  class Laboratorium {
    # id : bigint <<PK>>
    --
    + nama_lab : string
    + deskripsi : text
    + ruangan : string
    + created_at : timestamp
    + updated_at : timestamp
  }

  class TahunKepengurusan {
    # id : bigint <<PK>>
    --
    + tahun : string
    + tahun_mulai : int
    + tahun_selesai : int
    + is_active : bool
    + created_at : timestamp
    + updated_at : timestamp
    --
    + activate() : void
    + deactivate() : void
  }

  class KepengurusanLab {
    # id : bigint <<PK>>
    --
    + laboratorium_id : bigint <<FK>>
    + tahun_kepengurusan_id : bigint <<FK>>
    + is_active : bool
    + created_at : timestamp
    + updated_at : timestamp
    --
    + setActive() : void
    + isActive() : bool
  }

  class Struktur {
    # id : bigint <<PK>>
    --
    + struktur : string <<unique>>
    + jabatan_tunggal : bool
    + default_role_id : bigint <<FK>>
    + created_at : timestamp
    + updated_at : timestamp
    --
    + isTunggal() : bool
    + getDefaultRole() : Role
  }

  class Anggota {
    # id : bigint <<PK>>
    --
    + user_id : bigint <<FK>>
    + kepengurusan_lab_id : bigint <<FK>>
    + struktur_id : bigint <<FK>>
    + created_at : timestamp
    + updated_at : timestamp
    --
    + assignRoleFromPosition() : void
    + assignDynamicPermissions() : void
  }

  class StrukturPermissions {
    # id : bigint <<PK>>
    --
    + jabatan : string
    + permission : string
    + created_at : timestamp
    + updated_at : timestamp
    --
    {static} + getPermissionsForJabatan(jabatan : string) : Collection
  }
}

' ============================================
' PACKAGE: PRAKTIKUM (ACADEMIC)
' ============================================
package "Praktikum & Academic System" <<Rectangle>> #B0E0E6 {
  
  class Praktikum {
    # id : bigint <<PK>>
    --
    + kepengurusan_lab_id : bigint <<FK>>
    + nama_praktikum : string
    + kode_praktikum : string
    + semester : string
    + sks : int
    + deskripsi : text
    + created_at : timestamp
    + updated_at : timestamp
    --
    + getTotalPraktikan() : int
    + getActiveModul() : Collection
    + calculateNilaiAkhir(praktikan_id : int) : float
  }

  class AslabPraktikum {
    # id : bigint <<PK>>
    --
    + praktikum_id : bigint <<FK>>
    + user_id : bigint <<FK>>
    + created_at : timestamp
    + updated_at : timestamp
  }

  class Praktikan {
    # id : bigint <<PK>>
    --
    + user_id : bigint <<FK>>
    + praktikum_id : bigint <<FK>>
    + kelas : string
    + tahun_ajaran : string
    + created_at : timestamp
    + updated_at : timestamp
    --
    + getNilaiAkhir() : float
    + isLulus() : bool
    + getKehadiran() : float
  }

  class ModulPraktikum {
    # id : bigint <<PK>>
    --
    + praktikum_id : bigint <<FK>>
    + judul : string
    + deskripsi : text
    + file_path : string
    + urutan : int
    + created_at : timestamp
    + updated_at : timestamp
    --
    + getDownloadUrl() : string
    + isAvailable() : bool
  }

  class PertemuanPraktikum {
    # id : bigint <<PK>>
    --
    + praktikum_id : bigint <<FK>>
    + pertemuan_ke : int
    + judul : string
    + tanggal : date
    + created_at : timestamp
    + updated_at : timestamp
    --
    + createAbsensiRecords() : void
    + getKehadiranStats() : array
  }

  class Absensi {
    # id : bigint <<PK>>
    --
    + praktikan_id : bigint <<FK>>
    + pertemuan_praktikum_id : bigint <<FK>>
    + status : enum {hadir,izin,sakit,alpha}
    + keterangan : text
    + created_at : timestamp
    + updated_at : timestamp
    --
    + isHadir() : bool
    + markAsHadir() : void
  }

  class TugasPraktikum {
    # id : bigint <<PK>>
    --
    + praktikum_id : bigint <<FK>>
    + judul : string
    + deskripsi : text
    + deadline : datetime
    + created_at : timestamp
    + updated_at : timestamp
    --
    + isDeadlinePassed() : bool
    + getSubmissionStats() : array
    + hasRubrik() : bool
  }

  class PengumpulanTugas {
    # id : bigint <<PK>>
    --
    + tugas_praktikum_id : bigint <<FK>>
    + praktikan_id : bigint <<FK>>
    + file_path : string
    + keterangan : text
    + nilai : decimal(5,2)
    + status : enum {pending,dinilai}
    + dinilai_at : timestamp
    + submitted_at : timestamp
    + created_at : timestamp
    + updated_at : timestamp
    --
    + isDinilai() : bool
    + isLate() : bool
    + getNilaiWithRubrik() : float
  }

  class RubrikPenilaian {
    # id : bigint <<PK>>
    --
    + tugas_praktikum_id : bigint <<FK>>
    + nama_rubrik : string
    + deskripsi : text
    + bobot_total : decimal(5,2)
    + is_active : bool
    + created_at : timestamp
    + updated_at : timestamp
    --
    + activate() : void
    + deactivate() : void
    + validateBobot() : bool
  }

  class KomponenRubrik {
    # id : bigint <<PK>>
    --
    + rubrik_penilaian_id : bigint <<FK>>
    + nama_komponen : string
    + deskripsi : text
    + bobot : decimal(5,2)
    + nilai_maksimal : decimal(5,2)
    + urutan : int
    + created_at : timestamp
    + updated_at : timestamp
    --
    + calculateWeightedScore(nilai : float) : float
  }

  class NilaiRubrik {
    # id : bigint <<PK>>
    --
    + komponen_rubrik_id : bigint <<FK>>
    + praktikan_id : bigint <<FK>>
    + pengumpulan_tugas_id : bigint <<FK>>
    + nilai : decimal(5,2)
    + catatan : text
    + dinilai_oleh : bigint <<FK>>
    + dinilai_at : timestamp
    + created_at : timestamp
    + updated_at : timestamp
    --
    + getWeightedScore() : float
  }

  class NilaiTambahan {
    # id : bigint <<PK>>
    --
    + tugas_praktikum_id : bigint <<FK>>
    + praktikan_id : bigint <<FK>>
    + nilai : decimal(5,2)
    + kategori : string
    + keterangan : text
    + diberikan_oleh : bigint <<FK>>
    + diberikan_at : timestamp
    + created_at : timestamp
    + updated_at : timestamp
  }
}

' ============================================
' PACKAGE: INVENTARIS & KEUANGAN
' ============================================
package "Operational Modules" <<Rectangle>> #98FB98 {
  
  class KategoriAset {
    # id : bigint <<PK>>
    --
    + nama_kategori : string
    + deskripsi : text
    + created_at : timestamp
    + updated_at : timestamp
    --
    + getTotalItems() : int
  }

  class DetailInventaris {
    # id : bigint <<PK>>
    --
    + kepengurusan_lab_id : bigint <<FK>>
    + kategori_aset_id : bigint <<FK>>
    + nama_barang : string
    + kode_barang : string
    + jumlah : int
    + satuan : string
    + kondisi : enum {baik,rusak_ringan,rusak_berat}
    + lokasi : string
    + qr_code : string
    + created_at : timestamp
    + updated_at : timestamp
    --
    + generateQRCode() : string
    + isAvailableForLoan(qty : int) : bool
    + updateStok(change : int) : void
    + getStatusLabel() : string
  }

  class PermohonanAset {
    # id : bigint <<PK>>
    --
    + detail_inventaris_id : bigint <<FK>>
    + user_id : bigint <<FK>>
    + jumlah : int
    + keperluan : text
    + tanggal_pinjam : date
    + tanggal_kembali : date
    + status : enum {pending,approved,rejected}
    + approved_by : bigint <<FK>>
    + created_at : timestamp
    + updated_at : timestamp
    --
    + approve(approver_id : int) : void
    + reject(approver_id : int) : void
    + isPending() : bool
    + isOverdue() : bool
  }

  class RiwayatKeuangan {
    # id : bigint <<PK>>
    --
    + kepengurusan_lab_id : bigint <<FK>>
    + user_id : bigint <<FK>>
    + tipe : enum {pemasukan,pengeluaran}
    + jumlah : decimal(15,2)
    + keterangan : text
    + metode_pembayaran : enum {cash,transfer,qris}
    + bukti : string
    + tanggal_transaksi : datetime
    + created_at : timestamp
    + updated_at : timestamp
    --
    + isPemasukan() : bool
    + isPengeluaran() : bool
    + getBuktiUrl() : string
    + updateRekap() : void
  }

  class RekapKeuangan {
    # id : bigint <<PK>>
    --
    + kepengurusan_lab_id : bigint <<FK>>
    + bulan : int
    + tahun : int
    + total_pemasukan : decimal(15,2)
    + total_pengeluaran : decimal(15,2)
    + saldo : decimal(15,2)
    + created_at : timestamp
    + updated_at : timestamp
    --
    + calculateSaldo() : decimal
    + adjustPemasukan(amount : decimal) : void
    + adjustPengeluaran(amount : decimal) : void
    + regenerate() : void
  }
}

' ============================================
' PACKAGE: KEGIATAN, PROKER & PIKET
