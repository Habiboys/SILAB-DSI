  }

  class AbsensiAslab {
    # id : bigint <<PK>>
    --
    + jadwal_piket_id : bigint <<FK>>
    + user_id : bigint <<FK>>
    + tanggal : date
    + jam_masuk : time
    + jam_keluar : time
    + status : enum {hadir,izin,alpha}
    + created_at : timestamp
    + updated_at : timestamp
    --
    + checkIn() : void
    + checkOut() : void
    + calculateDuration() : int
    + isHadir() : bool
  }
}

' ============================================
