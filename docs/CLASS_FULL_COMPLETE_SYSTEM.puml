    + user_id : bigint <<FK>>
    + jenis : enum {peserta,panitia}
    + no_sertifikat : string
    + file_sertifikat : string
    + created_at : timestamp
    + updated_at : timestamp
    --
    + isPeserta() : bool
    + isPanitia() : bool
