    + created_at : timestamp
    + updated_at : timestamp
  }
}

' ============================================
' RELATIONSHIPS ANTAR PACKAGE
' ============================================

' Core Auth Relations
User "*" -- "*" Role
Role "*" -- "*" Permission
Laboratorium "1" -- "*" KepengurusanLab
TahunKepengurusan "1" -- "*" KepengurusanLab
KepengurusanLab "1" -- "*" Anggota
User "1" -- "*" Anggota
Struktur "1" -- "*" Anggota
Role "1" -- "*" Struktur

' Praktikum Relations
KepengurusanLab "1" -- "*" Praktikum
Praktikum "1" -- "*" AslabPraktikum
User "1" -- "*" AslabPraktikum
Praktikum "1" -- "*" Praktikan
User "1" -- "*" Praktikan
Praktikum "1" -- "*" ModulPraktikum
Praktikum "1" -- "*" PertemuanPraktikum
Praktikum "1" -- "*" TugasPraktikum
PertemuanPraktikum "1" -- "*" Absensi
Praktikan "1" -- "*" Absensi
TugasPraktikum "1" -- "*" PengumpulanTugas
Praktikan "1" -- "*" PengumpulanTugas
TugasPraktikum "1" -- "0..1" RubrikPenilaian
RubrikPenilaian "1" -- "*" KomponenRubrik
KomponenRubrik "1" -- "*" NilaiRubrik
Praktikan "1" -- "*" NilaiRubrik
PengumpulanTugas "1" -- "*" NilaiRubrik
User "1" -- "*" NilaiRubrik : dinilai_oleh
TugasPraktikum "1" -- "*" NilaiTambahan
Praktikan "1" -- "*" NilaiTambahan
User "1" -- "*" NilaiTambahan : diberikan_oleh

' Inventaris Relations
KepengurusanLab "1" -- "*" DetailInventaris
KategoriAset "1" -- "*" DetailInventaris
DetailInventaris "1" -- "*" PermohonanAset
User "1" -- "*" PermohonanAset : pemohon
User "1" -- "*" PermohonanAset : approver

' Keuangan Relations
KepengurusanLab "1" -- "*" RiwayatKeuangan
User "1" -- "*" RiwayatKeuangan
KepengurusanLab "1" -- "*" RekapKeuangan

' Kegiatan & Proker Relations
KepengurusanLab "1" -- "*" Proker
Struktur "1" -- "*" Proker
Proker "1" -- "*" Kegiatan
User "1" -- "*" Kegiatan : approver
Kegiatan "1" -- "*" KegiatanPeserta
User "1" -- "*" KegiatanPeserta
Kegiatan "1" -- "*" SertifikatTemplate

' Piket Relations
KepengurusanLab "1" -- "*" PeriodePiket
PeriodePiket "1" -- "*" JadwalPiket
User "1" -- "*" JadwalPiket
JadwalPiket "1" -- "*" GantiJadwalPiket
User "1" -- "*" GantiJadwalPiket : requester
User "1" -- "*" GantiJadwalPiket : approver
JadwalPiket "1" -- "*" AbsensiAslab
User "1" -- "*" AbsensiAslab

' Surat Relations
Laboratorium "1" -- "*" Surat : from_lab
Laboratorium "1" -- "*" Surat : to_lab
User "1" -- "*" Surat : sender

' Sertifikat Relations
User "1" -- "*" Sertifikat

' Survey Relations
Kuesioner "1" -- "*" PertanyaanKuesioner
Kuesioner "1" -- "*" TargetKuesioner
Kuesioner "1" -- "*" ResponKuesioner
User "1" -- "*" ResponKuesioner
ResponKuesioner "1" -- "*" JawabanKuesioner
PertanyaanKuesioner "1" -- "*" JawabanKuesioner
User "1" -- "*" Kuesioner : pembuat

@enduml
