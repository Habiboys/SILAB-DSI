    + getFullPath() : string
  }

  class PeriodePiket {
    # id : bigint <<PK>>
    --
    + kepengurusan_lab_id : bigint <<FK>>
    + nama_periode : string
    + tanggal_mulai : date
    + tanggal_selesai : date
    + is_active : bool
    + created_at : timestamp
    + updated_at : timestamp
