@startuml ACT_01_LOGIN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black

title ACT-01 - Login\nAktor: Publik

|Publik|
|System|

|Publik|
start
:Buka halaman /login;
:Isi email, password,
opsional remember me;
:Klik Login;

|System|
:Validasi input login;
if (Input valid?) then (tidak)
  :Kirim error validasi (422);
  |Publik|
  :Lihat error pada field;
  stop
else (ya)
  :Cek rate limit login;
  if (Melebihi batas percobaan?) then (ya)
    :Kirim pesan rate limit
+ waktu tunggu;
    |Publik|
    :Tunggu lalu coba lagi;
    stop
  else (tidak)
    :Cek kredensial ke data user;
    if (Kredensial benar?) then (tidak)
      :Tambah hit rate limiter;
      :Kirim pesan auth gagal;
      |Publik|
      :Perbaiki email/password;
      stop
    else (ya)
      :Hapus hit rate limiter;
      :Buat sesi login;
      :Regenerate session id;
      if (Role = praktikan?) then (ya)
        :Redirect ke praktikan.daftar-tugas;
      else (tidak)
        :Redirect ke dashboard;
      endif
      |Publik|
      :Masuk ke halaman tujuan;
      stop
    endif
  endif
endif
@enduml
