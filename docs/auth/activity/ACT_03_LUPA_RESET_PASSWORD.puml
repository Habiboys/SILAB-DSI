@startuml ACT_03_LUPA_RESET_PASSWORD
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black

title ACT-03 - Lupa & Reset Password\nAktor: Publik

|Publik|
|System|

|Publik|
start
:Buka halaman /forgot-password;
:Isi email dan kirim;

|System|
:Validasi email;
if (Email valid?) then (tidak)
  :Kirim error validasi;
  |Publik|
  :Perbaiki email;
  stop
else (ya)
  :Cek email pada data user;
  if (Email terdaftar?) then (tidak)
    :Kirim pesan email tidak ditemukan;
    |Publik|
    :Gunakan email lain;
    stop
  else (ya)
    :Buat token reset password;
    :Simpan token reset;
    :Kirim email berisi link reset;
    |Publik|
    :Buka link reset dari email;
    :Isi password baru + konfirmasi;
    :Submit reset password;

    |System|
    :Validasi token, email,
dan password baru;
    if (Data reset valid?) then (tidak)
      :Kirim pesan token/data tidak valid;
      |Publik|
      :Ulangi proses reset;
      stop
    else (ya)
      :Update password user;
      :Generate remember token baru;
      :Hapus token reset yang dipakai;
      :Redirect ke login + status sukses;
      |Publik|
      :Login dengan password baru;
      stop
    endif
  endif
endif
@enduml
