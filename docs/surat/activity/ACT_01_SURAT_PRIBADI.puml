@startuml ACT_01_SURAT_PRIBADI
!theme plain
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-01 � Kirim Surat Pribadi\nAktor: Admin / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka menu Surat Pribadi;
:Klik "Kirim Surat Baru";
:Isi form surat\n(penerima, perihal, isi surat,\nlampiran?);

|System|
:Periksa input\n(penerima valid, perihal tidak kosong);

if (Form valid?) then (tidak)
  :Tampilkan pesan kesalahan;
  |Admin / Asisten|
  :Perbaiki form;
  :Kirim ulang;
  |System|
  :Periksa ulang;
else (ya)
  :Simpan lampiran;
  :Simpan data baru;
  :Kirim notifikasi ke penerima;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Surat berhasil terkirim;\nMuncul di kotak keluar;
endif

stop
@enduml
