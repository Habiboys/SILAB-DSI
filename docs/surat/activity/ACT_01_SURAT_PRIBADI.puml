@startuml ACT_01_SURAT_PRIBADI
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-01 - Kirim Surat Pribadi / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka menu Surat Pribadi;
:Klik "Kirim Surat Baru";

repeat
  :Isi form surat;
  |System|
  :Periksa input;
  if (Form valid?) then (tidak)
    :Tampilkan pesan kesalahan;
    |Admin / Asisten|
    :Perbaiki form;
  endif
repeat while (Form valid?) is (tidak) not (ya)
:Simpan lampiran;
:Simpan data baru;
:Kirim notifikasi ke penerima;
:Tampilkan notifikasi sukses;
|Admin / Asisten|
:Surat berhasil terkirim;
:Muncul di kotak keluar;

stop
@enduml
