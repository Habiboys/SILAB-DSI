@startuml ACT_05_SURAT_RESMI
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-05 - Kirim Surat Resmi Lab\nAktor: Admin / Sekretaris

|Admin / Sekretaris|
|System|

|Admin / Sekretaris|
start
:Buka menu Surat Resmi;
:Klik "Buat Surat Resmi";
:Isi form surat resmi\n(nomor surat, perihal, tujuan,\nisi surat, lampiran?,\ntanggal surat);

|System|
:Cek permission\nsurat.create_resmi;
if (Permission?) then (ditolak)
  :Tampilkan halaman akses ditolak;
  |Admin / Sekretaris|
  :Lihat pesan akses ditolak;
  stop
else (diizinkan)
  |Admin / Sekretaris|
  repeat
    :Periksa & lengkapi form\n(nomor surat unik, perihal tidak kosong);
    |System|
    :Validasi input;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin / Sekretaris|
      :Perbaiki form;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Simpan lampiran;
  :Simpan data baru;
  :Tampilkan notifikasi sukses;
  |Admin / Sekretaris|
  :Surat resmi tersimpan\ndi arsip lab;
  stop
endif
@enduml
