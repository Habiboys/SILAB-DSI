@startuml ACT_05_SURAT_RESMI
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-05 - Kirim Surat Resmi Lab / Sekretaris

|Admin / Sekretaris|
|System|

|Admin / Sekretaris|
start
:Buka menu Surat Resmi;
:Klik "Buat Surat Resmi";
:Isi form surat resmi;

|System|
:Cek permission\nsurat.create_resmi;
if (Permission?) then (ditolak)
  :Tampilkan halaman akses ditolak;
  |Admin / Sekretaris|
  :Lihat pesan akses ditolak;
  stop
else (diizinkan)
  |Admin / Sekretaris|
  repeat
    :Periksa & lengkapi form\n(nomor surat unik, perihal tidak kosong);
    |System|
    :Validasi input;
    |Admin / Sekretaris|
  repeat while (Form valid?) is (tidak) not (ya)

  |System|
  :Simpan lampiran;
  :Simpan data baru;
  :Tampilkan notifikasi sukses;

  |Admin / Sekretaris|
  :Surat resmi tersimpan\ndi arsip lab;
  stop
endif
@enduml
