@startuml ACT_05_MENGELOLA_PERMISSION_STRUKTUR
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-05 - Mengelola Permission Struktur

|SuperAdmin|
|System|

|SuperAdmin|
start
:Buka menu Permission Struktur;
|System|
:Query & Tampilkan daftar struktur jabatan\nbeserta akses menu;
|SuperAdmin|
:Lihat daftar permission struktur;

if (Aksi?) then (Set Akses)
  :Pilih struktur jabatan dan akses\nyang akan diberikan;
  |System|
  :Tampilkan konfirmasi set akses;
  |SuperAdmin|
  :Konfirmasi pemberian akses;

elseif (Aksi?) then (Cabut Akses)
  :Pilih akses yang akan dicabut\ndari struktur jabatan;
  |System|
  :Tampilkan konfirmasi cabut akses;
  |SuperAdmin|
  :Konfirmasi pencabutan akses;

else (Cari/Filter)
  :Masukkan kata kunci/filter struktur;
  |System|
  :Tampilkan hasil pencarian;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |SuperAdmin|
  :Perbaiki pilihan akses;
  |System|
else (ya)
  :Simpan perubahan permission struktur;
  :Tampilkan Pesan Sukses;
endif

stop
@enduml