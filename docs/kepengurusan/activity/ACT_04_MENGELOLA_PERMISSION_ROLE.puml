@startuml ACT_04_MENGELOLA_PERMISSION_ROLE
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-04 - Mengelola Permission Role

|SuperAdmin|
|System|

|SuperAdmin|
start
:Buka menu Permission Role;
|System|
:Query & Tampilkan daftar role\nbeserta permission;
|SuperAdmin|
:Lihat daftar permission role;

if (Aksi?) then (Assign Permission)
  :Pilih role dan permission\nyang akan diberikan;
  |System|
  :Tampilkan konfirmasi assign;
  |SuperAdmin|
  :Konfirmasi pemberian permission;

elseif (Aksi?) then (Revoke Permission)
  :Pilih permission yang akan dicabut\ndari role;
  |System|
  :Tampilkan konfirmasi revoke;
  |SuperAdmin|
  :Konfirmasi pencabutan permission;

else (Cari/Filter)
  :Masukkan kata kunci/filter role;
  |System|
  :Tampilkan hasil pencarian;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |SuperAdmin|
  :Perbaiki pilihan permission;
  |System|
else (ya)
  :Simpan perubahan permission role;
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
