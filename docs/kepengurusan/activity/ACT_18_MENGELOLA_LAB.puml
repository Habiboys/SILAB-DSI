@startuml ACT_18_MENGELOLA_LAB
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-18 - Mengelola Lab

|SuperAdmin|
|System|

|SuperAdmin|
start
:Buka menu Kelola Lab;
|System|
:Query & Tampilkan daftar lab;
|SuperAdmin|
:Lihat daftar lab;

if (Aksi?) then (Tambah Lab)
  :Isi form data lab\n(nama lab, kode lab, keterangan);
  |System|
  :Tampilkan konfirmasi simpan;
  |SuperAdmin|
  :Konfirmasi simpan lab baru;

elseif (Aksi?) then (Edit Lab)
  :Pilih lab\nyang akan diedit;
  |System|
  :Tampilkan form edit dengan\ndata lama;
  |SuperAdmin|
  :Ubah data lab;
  |System|
  :Tampilkan konfirmasi update;
  |SuperAdmin|
  :Konfirmasi perubahan data;

elseif (Aksi?) then (Set Aktif)
  :Pilih lab\nyang akan diaktifkan/dinonaktifkan;
  |System|
  :Tampilkan konfirmasi\nset status aktif;
  |SuperAdmin|
  :Konfirmasi perubahan\nstatus lab;

else (Hapus Lab)
  :Pilih lab\nyang akan dihapus;
  |System|
  :Tampilkan konfirmasi hapus;
  |SuperAdmin|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |SuperAdmin|
  :Perbaiki data lab;
  |System|
else (ya)
  :Simpan perubahan data lab;
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
