@startuml UC_KUESIONER
!theme plain
skinparam defaultFontSize 12
title Use Case Diagram — Modul Kuesioner
left to right direction

actor "Admin"    as Admin
actor "Asisten"  as Asisten
actor "Dosen"    as Dosen
actor "Kadep"    as Kadep
actor "Praktikan" as Praktikan

' Generalisasi: Kadep mewarisi akses Dosen
' (melihat hasil kuesioner)
Dosen <|-- Kadep

rectangle "Modul Kuesioner" {
  usecase "UC01\nMengelola Kuesioner" as UC01
  usecase "UC02\nMengisi Kuesioner" as UC02
  usecase "UC03\nMelihat Hasil Kuesioner" as UC03
}

Admin    --> UC01
Admin    --> UC03
Asisten  --> UC02
Praktikan --> UC02

' Dosen – lihat hasil kuesioner (view-only)
Dosen    --> UC03

' Kadep – mewarisi akses Dosen (UC03) via generalisasi

@enduml
