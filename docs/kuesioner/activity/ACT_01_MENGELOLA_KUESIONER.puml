@startuml ACT_01_MENGELOLA_KUESIONER
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-01 - Mengelola Kuesioner

|SuperAdmin / Admin|
|System|

|SuperAdmin / Admin|
start
:Buka menu Kuesioner;
|System|
:Query & Tampilkan daftar kuesioner;
|SuperAdmin / Admin|
:Lihat daftar kuesioner;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Tambah Kuesioner;
  |SuperAdmin / Admin|
  :Isi form kuesioner;

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih kuesioner yang diubah;
  |System|
  :Tampilkan Form Edit Kuesioner;
  |SuperAdmin / Admin|
  :Ubah judul / deskripsi / pertanyaan;

elseif (Aksi?) then (Publish/Tutup)
  :Toggle status kuesioner\n(draft ke aktif ke ditutup);
  |System|
  :Perbarui data;

else (Hapus)
  :Klik Hapus, konfirmasi;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |SuperAdmin / Admin|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |SuperAdmin / Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
