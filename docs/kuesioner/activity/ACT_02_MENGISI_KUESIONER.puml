@startuml ACT_02_MENGISI_KUESIONER
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200

skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-02 � Mengisi Kuesioner\nAktor: Asisten / Praktikan

|Asisten / Praktikan|
|System|

|Asisten / Praktikan|
start
:Buka menu Kuesioner\natau terima notifikasi kuesioner;

|System|
:Cek autentikasi & role;
:Ambil data kuesioner aktif;

if (Ada kuesioner aktif?) then (tidak)
  :Tampilkan pesan\n"Tidak ada kuesioner tersedia";
  |Asisten / Praktikan|
  :Lihat pesan kosong;
  stop
else (ya)
  :Tampilkan daftar kuesioner\nyang bisa diisi;
  |Asisten / Praktikan|
  :Pilih kuesioner ? klik Isi;
  |System|
  :Cek apakah sudah pernah\nmengisi kuesioner ini;
  if (Sudah mengisi?) then (ya)
    :Tampilkan pesan\n"Kuesioner sudah diisi";
    |Asisten / Praktikan|
    :Lihat pesan sudah diisi;
    stop
  else (belum)
    :Tampilkan form kuesioner\n(semua pertanyaan);
    |Asisten / Praktikan|
    :Jawab semua pertanyaan\n(pilihan / teks);
    :Klik Submit;
    |System|
    :Periksa semua pertanyaan\nwajib terisi;
    if (Form valid?) then (tidak)
      :Highlight pertanyaan\nyang belum dijawab;
      |Asisten / Praktikan|
      :Lengkapi jawaban;
    else (ya)
      :Simpan data baru;
      :Perbarui data;
      :Tampilkan notifikasi sukses;
      |Asisten / Praktikan|
      :Kuesioner berhasil dikirim;
    endif
  endif
endif

stop
@enduml
