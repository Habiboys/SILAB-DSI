@startuml SILAB_ERD_Comprehensive
!theme plain
skinparam linetype ortho

' ============================================
' ENTITAS UTAMA - USER & AUTHENTICATION
' ============================================
entity "👤 users" as users {
  * id : bigint <<PK>>
  --
  * name : varchar(255)
  * username : varchar(255) <<unique>>
  * email : varchar(255) <<unique>>
  * password : varchar(255)
  * nim : varchar(20) <<nullable>>
  phone : varchar(20)
  address : text
  avatar : varchar(255)
  email_verified_at : timestamp
  remember_token : varchar(100)
  created_at : timestamp
  updated_at : timestamp
}

entity "🔐 roles" as roles {
  * id : bigint <<PK>>
  --
  * name : varchar(255) <<unique>>
  guard_name : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "🔑 permissions" as permissions {
  * id : bigint <<PK>>
  --
  * name : varchar(255) <<unique>>
  guard_name : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "model_has_roles" as model_has_roles {
  * role_id : bigint <<PK,FK>>
  * model_type : varchar(255) <<PK>>
  * model_id : bigint <<PK>>
}

entity "model_has_permissions" as model_has_permissions {
  * permission_id : bigint <<PK,FK>>
  * model_type : varchar(255) <<PK>>
  * model_id : bigint <<PK>>
}

entity "role_has_permissions" as role_has_permissions {
  * permission_id : bigint <<PK,FK>>
  * role_id : bigint <<PK,FK>>
}

' ============================================
' ENTITAS LABORATORIUM & KEPENGURUSAN
' ============================================
entity "🔬 laboratorium" as laboratorium {
  * id : bigint <<PK>>
  --
  * nama_lab : varchar(255)
  deskripsi : text
  ruangan : varchar(100)
  created_at : timestamp
  updated_at : timestamp
}

entity "📅 tahun_kepengurusan" as tahun_kepengurusan {
  * id : bigint <<PK>>
  --
  * tahun : varchar(20)
  * tahun_mulai : int
  * tahun_selesai : int
  is_active : boolean
  created_at : timestamp
  updated_at : timestamp
}

entity "👥 kepengurusan_lab" as kepengurusan_lab {
  * id : bigint <<PK>>
  --
  * laboratorium_id : bigint <<FK>>
  * tahun_kepengurusan_id : bigint <<FK>>
  is_active : boolean
  created_at : timestamp
  updated_at : timestamp
}

entity "📋 struktur" as struktur {
  * id : bigint <<PK>>
  --
  * struktur : varchar(255) <<unique>>
  jabatan_tunggal : boolean
  default_role_id : bigint <<FK>>
  created_at : timestamp
  updated_at : timestamp
}

entity "👔 anggota" as anggota {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * kepengurusan_lab_id : bigint <<FK>>
  * struktur_id : bigint <<FK>>
  created_at : timestamp
  updated_at : timestamp
}

entity "🔓 struktur_permissions" as struktur_permissions {
  * id : bigint <<PK>>
  --
  * jabatan : varchar(255)
  * permission : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' ENTITAS PRAKTIKUM & AKADEMIK
' ============================================
entity "🔬 praktikum" as praktikum {
  * id : bigint <<PK>>
  --
  * kepengurusan_lab_id : bigint <<FK>>
  * nama_praktikum : varchar(255)
  kode_praktikum : varchar(50)
  semester : varchar(20)
  sks : int
  deskripsi : text
  created_at : timestamp
  updated_at : timestamp
}

entity "📚 aslab_praktikum" as aslab_praktikum {
  * id : bigint <<PK>>
  --
  * praktikum_id : bigint <<FK>>
  * user_id : bigint <<FK>>
  created_at : timestamp
  updated_at : timestamp
}

entity "🎓 praktikan" as praktikan {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * praktikum_id : bigint <<FK>>
  kelas : varchar(50)
  tahun_ajaran : varchar(20)
  created_at : timestamp
  updated_at : timestamp
}

entity "📖 modul_praktikum" as modul_praktikum {
  * id : bigint <<PK>>
  --
  * praktikum_id : bigint <<FK>>
  * judul : varchar(255)
  deskripsi : text
  file_path : varchar(255)
  urutan : int
  created_at : timestamp
  updated_at : timestamp
}

entity "📝 pertemuan_praktikum" as pertemuan_praktikum {
  * id : bigint <<PK>>
  --
  * praktikum_id : bigint <<FK>>
  * pertemuan_ke : int
  * judul : varchar(255)
  tanggal : date
  created_at : timestamp
  updated_at : timestamp
}

entity "✅ absensi" as absensi {
  * id : bigint <<PK>>
  --
  * praktikan_id : bigint <<FK>>
  * pertemuan_praktikum_id : bigint <<FK>>
  * status : enum(hadir,izin,sakit,alpha)
  keterangan : text
  created_at : timestamp
  updated_at : timestamp
}

entity "📋 tugas_praktikum" as tugas_praktikum {
  * id : bigint <<PK>>
  --
  * praktikum_id : bigint <<FK>>
  * judul : varchar(255)
  deskripsi : text
  deadline : datetime
  created_at : timestamp
  updated_at : timestamp
}

entity "📤 pengumpulan_tugas" as pengumpulan_tugas {
  * id : bigint <<PK>>
  --
  * tugas_praktikum_id : bigint <<FK>>
  * praktikan_id : bigint <<FK>>
  file_path : varchar(255)
  keterangan : text
  nilai : decimal(5,2)
  status : enum(pending,dinilai)
  dinilai_at : timestamp
  submitted_at : timestamp
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' ENTITAS PENILAIAN & RUBRIK
' ============================================
entity "📊 rubrik_penilaian" as rubrik_penilaian {
  * id : bigint <<PK>>
  --
  * tugas_praktikum_id : bigint <<FK>>
  * nama_rubrik : varchar(255)
  deskripsi : text
  bobot_total : decimal(5,2)
  is_active : boolean
  created_at : timestamp
  updated_at : timestamp
}

entity "📌 komponen_rubrik" as komponen_rubrik {
  * id : bigint <<PK>>
  --
  * rubrik_penilaian_id : bigint <<FK>>
  * nama_komponen : varchar(255)
  deskripsi : text
  bobot : decimal(5,2)
  nilai_maksimal : decimal(5,2)
  urutan : int
  created_at : timestamp
  updated_at : timestamp
}

entity "✍️ nilai_rubrik" as nilai_rubrik {
  * id : bigint <<PK>>
  --
  * komponen_rubrik_id : bigint <<FK>>
  * praktikan_id : bigint <<FK>>
  * pengumpulan_tugas_id : bigint <<FK>>
  nilai : decimal(5,2)
  catatan : text
  dinilai_oleh : bigint <<FK>>
  dinilai_at : timestamp
  created_at : timestamp
  updated_at : timestamp
}

entity "➕ nilai_tambahan" as nilai_tambahan {
  * id : bigint <<PK>>
  --
  * tugas_praktikum_id : bigint <<FK>>
  * praktikan_id : bigint <<FK>>
  nilai : decimal(5,2)
  kategori : varchar(50)
  keterangan : text
  diberikan_oleh : bigint <<FK>>
  diberikan_at : timestamp
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' ENTITAS SERTIFIKAT
' ============================================
entity "🎓 sertifikat" as sertifikat {
  * id : bigint <<PK>>
  --
  * user_id : bigint <<FK>>
  * jenis_sertifikat : enum(praktikum,kepengurusan)
  nomor_sertifikat : varchar(100)
  nama_kegiatan : varchar(255)
  tanggal_terbit : date
  file_path : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' ENTITAS INVENTARIS
' ============================================
entity "📦 kategori_aset" as kategori_aset {
  * id : bigint <<PK>>
  --
  * nama_kategori : varchar(255)
  deskripsi : text
  created_at : timestamp
  updated_at : timestamp
}

entity "🔧 detail_inventaris" as detail_inventaris {
  * id : bigint <<PK>>
  --
  * kepengurusan_lab_id : bigint <<FK>>
  * kategori_aset_id : bigint <<FK>>
  nama_barang : varchar(255)
  kode_barang : varchar(100)
  jumlah : int
  satuan : varchar(50)
  kondisi : enum(baik,rusak_ringan,rusak_berat)
  lokasi : varchar(255)
  qr_code : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "📝 permohonan_aset" as permohonan_aset {
  * id : bigint <<PK>>
  --
  * detail_inventaris_id : bigint <<FK>>
  * user_id : bigint <<FK>>
  jumlah : int
  keperluan : text
  tanggal_pinjam : date
  tanggal_kembali : date
  status : enum(pending,approved,rejected)
  approved_by : bigint <<FK>>
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' ENTITAS KEUANGAN
' ============================================
entity "💰 riwayat_keuangan" as riwayat_keuangan {
  * id : bigint <<PK>>
  --
  * kepengurusan_lab_id : bigint <<FK>>
  * user_id : bigint <<FK>>
  tipe : enum(pemasukan,pengeluaran)
  jumlah : decimal(15,2)
  keterangan : text
  metode_pembayaran : enum(cash,transfer,qris)
  bukti : varchar(255)
  tanggal_transaksi : datetime
  created_at : timestamp
  updated_at : timestamp
}

entity "📊 rekap_keuangan" as rekap_keuangan {
  * id : bigint <<PK>>
  --
  * kepengurusan_lab_id : bigint <<FK>>
  bulan : int
  tahun : int
  total_pemasukan : decimal(15,2)
  total_pengeluaran : decimal(15,2)
  saldo : decimal(15,2)
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' ENTITAS PIKET
' ============================================
entity "📅 periode_piket" as periode_piket {
  * id : bigint <<PK>>
  --
  * kepengurusan_lab_id : bigint <<FK>>
  * nama_periode : varchar(255)
  tanggal_mulai : date
  tanggal_selesai : date
  is_active : boolean
  created_at : timestamp
  updated_at : timestamp
}

entity "🕐 jadwal_piket" as jadwal_piket {
  * id : bigint <<PK>>
  --
  * periode_piket_id : bigint <<FK>>
  * user_id : bigint <<FK>>
  hari : enum(senin,selasa,rabu,kamis,jumat)
  jam_mulai : time
  jam_selesai : time
  created_at : timestamp
  updated_at : timestamp
}

entity "🔄 ganti_jadwal_piket" as ganti_jadwal_piket {
  * id : bigint <<PK>>
  --
  * jadwal_piket_id : bigint <<FK>>
  * requested_by : bigint <<FK>>
  * approved_by : bigint <<FK>>
  alasan : text
  status : enum(pending,approved,rejected)
  created_at : timestamp
  updated_at : timestamp
}

entity "✅ absensi_aslab" as absensi_aslab {
  * id : bigint <<PK>>
  --
  * jadwal_piket_id : bigint <<FK>>
  * user_id : bigint <<FK>>
  tanggal : date
  jam_masuk : time
  jam_keluar : time
  status : enum(hadir,izin,alpha)
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' ENTITAS PROGRAM KERJA & KEGIATAN
' ============================================
entity "📋 proker" as proker {
  * id : bigint <<PK>>
  --
  * kepengurusan_lab_id : bigint <<FK>>
  * struktur_id : bigint <<FK>>
  nama_proker : varchar(255)
  deskripsi : text
  file_path : varchar(255)
  status : enum(belum_mulai,berjalan,selesai)
  created_at : timestamp
  updated_at : timestamp
}

entity "🎯 kegiatan" as kegiatan {
  * id : bigint <<PK>>
  --
  * proker_id : bigint <<FK>>
  * nama_kegiatan : varchar(255)
  deskripsi : text
  tanggal_mulai : date
  tanggal_selesai : date
  tempat : varchar(255)
  status : enum(diajukan,disetujui,ditolak,selesai)
  approved_by : bigint <<FK>>
  file_lpj : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "👥 kegiatan_peserta" as kegiatan_peserta {
  * id : bigint <<PK>>
  --
  * kegiatan_id : bigint <<FK>>
  * user_id : bigint <<FK>>
  jenis : enum(peserta,panitia)
  no_sertifikat : varchar(100)
  file_sertifikat : varchar(255)
  created_at : timestamp
  updated_at : timestamp
}

entity "📜 sertifikat_template" as sertifikat_template {
  * id : bigint <<PK>>
  --
  * kegiatan_id : bigint <<FK>>
  * nama_template : varchar(255)
  file_path : varchar(255)
  jenis : enum(peserta,panitia)
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' ENTITAS SURAT
' ============================================
entity "✉️ surat" as surat {
  * id : bigint <<PK>>
  --
  * from_lab_id : bigint <<FK>>
  * to_lab_id : bigint <<FK>>
  * sender_id : bigint <<FK>>
  nomor_surat : varchar(100)
  perihal : varchar(255)
  isi_surat : text
  lampiran : varchar(255)
  tanggal_kirim : datetime
  is_read : boolean
  created_at : timestamp
  updated_at : timestamp
}

' ============================================
' RELASI MANY-TO-MANY & JUNCTION TABLES
' ============================================
users ||--o{ model_has_roles
roles ||--o{ model_has_roles
users ||--o{ model_has_permissions
permissions ||--o{ model_has_permissions
roles ||--o{ role_has_permissions
permissions ||--o{ role_has_permissions

' ============================================
' RELASI KEPENGURUSAN & LAB
' ============================================
laboratorium ||--o{ kepengurusan_lab
tahun_kepengurusan ||--o{ kepengurusan_lab
kepengurusan_lab ||--o{ anggota
users ||--o{ anggota
struktur ||--o{ anggota
roles ||--o{ struktur

' ============================================
' RELASI PRAKTIKUM
' ============================================
kepengurusan_lab ||--o{ praktikum
praktikum ||--o{ aslab_praktikum
users ||--o{ aslab_praktikum
praktikum ||--o{ praktikan
users ||--o{ praktikan
praktikum ||--o{ modul_praktikum
praktikum ||--o{ pertemuan_praktikum
praktikum ||--o{ tugas_praktikum

pertemuan_praktikum ||--o{ absensi
praktikan ||--o{ absensi

tugas_praktikum ||--o{ pengumpulan_tugas
praktikan ||--o{ pengumpulan_tugas

' ============================================
' RELASI RUBRIK & PENILAIAN
' ============================================
tugas_praktikum ||--o{ rubrik_penilaian
rubrik_penilaian ||--o{ komponen_rubrik
komponen_rubrik ||--o{ nilai_rubrik
praktikan ||--o{ nilai_rubrik
pengumpulan_tugas ||--o{ nilai_rubrik
users ||--o{ nilai_rubrik

tugas_praktikum ||--o{ nilai_tambahan
praktikan ||--o{ nilai_tambahan
users ||--o{ nilai_tambahan

' ============================================
' RELASI SERTIFIKAT
' ============================================
users ||--o{ sertifikat

' ============================================
' RELASI INVENTARIS
' ============================================
kepengurusan_lab ||--o{ detail_inventaris
kategori_aset ||--o{ detail_inventaris
detail_inventaris ||--o{ permohonan_aset
users ||--o{ permohonan_aset

' ============================================
' RELASI KEUANGAN
' ============================================
kepengurusan_lab ||--o{ riwayat_keuangan
users ||--o{ riwayat_keuangan
kepengurusan_lab ||--o{ rekap_keuangan

' ============================================
' RELASI PIKET
' ============================================
kepengurusan_lab ||--o{ periode_piket
periode_piket ||--o{ jadwal_piket
users ||--o{ jadwal_piket
jadwal_piket ||--o{ ganti_jadwal_piket
jadwal_piket ||--o{ absensi_aslab
users ||--o{ absensi_aslab

' ============================================
' RELASI PROKER & KEGIATAN
' ============================================
kepengurusan_lab ||--o{ proker
struktur ||--o{ proker
proker ||--o{ kegiatan
kegiatan ||--o{ kegiatan_peserta
users ||--o{ kegiatan_peserta
kegiatan ||--o{ sertifikat_template

' ============================================
' RELASI SURAT
' ============================================
laboratorium ||--o{ surat
users ||--o{ surat

@enduml
