@startuml UC_08_SERTIFIKAT
left to right direction
skinparam packageStyle rectangle
title Use Case Diagram - Modul Sertifikat

:Admin: as AD
:Praktikan: as PR
:Asisten: as AS
:Superadmin: as SA

rectangle "Modul Sertifikat" {
  usecase "Lihat Sertifikat Saya" as UC1
  usecase "Download Sertifikat" as UC2
  usecase "Generate Sertifikat\nPraktikum" as UC3
  usecase "Generate Sertifikat\nKegiatan" as UC4
  usecase "Upload Template" as UC5
}

AD --> UC3
AD --> UC4
AD --> UC5

SA --> UC3
SA --> UC4

PR --> UC1
PR --> UC2

AS --> UC1
AS --> UC2

UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>

@enduml
