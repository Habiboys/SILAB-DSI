SA --> K07
SA --> K08
SA --> K09
SA --> K10
SA --> K11
SA --> K12
SA --> K13
SA --> K14
SA --> K15
SA --> K16

' Kadep — approve proker & kegiatan, lihat semua
KD --> P01
KD --> P02
KD --> P08
KD --> P09
KD --> K01
KD --> K02
KD --> K06
KD --> K07
KD --> K16

' Admin Lab — kelola proker & kegiatan di lab-nya
AD --> P01
AD --> P02
AD --> P03
AD --> P04
AD --> P05
AD --> P06
AD --> P07
AD --> P10
AD --> P11
AD --> P14
AD --> P15
AD --> P16
AD --> P17
AD --> P18
AD --> K01
AD --> K02
AD --> K03
AD --> K04
AD --> K05
AD --> K06
AD --> K07
AD --> K08
AD --> K09
AD --> K10
AD --> K11
AD --> K12
AD --> K13
AD --> K14
AD --> K15
AD --> K16

' Koordinator (Struktur Induk / parent_id IS NULL) — buat & kelola proker divisinya
KOR --> P01
KOR --> P02
KOR --> P03
KOR --> P04
KOR --> P05
KOR --> P06
KOR --> P07
KOR --> P10
KOR --> P11
KOR --> P14
KOR --> P15
