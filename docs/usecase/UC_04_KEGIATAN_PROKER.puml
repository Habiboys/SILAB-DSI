@startuml UC_04_KEGIATAN_PROKER
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #f8f9fa
  BorderColor #6c757d
}
title Use Case Diagram - Modul Kegiatan & Program Kerja (v2 - Updated Feb 2026)

' ── Actors ──────────────────────────────────────────────────────────────
:Superadmin: as SA
:Kadep: as KD
:Admin Lab: as AD
:Koordinator\n(Struktur Induk): as KOR
:Asisten / PJ: as AS
:Dosen: as DS

' ============================================================
' PROGRAM KERJA
' ============================================================
rectangle "Sub-Modul: Program Kerja (Proker)" {

  ' --- CRUD Dasar ---
  usecase "Lihat Daftar Proker" as P01
  usecase "Lihat Detail Proker" as P02
  usecase "Buat Program Kerja" as P03
  usecase "Edit Program Kerja" as P04
  usecase "Hapus Program Kerja" as P05
  usecase "Upload File Proker\n(Dokumen Rancangan)" as P06

  ' --- Alur Pengajuan ---
  usecase "Ajukan Proker\n(draft → diajukan)" as P07
  usecase "Approve Proker" as P08
  usecase "Tolak Proker\n(+ catatan penolakan)" as P09

  ' --- Parameter & LPJ ---
  usecase "Tambah Parameter\nProker (bobot %)" as P10
  usecase "Edit / Hapus Parameter" as P11
  usecase "Update Capaian\nParameter (LPJ)" as P12
  usecase "Isi Evaluasi Proker\n(kendala / solusi / saran)" as P13

  ' --- Penanggung Jawab ---
  usecase "Tambah PJ Proker" as P14
  usecase "Hapus PJ Proker" as P15

  ' --- Dokumentasi Proker ---
  usecase "Upload Dokumentasi\nProker" as P16
  usecase "Download / Hapus\nDokumentasi Proker" as P17

  ' --- Update Status Pelaksanaan ---
  usecase "Update Status Pelaksanaan\n(belum_mulai/sedang_berjalan/\nselesai/ditunda)" as P18
}

' ============================================================
' KEGIATAN
' ============================================================
rectangle "Sub-Modul: Kegiatan" {

  ' --- CRUD Dasar ---
  usecase "Lihat Daftar Kegiatan" as K01
  usecase "Lihat Detail Kegiatan" as K02
  usecase "Buat Kegiatan Baru" as K03
  usecase "Edit Kegiatan" as K04
  usecase "Hapus Kegiatan" as K05

  ' --- Approval ---
  usecase "Approve Kegiatan" as K06
  usecase "Tolak Kegiatan" as K07

  ' --- Peserta ---
  usecase "Tambah Peserta / Panitia" as K08
  usecase "Hapus Peserta" as K09

  ' --- Laporan ---
  usecase "Upload Laporan Kegiatan\n(LPJ / Bulanan / Akhir)" as K10
  usecase "Download / Hapus LPJ" as K11

  ' --- Dokumentasi ---
  usecase "Upload Dokumentasi\nKegiatan (foto/video/berkas)" as K12
  usecase "Download / Hapus\nDokumentasi Kegiatan" as K13

  ' --- Sertifikat ---
  usecase "Upload Template\nSertifikat Kegiatan" as K14
  usecase "Generate Sertifikat\nKegiatan (per peserta)" as K15

  ' --- Kalender ---
  usecase "Lihat Kalender Kegiatan" as K16
}

' ============================================================
' AKTOR → USE CASE
' ============================================================

