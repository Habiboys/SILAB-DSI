  usecase "Edit Kuesioner" as UC2
  usecase "Hapus Kuesioner" as UC3
  usecase "Isi Kuesioner" as UC4
  usecase "Lihat Hasil" as UC5
  usecase "Export Hasil" as UC6
}

AD --> UC1
AD --> UC2
AD --> UC3
AD --> UC4
AD --> UC5
AD --> UC6

SA --> UC1
SA --> UC2
SA --> UC3
SA --> UC4
SA --> UC5
SA --> UC6

KD --> UC4
KD --> UC5
KD --> UC6

AS --> UC4
PR --> UC4
DS --> UC4

UC5 ..> UC6 : <<extend>>

@enduml
