@startuml UC_01_INVENTARIS
left to right direction
skinparam packageStyle rectangle
title Use Case Diagram - Modul Inventaris

:Admin: as AD
:Asisten: as AS
:Kadep: as KD

rectangle "Modul Inventaris" {
  usecase "Melihat Daftar Aset" as UC1
  usecase "Menambahkan Aset Baru" as UC2
  usecase "Mengedit Data Aset" as UC3
  usecase "Menghapus Aset" as UC4
  usecase "Menambahkan Kategori Aset" as UC5
  usecase "Mengedit Kategori Aset" as UC5b
  usecase "Menghapus Kategori Aset" as UC5c
  usecase "Mengajukan Permohonan\nPengadaan Aset" as UC6
  usecase "Menyetujui Permohonan\nPengadaan" as UC7
  usecase "Menolak Permohonan\nPengadaan" as UC7b
  usecase "Melihat Daftar\nPermohonan" as UC8
}

AD --> UC1
AD --> UC2
AD --> UC3
AD --> UC4
AD --> UC5
AD --> UC5b
AD --> UC5c
AD --> UC7
AD --> UC7b
AD --> UC8

AS --> UC1
AS --> UC6
AS --> UC8

KD --> UC1

@enduml
