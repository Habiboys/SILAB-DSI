@startuml UC_PRAKTIKUM
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontSize 12
skinparam TitleFontSize 14

skinparam usecase {
    BackgroundColor LightCyan
    BorderColor SteelBlue
    ArrowColor DarkSlateGray
    ActorBorderColor DarkBlue
    ActorFontColor DarkBlue
    ActorBackgroundColor AliceBlue
}

title Use Case Diagram - Modul Praktikum\nSiLab

' ── Actors ──────────────────────────────────────────────────────
actor "SuperAdmin"  as SuperAdmin
actor "Admin"       as Admin
actor "Asisten"     as Asisten
actor "Dosen"       as Dosen
actor "Kadep"       as Kadep
actor "Praktikan"   as Praktikan

' Generalisasi: SuperAdmin mewarisi semua akses Admin
Admin   <|-- SuperAdmin

' Generalisasi: Kadep mewarisi akses Dosen
Dosen <|-- Kadep

' ── Use Cases ───────────────────────────────────────────────────
rectangle "Modul Praktikum" {

    package "Manajemen Praktikum" as PMgmt {
        usecase "Mengelola Praktikum"          as UC01
        usecase "Melihat Daftar Praktikum"     as UC02
    }

    package "Konten Praktikum" as PConten {
        usecase "Mengelola Pertemuan"           as UC03
        usecase "Mengelola Modul Praktikum"     as UC04
        usecase "Mengakses Modul Praktikum"     as UC05
    }

    package "Manajemen Peserta" as PPeserta {
        usecase "Mengelola Praktikan"           as UC06
        usecase "Mengelola Aslab"               as UC07
    }

    package "Tugas & Penilaian" as PTugas {
        usecase "Mengelola Tugas Praktikum"     as UC08
        usecase "Mengelola Komponen Rubrik"     as UC09
        usecase "Mengelola Penilaian Tugas"     as UC10
        usecase "Mengumpulkan Tugas"            as UC11
    }

    package "Kehadiran" as PKhadiran {
        usecase "Mengelola Absensi Praktikum"   as UC12
    }

    package "Sertifikasi" as PSertif {
        usecase "Mengelola Sertifikat\nPraktikum" as UC13
    }

    package "Aktivitas Mandiri Praktikan" as PPraktikan {
        usecase "Melihat Riwayat\nPengumpulan Tugas"     as UC14
        usecase "Melihat Sertifikat\nSendiri"            as UC15
        usecase "Melihat Tugas\nPraktikum Saya"          as UC16
    }

    package "Supervisi & View-Only" as PSupervisi {
        usecase "Melihat Data Praktikan"               as UC17
        usecase "Melihat Rubrik Penilaian"             as UC18
        usecase "Melihat Sertifikat Praktikum"         as UC19
        usecase "Melihat Presensi Praktikan\n& Asisten" as UC20
        usecase "Melihat Rekap Hasil Penilaian"        as UC21
        usecase "Melihat Tugas Praktikum"              as UC22
        usecase "Melihat Modul Praktikum"              as UC23
    }
}

' ── Hubungan Actor ───────────────────────────────────────────────

' SuperAdmin – full control + view
SuperAdmin --> UC01
SuperAdmin --> UC02
SuperAdmin --> UC03
SuperAdmin --> UC04
SuperAdmin --> UC06
SuperAdmin --> UC07
SuperAdmin --> UC08
SuperAdmin --> UC09
SuperAdmin --> UC10
SuperAdmin --> UC12
SuperAdmin --> UC13
SuperAdmin --> UC17
SuperAdmin --> UC18
SuperAdmin --> UC19
SuperAdmin --> UC20
SuperAdmin --> UC21
SuperAdmin --> UC22
SuperAdmin --> UC23

' Admin – full control + view
Admin --> UC01
Admin --> UC02
Admin --> UC03
Admin --> UC04
Admin --> UC06
Admin --> UC07
Admin --> UC08
Admin --> UC09
Admin --> UC10
Admin --> UC12
Admin --> UC13
Admin --> UC17
Admin --> UC18
Admin --> UC19
Admin --> UC20
Admin --> UC21
Admin --> UC22
Admin --> UC23

' Asisten – kelola konten & peserta, tidak bisa create/delete praktikum
Asisten --> UC02
Asisten --> UC03
Asisten --> UC04
Asisten --> UC06
Asisten --> UC08
Asisten --> UC09
Asisten --> UC10
Asisten --> UC12
Asisten --> UC13
Asisten --> UC17
Asisten --> UC18
Asisten --> UC19
Asisten --> UC20
Asisten --> UC21
Asisten --> UC22
Asisten --> UC23

' Dosen – view-only
Dosen --> UC02
Dosen --> UC17
Dosen --> UC18
Dosen --> UC19
Dosen --> UC20
Dosen --> UC21
Dosen --> UC22
Dosen --> UC23

' Kadep – mewarisi akses Dosen via generalisasi

' Praktikan – view & submit only
Praktikan --> UC05
Praktikan --> UC11
Praktikan --> UC14
Praktikan --> UC15
Praktikan --> UC16

@enduml
