@startuml SEQ_17_MELIHAT_REKAP_PRAKTIKUM
!theme plain
skinparam defaultFontSize 12
title SEQ-17 · Melihat Rekap Nilai & Absensi Praktikum (View-Only)\nAktor: Dosen / Kadep

actor       "Dosen / Kadep"                as Actor
boundary    "Browser"                      as Browser
control     "PraktikumController"          as Controller
entity      "Praktikum Model"              as ModelP
entity      "Absensi Model"                as ModelA
entity      "Penilaian Model"              as ModelN
database    "DB"                           as DB

note over Actor, DB : auth:sanctum | role: dosen, kadep\nView-only — tidak ada aksi CRUD

' ══════════════════════════════════════════════════════
== Skenario A: Melihat Daftar Praktikum ==
' ══════════════════════════════════════════════════════

Actor   ->  Browser    : Buka menu Praktikum
Browser ->  Controller : GET /praktikum\n[auth:sanctum | role:dosen,kadep]

activate Controller
Controller -> Controller : authorize: can('viewAny', Praktikum)\n(policy: izinkan dosen, kadep)

alt Tidak punya hak akses
    Controller --> Browser : 403 Forbidden
    Browser --> Actor      : Halaman "Akses Ditolak"
else Berhak melihat
    Controller -> ModelP   : with(['aslab','pertemuan'])->latest()->get()
    activate ModelP
    ModelP -> DB : SELECT praktikum JOIN aslab, pertemuan
    DB --> ModelP : daftar praktikum
    deactivate ModelP

    Controller --> Browser : Inertia::render('Praktikum/Index', [\n  praktikum,\n  viewOnly: true\n])
    Browser --> Actor      : Daftar praktikum\n- Tidak ada tombol Tambah / Edit / Hapus
end
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario B: Melihat Rekap Nilai Praktikum ==
' ══════════════════════════════════════════════════════

Actor   ->  Browser    : Pilih praktikum → klik "Rekap Nilai"
Browser ->  Controller : GET /praktikum/{id}/rekap-nilai\n[auth:sanctum | role:dosen,kadep]

activate Controller
Controller -> Controller : authorize: can('view', praktikum)
Controller -> ModelP     : findOrFail(id)->load(['pertemuan.tugas','praktikan'])
activate ModelP
ModelP -> DB : SELECT praktikum JOIN pertemuan, tugas, praktikan
DB --> ModelP : detail praktikum + komponen nilai
deactivate ModelP

Controller -> ModelN     : where(praktikum_id, id)\n.with(['praktikan','tugas'])\n.get()
activate ModelN
ModelN -> DB : SELECT penilaian_tugas\nWHERE praktikum_id = ?
DB --> ModelN : semua nilai
deactivate ModelN

Controller -> Controller : groupBy praktikan → hitung rata-rata per pertemuan\ndan total nilai akhir

Controller --> Browser   : Inertia::render('Praktikum/RekapNilai', [\n  praktikum,\n  nilaiPerPraktikan,\n  viewOnly: true\n])
Browser --> Actor        : Tabel rekap nilai:\n- Kolom: Nama Praktikan, Nilai per Pertemuan, Nilai Akhir\n- Tidak ada aksi edit nilai
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario C: Melihat Rekap Absensi Praktikum ==
' ══════════════════════════════════════════════════════

Actor   ->  Browser    : Pilih praktikum → klik "Rekap Absensi"
Browser ->  Controller : GET /praktikum/{id}/rekap-absensi\n[auth:sanctum | role:dosen,kadep]

activate Controller
Controller -> Controller : authorize: can('view', praktikum)
Controller -> ModelA     : where(praktikum_id, id)\n.with(['praktikan','pertemuan'])\n.get()
activate ModelA
ModelA -> DB : SELECT absensi_praktikum\nWHERE praktikum_id = ?\nJOIN users AS praktikan, pertemuan
DB --> ModelA : data absensi
deactivate ModelA

Controller -> Controller : groupBy praktikan → hitung\nhadir / tidak hadir / izin per pertemuan

Controller --> Browser   : Inertia::render('Praktikum/RekapAbsensi', [\n  praktikum,\n  absensiPerPraktikan,\n  viewOnly: true\n])
Browser --> Actor        : Tabel rekap absensi:\n- Kolom: Nama Praktikan, Status per Pertemuan, % Kehadiran\n- Tidak ada aksi edit absensi
deactivate Controller

@enduml
