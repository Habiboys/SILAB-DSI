@startuml SEQ_15_RIWAYAT_PENGUMPULAN
!theme plain
skinparam defaultFontSize 12
title SEQ-15 · Melihat Riwayat Pengumpulan Tugas\nAktor: Praktikan

actor       "Praktikan"                   as Praktikan
boundary    "Browser"    as Browser
control     "PraktikanController"         as Controller
entity      "PengumpulanTugas Model"      as ModelPT
entity      "NilaiRubrik Model"           as ModelNR
entity      "KomponenRubrik Model"        as ModelKR
database    "pengumpulan_tugas"            as DB

note over Praktikan, DB : auth:sanctum + role:praktikan\nHanya dapat melihat pengumpulan MILIK SENDIRI

' ══════════════════════════════════════════════════════
== Skenario A: Lihat Semua Riwayat Pengumpulan ==
' ══════════════════════════════════════════════════════

Praktikan ->  Browser    : Klik menu "Riwayat Tugas"
Browser   ->  Controller : GET /praktikan/riwayat-tugas\n[auth + role:praktikan]

activate Controller
Controller -> ModelPT : where('user_id', auth_id)\n.with([\n  'tugas.praktikum.laboratorium'\n])\n.latest('dikumpulkan_at')->get()
activate ModelPT
ModelPT -> DB : SELECT pengumpulan_tugas\n  JOIN tugas_praktikum\n  JOIN praktikum JOIN laboratorium\nWHERE user_id = ?\nORDER BY dikumpulkan_at DESC
DB --> ModelPT : list riwayat semua pengumpulan
ModelPT --> Controller : Collection<PengumpulanTugas>
deactivate ModelPT

Controller --> Browser : Inertia::render('Praktikan/RiwayatTugas', [riwayat])
Browser    --> Praktikan : Tabel riwayat pengumpulan:\n- Nama tugas, praktikum\n- Tanggal dikumpulkan\n- Status: dikirim / dinilai / ditolak\n- Nilai akhir (jika sudah dinilai)\n- Tombol: Lihat Detail
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario B: Lihat Detail Pengumpulan + Nilai ==
' ══════════════════════════════════════════════════════

Praktikan ->  Browser    : Klik "Lihat Detail" pada riwayat
Browser   ->  Controller : GET /praktikan/riwayat-tugas/{pengumpulan}\n[auth + role:praktikan]

activate Controller
Controller -> ModelPT : findOrFail(id)
activate ModelPT
ModelPT -> DB : SELECT pengumpulan_tugas WHERE id = ?
DB --> ModelPT : record
ModelPT --> Controller : PengumpulanTugas $pengumpulan
deactivate ModelPT

Controller -> Controller : Otorisasi: pastikan pengumpulan.user_id == auth_id
alt Bukan milik praktikan ini
    Controller --> Browser : 403 Forbidden
    Browser --> Praktikan : Akses ditolak
else Milik sendiri
    Controller -> ModelPT : load([\n  'tugas.komponenRubrik',\n  'tugas.praktikum',\n  'nilaiRubrik.komponenRubrik'\n])
    activate ModelPT
    ModelPT -> DB : SELECT komponen_rubrik + nilai_rubrik\nWHERE pengumpulan_id = ?
    DB --> ModelPT : data penilaian per komponen
    deactivate ModelPT

    Controller --> Browser : Inertia::render('Praktikan/DetailRiwayat', [\n  pengumpulan,\n  tugas,\n  nilai_per_komponen: [\n    {komponen, bobot, nilai_angka, bobot_kontribusi}\n  ],\n  nilai_total,\n  catatan_penilai,\n  alasan_penolakan (jika ditolak)\n])

    Browser --> Praktikan : Halaman detail riwayat:\n- File / link yang dikumpulkan\n- Tanggal & status\n- Breakdown nilai per komponen rubrik\n- Nilai total\n- Catatan / feedback dari penilai\n- Jika ditolak: alasan penolakan + tombol Kumpulkan Ulang
end
deactivate Controller

@enduml
