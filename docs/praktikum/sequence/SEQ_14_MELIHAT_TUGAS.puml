@startuml SEQ_14_MELIHAT_TUGAS
!theme plain
skinparam defaultFontSize 12
title SEQ-14 · Melihat Tugas & Detail Tugas Praktikum\nAktor: Praktikan

actor       "Praktikan"                  as Praktikan
boundary    "Browser"   as Browser
control     "PraktikanController"        as Controller
entity      "TugasPraktikum Model"       as ModelT
entity      "KomponenRubrik Model"       as ModelKR
entity      "PengumpulanTugas Model"     as ModelPT
database    "tugas_praktikum"             as DB

note over Praktikan, DB : auth:sanctum + role:praktikan

' ══════════════════════════════════════════════════════
== Skenario A: Lihat Semua Daftar Tugas (seluruh praktikum) ==
' ══════════════════════════════════════════════════════

Praktikan ->  Browser    : Klik menu "Tugas Saya"
Browser   ->  Controller : GET /praktikan/daftar-tugas\n[auth + role:praktikan]

activate Controller
Controller -> ModelT : whereHas('praktikum.praktikans',\n  fn(q) => q.where('user_id', auth_id))\n.with([\n  'praktikum.laboratorium',\n  'pengumpulan' => fn(q) => q.where('user_id', auth_id)\n])->orderBy('deadline')->get()
activate ModelT
ModelT -> DB : SELECT tugas_praktikum\n  JOIN praktikum JOIN praktikan_praktikum\n  JOIN laboratorium\n  LEFT JOIN pengumpulan_tugas (WHERE user_id = ?)\nWHERE praktikan enrolled\nORDER BY deadline ASC
DB --> ModelT : list tugas + status pengumpulan masing-masing
ModelT --> Controller : Collection<TugasPraktikum>
deactivate ModelT

Controller --> Browser : Inertia::render('Praktikan/DaftarTugas', [tugas])
Browser    --> Praktikan : Daftar tugas digroup per praktikum:\n- Nama tugas, deadline\n- Status: Belum / Dikirim / Dinilai / Ditolak\n- Tombol: Detail, Kumpulkan
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario B: Lihat Detail Tugas ==
' ══════════════════════════════════════════════════════

Praktikan ->  Browser    : Klik "Detail" pada tugas
Browser   ->  Controller : GET /praktikan/tugas/{tugas}\n[auth + role:praktikan]

activate Controller
Controller -> ModelT : findOrFail(id).load([\n  'praktikum.laboratorium',\n  'komponenRubrik' => orderBy urutan\n])
activate ModelT
ModelT -> DB : SELECT tugas_praktikum + relasi\n  JOIN komponen_rubrik ORDER BY urutan\nWHERE id = ?
DB --> ModelT : record + rubrik
ModelT --> Controller : TugasPraktikum $tugas
deactivate ModelT

Controller -> ModelPT : where([tugas_id: id, user_id: auth_id])\n.with(['nilaiRubrik'])->first()
activate ModelPT
ModelPT -> DB : SELECT pengumpulan_tugas\n  LEFT JOIN nilai_rubrik\nWHERE tugas_id=? AND user_id=?
DB --> ModelPT : pengumpulan praktikan (jika ada)
ModelPT --> Controller : ?PengumpulanTugas $pengumpulan
deactivate ModelPT

Controller --> Browser : Inertia::render('Praktikan/DetailTugas', [\n  tugas,\n  komponen_rubrik,\n  pengumpulan (null jika belum)\n])
Browser    --> Praktikan : Halaman detail tugas:\n- Nama, deskripsi, deadline, bobot nilai\n- Tabel komponen rubrik (nama, bobot %)\n- Status & nilai pengumpulan saat ini\n- Tombol: Kumpulkan / Lihat Pengumpulan
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario C: Lihat Tugas dalam Satu Praktikum ==
' ══════════════════════════════════════════════════════

Praktikan ->  Browser    : Buka halaman praktikum tertentu → tab Tugas
Browser   ->  Controller : GET /praktikan/praktikum/{praktikum}/tugas\n[auth + role:praktikan]

activate Controller
Controller -> Controller : Verifikasi praktikan terdaftar\ndi praktikum ini
Controller -> DB : SELECT COUNT(*) FROM praktikan_praktikum\nWHERE praktikum_id=? AND user_id=?
DB --> Controller : count

alt Praktikan tidak terdaftar di praktikum ini
    Controller --> Browser : 403 Forbidden
    Browser --> Praktikan : Akses ditolak
else Terdaftar
    Controller -> ModelT : where('praktikum_id', id)\n.with(['pengumpulan' => where user_id=auth_id])\n.get()
    activate ModelT
    ModelT -> DB : SELECT tugas WHERE praktikum_id=?\n  + pengumpulan user ini
    DB --> ModelT : list tugas
    ModelT --> Controller : Collection
    deactivate ModelT

    Controller --> Browser : Inertia::render('Praktikan/PraktikumTugas', [\n  praktikum, tugas\n])
    Browser --> Praktikan : Daftar tugas dalam praktikum ini:\n- Urutan, deadline, status pengumpulan\n- Tombol: Detail, Kumpulkan
end
deactivate Controller

@enduml
