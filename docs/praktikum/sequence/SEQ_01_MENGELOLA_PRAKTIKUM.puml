@startuml SEQ_01_MENGELOLA_PRAKTIKUM
!theme plain
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
title Sequence Diagram — SEQ-01: Mengelola Praktikum

actor       "Admin"                 as Admin
boundary    "Browser"               as Browser
control     "PraktikumController"   as Controller
entity      "Praktikum Model"       as Model
entity      "KepengurusanLab Model" as ModelKL
database    "praktikum"             as DB

== Lihat Daftar Praktikum ==

Admin   -> Browser     : Akses menu Praktikum
Browser -> Controller  : GET /praktikum
Controller -> ModelKL  : Query kepengurusan lab
ModelKL -> DB          : SELECT kepengurusan_lab WHERE lab_id = ?
DB      --> ModelKL    : Data kepengurusan
ModelKL --> Controller : Data kepengurusan
Controller -> Model    : Query praktikum berdasarkan kepengurusan lab
Model -> DB            : SELECT praktikum WHERE kepengurusan_lab_id = ?
DB      --> Model      : Data praktikum
Model --> Controller   : Data praktikum
Controller --> Browser : Render halaman daftar praktikum
Browser --> Admin      : Tampil daftar praktikum + dropdown lab/tahun

== Tambah Praktikum Baru ==

Admin   -> Browser     : Klik "Tambah Praktikum", isi mata_kuliah, deskripsi
Browser -> Controller  : POST /praktikum {kepengurusan_lab_id, mata_kuliah, deskripsi}
Controller -> Model    : create({kepengurusan_lab_id, mata_kuliah, deskripsi})
Model -> DB            : INSERT INTO praktikum
DB      --> Model      : Data praktikum baru
Model --> Controller   : Data praktikum baru
Controller --> Browser : Redirect dengan notifikasi sukses
Browser --> Admin      : Praktikum baru muncul di daftar

== Edit Praktikum ==

Admin   -> Browser     : Klik "Edit" pada praktikum
Browser -> Controller  : PUT /praktikum/{id}
Controller -> Model    : update({...data})
Model -> DB            : UPDATE praktikum SET ... WHERE id = {id}
DB      --> Model      : Berhasil
Model --> Controller   : Berhasil
Controller --> Browser : Redirect dengan notifikasi sukses
Browser --> Admin      : Data ter-update

== Hapus Praktikum ==

Admin   -> Browser     : Klik "Hapus", konfirmasi
Browser -> Controller  : DELETE /praktikum/{id}
Controller -> Model    : delete()
Model -> DB            : DELETE FROM praktikum WHERE id = {id}
DB      --> Model      : Berhasil
Controller --> Browser : Redirect dengan notifikasi sukses
Browser --> Admin      : Praktikum hilang dari daftar

@enduml
