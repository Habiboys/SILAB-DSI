@startuml SEQ_08_MENGELOLA_TUGAS
!theme plain
skinparam defaultFontSize 12
title SEQ-08 · Mengelola Tugas Praktikum\nAktor: Admin / Asisten

actor       "Admin / Asisten"            as User
boundary    "Browser"   as Browser
control     "TugasPraktikumController"   as Controller
entity      "TugasPraktikum Model"       as Model
collections "Storage\n(disk: public)"    as Storage
database    "tugas_praktikum"             as DB

note over User, DB : active.kepengurusan:praktikum + policy TugasPraktikumPolicy

' ══════════════════════════════════════════════════════
== Skenario A: Lihat Daftar Tugas ==
' ══════════════════════════════════════════════════════

User    ->  Browser    : Buka tab "Tugas" di halaman praktikum
Browser ->  Controller : GET /praktikum/{id}/tugas\n[auth:sanctum + can('viewAny')]

activate Controller
Controller -> Model : where('praktikum_id', id)\n.with(['komponenRubrik'])->get()
activate Model
Model -> DB : SELECT tugas_praktikum\n  LEFT JOIN komponen_rubrik\nWHERE praktikum_id = ?
DB --> Model : list tugas + rubrik
Model --> Controller : Collection<TugasPraktikum>
deactivate Model
Controller --> Browser : Inertia::render('Tugas/Index', [tugas, praktikum])
Browser    --> User    : Tampilkan daftar tugas:\n- Judul, deadline, jumlah komponen rubrik\n- Tombol: lihat, edit, hapus, file
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario B: Tambah Tugas ==
' ══════════════════════════════════════════════════════

User    ->  Browser    : Klik "Tambah Tugas"\n→ isi judul, deskripsi, deadline, bobot_nilai
Browser ->  Controller : POST /praktikum/{id}/tugas\n[active.kepengurusan:praktikum + can('create')]

activate Controller
Controller -> Controller : validate([\n  judul        required|string|max:255,\n  deskripsi    nullable|string,\n  deadline     nullable|date,\n  bobot_nilai  numeric|min:0|max:100,\n  file         nullable|file|mimes:pdf,docx,pptx\n])
alt Ada file attachment
    Controller -> Storage : store('tugas-praktikum', 'public')
    Storage --> Controller : file_path
end
Controller -> Model : create([praktikum_id, judul, deskripsi, deadline, bobot_nilai, file_path])
activate Model
Model -> DB : INSERT INTO tugas_praktikum
DB --> Model : created
deactivate Model
Controller --> Browser : redirect()->back().with('message','...')
Browser    --> User    : Flash sukses + tugas baru di daftar
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario C: Edit Tugas ==
' ══════════════════════════════════════════════════════

User    ->  Browser    : Klik "Edit" pada tugas\n→ ubah detail / ganti file
Browser ->  Controller : PUT /praktikum/tugas/{id}\n[active.kepengurusan:praktikum + can('update')]

activate Controller
Controller -> Controller : validate([judul, deskripsi, deadline, bobot_nilai, file?])
alt Ada file baru
    Controller -> Storage : delete(file lama jika ada)
    Controller -> Storage : store(...) → path baru
end
Controller -> Model : findOrFail(id)->update([...])
activate Model
Model -> DB : UPDATE tugas_praktikum WHERE id = ?
DB --> Model : ok
deactivate Model
Controller --> Browser : redirect()->back().with('message','...')
Browser    --> User    : Flash sukses + data tugas ter-update
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario D: Hapus Tugas ==
' ══════════════════════════════════════════════════════

User    ->  Browser    : Klik "Hapus" → konfirmasi
Browser ->  Controller : DELETE /praktikum/tugas/{id}\n[active.kepengurusan:praktikum + can('delete')]

activate Controller
Controller -> Model : findOrFail(id)
alt Ada file attachment
    Controller -> Storage : delete(file_path)
end
Controller -> Model : delete()
activate Model
Model -> DB : DELETE FROM tugas_praktikum WHERE id = ?
note right of DB : CASCADE: komponen_rubrik,\npengumpulan_tugas
DB --> Model : ok
deactivate Model
Controller --> Browser : redirect()->back().with('message','...')
Browser    --> User    : Flash sukses + tugas hilang
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario E: Download / View File Tugas ==
' ══════════════════════════════════════════════════════

User    ->  Browser    : Klik tombol "Download" atau "Preview" pada tugas
Browser ->  Controller : GET /praktikum/tugas/{id}/download\nOR GET /praktikum/tugas/{id}/view

activate Controller
Controller -> Model : findOrFail(id)
activate Model
Model -> DB : SELECT * FROM tugas_praktikum WHERE id = ?
DB --> Model : record
deactivate Model

alt file_path tidak ada
    Controller --> Browser : redirect()->back()\n.withErrors('Tidak ada file terlampir.')
    Browser --> User : Pesan error
else file_path ada
    Controller -> Storage : disk('public')->path(file_path)
    alt Skenario download
        Controller --> Browser : Storage::download(file_path)
    else Skenario preview
        Controller --> Browser : Stream file inline
    end
    Browser --> User : File diunduh / ditampilkan
end
deactivate Controller

@enduml
