@startuml ACT_09_MENGELOLA_RUBRIK
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-09 - Mengelola Komponen Rubrik Penilaian\nAktor: Admin / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail tugas, tab Rubrik;
|System|
:Query & Tampilkan daftar komponen rubrik;
|Admin / Asisten|
:Lihat daftar komponen rubrik;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Tambah Komponen;
  |Admin / Asisten|
  :Isi form\n(nama komponen, bobot);

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih komponen yang diubah;
  |System|
  :Tampilkan Form Edit Komponen;
  |Admin / Asisten|
  :Ubah nama / bobot;

else (Hapus)
  :Tekan tombol Hapus,\npilih komponen yang dihapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin / Asisten|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin / Asisten|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
  |Admin / Asisten|
endif

stop
@enduml
