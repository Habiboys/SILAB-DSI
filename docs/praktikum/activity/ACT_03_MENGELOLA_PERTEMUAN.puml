@startuml ACT_03_MENGELOLA_PERTEMUAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-03 - Mengelola Pertemuan Praktikum\nAktor: Admin / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail praktikum, tab Pertemuan;
:Pilih aksi;

if (Aksi?) then (Lihat Daftar Pertemuan)
  |System|
  :Ambil data pertemuan;
  :Tampilkan daftar pertemuan;
  |Admin / Asisten|
  :Lihat daftar pertemuan;

elseif (Aksi?) then (Tambah Pertemuan)
  |Admin / Asisten|
  repeat
    :Isi form\n(nomor_pertemuan, judul,\ntanggal, deskripsi?);
    |System|
    :Validasi\n(nomor tidak duplikat);
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin / Asisten|
      :Perbaiki form;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Simpan data baru;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Pertemuan baru ditambahkan;

elseif (Aksi?) then (Edit Pertemuan)
  |Admin / Asisten|
  repeat
    :Klik Edit, ubah data;
    |System|
    :Periksa kelengkapan form;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin / Asisten|
      :Perbaiki form;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Perbarui data;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Data pertemuan diperbarui;

else (Hapus Pertemuan)
  |Admin / Asisten|
  :Klik Hapus, konfirmasi;
  |System|
  :Hapus data;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Pertemuan terhapus;

endif

stop
@enduml
