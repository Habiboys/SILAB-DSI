@startuml ACT_03_MENGELOLA_PERTEMUAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-03 - Mengelola Pertemuan Praktikum / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail praktikum, tab Pertemuan;
|System|
:Query & Tampilkan daftar pertemuan;
|Admin / Asisten|
:Lihat daftar pertemuan;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Tambah Pertemuan;
  |Admin / Asisten|
  :Isi form;

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih data yang ingin diubah;
  |System|
  :Tampilkan Form Edit Pertemuan;
  |Admin / Asisten|
  :Ubah data pertemuan;

else (Hapus)
  :Tekan tombol Hapus,\npilih data yang ingin dihapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin / Asisten|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin / Asisten|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
