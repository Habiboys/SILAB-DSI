@startuml ACT_06_MENGELOLA_PRAKTIKAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-06 - Mengelola Praktikan / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail praktikum, tab Praktikan;
|System|
:Query & Tampilkan daftar praktikan;
|Admin / Asisten|
:Lihat daftar praktikan;

if (Aksi?) then (Tambah Manual)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Tambah Praktikan;
  |Admin / Asisten|
  :Pilih user, assign ke praktikum;

elseif (Aksi?) then (Import CSV/Excel)
  :Tekan tombol Import;
  |System|
  :Tampilkan Form Import;
  |Admin / Asisten|
  :Upload file CSV/Excel\n(NIM, nama, kelas);

else (Hapus)
  :Pilih praktikan,\nklik Hapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin / Asisten|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin / Asisten|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
