@startuml ACT_07_MENGELOLA_ASLAB
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-07 - Mengelola Aslab (Asisten Lab)\nAktor: Admin / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail praktikum, tab Aslab;
:Pilih aksi;

if (Aksi?) then (Lihat Daftar Aslab)
  |System|
  :Ambil data aslab;
  :Tampilkan daftar aslab\n(nama, jabatan, kelas ampu);
  |Admin / Asisten|
  :Lihat daftar aslab;

elseif (Aksi?) then (Assign Aslab)
  |Admin / Asisten|
  repeat
    :Pilih user asisten\n+ jabatan + kelas yang diampu;
    |System|
    :Validasi\n(cek duplikat aslab di praktikum);
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin / Asisten|
      :Pilih asisten lain;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Simpan data baru;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Aslab ditambahkan;

elseif (Aksi?) then (Edit Jabatan / Kelas)
  |Admin / Asisten|
  repeat
    :Klik Edit, ubah jabatan / kelas;
    |System|
    :Periksa kelengkapan form;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin / Asisten|
      :Perbaiki form;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Perbarui data;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Data aslab diperbarui;

else (Hapus Aslab)
  |Admin / Asisten|
  :Pilih aslab, klik Hapus;
  |System|
  :Hapus data;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Aslab dihapus dari daftar;

endif

stop
@enduml
