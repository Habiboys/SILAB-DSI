@startuml ACT_07_MENGELOLA_ASLAB
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-07 - Mengelola Aslab (Asisten Lab)

|Admin|
|System|

|Admin|
start
:Buka detail praktikum, tab Aslab;
|System|
:Query & Tampilkan daftar aslab;
|Admin / Asisten|
:Lihat daftar aslab;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Tambah Aslab;
  |Admin / Asisten|
  :Pilih user asisten\n+ jabatan + kelas yang diampu;

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih aslab yang diubah;
  |System|
  :Tampilkan Form Edit Aslab;
  |Admin / Asisten|
  :Ubah jabatan / kelas;

else (Hapus)
  :Pilih aslab,\nklik Hapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin / Asisten|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin / Asisten|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
