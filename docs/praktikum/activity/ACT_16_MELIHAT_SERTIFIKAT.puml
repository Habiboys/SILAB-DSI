@startuml ACT_16_MELIHAT_SERTIFIKAT
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200

skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-16 - Melihat Sertifikat Sendiri\nAktor: Praktikan

|Praktikan|
|System|

|Praktikan|
start
:Buka menu Sertifikat\natau profil saya;

|System|
:Cek autentikasi & role;
:Ambil data sertifikat_praktikum;

if (Ada sertifikat?) then (tidak)
  :Tampilkan pesan\n"Belum ada sertifikat";
  |Praktikan|
  :Lihat pesan kosong;
  stop
else (ya)
  :Tampilkan daftar sertifikat\n(nama praktikum, tanggal\nterbit, link unduh);
  |Praktikan|
  :Pilih sertifikat ? klik Unduh;
  |System|
  :Mulai unduhan file sertifikat;
  |Praktikan|
  :File PDF sertifikat terunduh;
  stop
endif
@enduml
