@startuml ACT_18_MELIHAT_RUBRIK_PENILAIAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200

skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-18 - Melihat Rubrik Penilaian / Asisten / Dosen / Kadep

|Admin / Asisten / Dosen / Kadep|
|System|

|Admin / Asisten / Dosen / Kadep|
start
:Buka detail tugas, tab Rubrik Penilaian;

|System|
:Cek autentikasi & role;
:Query & Tampilkan daftar komponen rubrik\n(nama, deskripsi, bobot %);

|Admin / Asisten / Dosen / Kadep|
:Lihat daftar komponen rubrik;

if (Ada nilai tambahan?) then (ya)
  |System|
  :Tampilkan tabel nilai tambahan\n(bonus/penalti per praktikan);
  |Admin / Asisten / Dosen / Kadep|
  :Lihat nilai tambahan;
else (tidak)
  :Lihat info "Belum ada nilai tambahan";
endif

stop
@enduml
