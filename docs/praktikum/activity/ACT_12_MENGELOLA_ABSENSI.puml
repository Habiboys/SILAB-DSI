@startuml ACT_12_MENGELOLA_ABSENSI
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-12 - Mengelola Absensi Praktikum\nAktor: Admin / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail pertemuan, tab Absensi;
:Pilih aksi;

if (Aksi?) then (Lihat Daftar Absensi)
  |System|
  :Ambil data absensi;
  :Tampilkan daftar absensi\n(nama, status hadir/alpha/izin/sakit);
  |Admin / Asisten|
  :Lihat daftar absensi;

elseif (Aksi?) then (Rekam Absensi)
  |Admin / Asisten|
  repeat
    :Isi / ubah status absensi\nper praktikan\n(hadir / alpha / izin / sakit);
    |System|
    :Periksa semua status terisi;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin / Asisten|
      :Lengkapi status;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Simpan atau perbarui data;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Absensi tersimpan;

elseif (Aksi?) then (Edit Absensi Individual)
  |Admin / Asisten|
  :Pilih praktikan, ubah status;
  |System|
  :Perbarui data;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Absensi diperbarui;

else (Export Rekap Absensi)
  |Admin / Asisten|
  :Klik Export;
  |System|
  :Ambil data rekap absensi;
  :Buat file Excel;
  :Mulai unduhan file;
  |Admin / Asisten|
  :File Excel rekap terunduh;

endif

stop
@enduml
