@startuml ACT_12_MENGELOLA_ABSENSI
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-12 - Mengelola Absensi Praktikum\nAktor: Admin / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail pertemuan, tab Absensi;
|System|
:Query & Tampilkan daftar absensi;
|Admin / Asisten|
:Lihat daftar absensi;

if (Aksi?) then (Rekam)
  :Tekan tombol Rekam;
  |System|
  :Tampilkan Form Absensi;
  |Admin / Asisten|
  :Isi/ubah status absensi\n(hadir/alpha/izin/sakit);

elseif (Aksi?) then (Edit)
  :Pilih praktikan, ubah status;
  |System|
  :Tampilkan Form Edit Absensi;
  |Admin / Asisten|
  :Ubah status absensi;

else (Export)
  :Klik Export;
  |System|
  :Ambil data rekap absensi;
  :Buat file Excel;
  :Mulai unduhan file;
  |Admin / Asisten|
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin / Asisten|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
  |Admin / Asisten|
endif

stop
@enduml
