@startuml ACT_23_MELIHAT_MODUL_PRAKTIKUM
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200

skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-23 - Melihat Modul Praktikum / Asisten / Dosen / Kadep

|Admin / Asisten / Dosen / Kadep|
|System|

|Admin / Asisten / Dosen / Kadep|
start
:Buka detail pertemuan, tab Modul;

|System|
:Cek autentikasi & role;
:Query & Tampilkan daftar modul\n(judul, tipe, pertemuan,\nstatus sharing);

|Admin / Asisten / Dosen / Kadep|
:Lihat daftar modul;

if (Aksi?) then (Buka/Unduh PDF)
  :Klik modul bertipe file PDF;
  |System|
  :Tampilkan / mulai unduhan file PDF;
  |Admin / Asisten / Dosen / Kadep|
  :Baca / unduh modul PDF;
else (Buka Link URL)
  :Klik modul bertipe link URL;
  |System|
  :Buka tautan modul eksternal;
  |Admin / Asisten / Dosen / Kadep|
  :Akses konten tautan;
endif

stop
@enduml
