@startuml ACT_19_MELIHAT_SERTIFIKAT_PRAKTIKUM
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200

skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-19 - Melihat Sertifikat Praktikum / Asisten / Dosen / Kadep

|Admin / Asisten / Dosen / Kadep|
|System|

|Admin / Asisten / Dosen / Kadep|
start
:Buka detail praktikum, tab Sertifikat;

|System|
:Cek autentikasi & role;
:Query & Tampilkan daftar sertifikat\n(nama praktikan, kategori,\ntanggal generate);

|Admin / Asisten / Dosen / Kadep|
:Lihat daftar sertifikat;

if (Ada sertifikat?) then (tidak)
  :Lihat info "Belum ada sertifikat\ndigenerate";
  stop
else (ya)
  :Pilih sertifikat → klik Unduh\n;
  |System|
  :Mulai unduhan file sertifikat PDF;
  |Admin / Asisten / Dosen / Kadep|
  :File sertifikat terunduh;
  stop
endif
@enduml
