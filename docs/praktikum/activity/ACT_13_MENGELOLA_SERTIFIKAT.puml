@startuml ACT_13_MENGELOLA_SERTIFIKAT
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-13 - Mengelola Sertifikat Praktikum / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail praktikum, tab Sertifikat;
|System|
:Query & Tampilkan daftar sertifikat;
|Admin / Asisten|
:Lihat daftar sertifikat;

if (Aksi?) then (Generate Massal)
  :Klik Generate Semua;
  |System|
  :Tampilkan Pilihan Template;
  |Admin / Asisten|
  :Pilih template sertifikat;

elseif (Aksi?) then (Generate Individual)
  :Pilih praktikan, klik Generate;
  |System|
  :Tampilkan Template Sertifikat;
  |Admin / Asisten|
  :Konfirmasi generate;

else (Hapus)
  :Pilih sertifikat, klik Hapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin / Asisten|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin / Asisten|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
