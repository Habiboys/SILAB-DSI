@startuml SEQUENCE_02_KEUANGAN
scale 0.7
!theme plain
title Sequence Diagram - Modul Keuangan

actor "Admin/Asisten" as AD
actor "Kadep" as KD
boundary "Browser" as UI
control "RiwayatKeuanganController" as RKC
control "RekapKeuanganController" as RRC
entity "RiwayatKeuangan" as RK
entity "NominalKas" as NK
entity "KepengurusanLab" as KEP

' ============================================
' SCENARIO 1: LIHAT RIWAYAT TRANSAKSI
' ============================================
group Scenario 1: Lihat Riwayat Transaksi
    AD -> UI: Akses menu Keuangan
    UI -> RKC: GET /keuangan?kepengurusan_lab_id=X (atau lab_id + tahun_id)

    activate RKC
    RKC -> KEP: with(tahunKepengurusan, laboratorium).find(kepengurusan_lab_id)
    KEP --> RKC: kepengurusanLab

    alt Kepengurusan Tidak Ditemukan
        RKC --> UI: Render View kosong + "Pilih lab dan tahun kepengurusan"
    else Ditemukan
        RKC -> RK: where(kepengurusan_lab_id).with(user)\n.orderBy(tanggal, desc).paginate()
        RK --> RKC: Paginated<RiwayatKeuangan>
        RKC -> RK: where(jenis=masuk).sum(nominal) → totalPemasukan
        RKC -> RK: where(jenis=keluar).sum(nominal) → totalPengeluaran
        RKC -> NK: where(kepengurusan_lab_id).orderBy(created_at, desc).get()
        NK --> RKC: nominalKas
        RKC --> UI: Render RiwayatKeuangan View\n+ totalPemasukan, totalPengeluaran, saldo, nominalKas
    end
    deactivate RKC
end

' ============================================
' SCENARIO 2: CATAT TRANSAKSI (MASUK / KELUAR)
' ============================================
group Scenario 2: Catat Transaksi (Masuk / Keluar)
    AD -> UI: Klik "Tambah Transaksi"
    AD -> UI: Isi Form (tanggal, nominal, jenis, deskripsi, bukti, is_uang_kas)
    UI -> RKC: POST /keuangan

    activate RKC
    RKC -> RKC: validate(tanggal, nominal >= 500, jenis in [masuk,keluar],\n deskripsi, kepengurusan_lab_id, user_id nullable)

    alt Validation Failed
        RKC --> UI: Redirect Back + Errors
    else Valid
        opt is_uang_kas = true
            RKC -> NK: getActiveNominalKas(kepengurusan_lab_id)

            alt Nominal Kas Belum Ditetapkan
                RKC --> UI: Error: "Nominal kas belum ditetapkan. Hubungi admin"
            else Ditemukan
                alt nominal < nominalKas.nominal
                    RKC --> UI: Error: "Nominal minimal [nominalKas.nominal] untuk periode [periode]"
                else Nominal Memenuhi
                    alt nominal > nominalKas.nominal && jenis_pembayaran_kas kosong
                        RKC --> UI: Error: "Pilih jenis pembayaran: Normal atau Lebih"
                    end
                end
            end
        end

        opt Ada Upload Bukti (base64 image)
            RKC -> RKC: decode base64 → validate extension (jpg/jpeg/png/gif)
            RKC -> RKC: Storage::put('bukti/' + fileName, data)
        end

        RKC -> RK: create(tanggal, nominal, jenis, deskripsi, bukti,\n kepengurusan_lab_id, user_id, is_uang_kas, jenis_pembayaran_kas)
        RK --> RKC: record_id
        RKC --> UI: Redirect Back + "Riwayat keuangan berhasil ditambahkan"
    end
    deactivate RKC
end

' ============================================
' SCENARIO 3: EDIT TRANSAKSI
' ============================================
group Scenario 3: Edit Transaksi
    AD -> UI: Klik "Edit" pada transaksi
    AD -> UI: Ubah data (tanggal, nominal, jenis, deskripsi, bukti)
    UI -> RKC: PUT /keuangan/{id}

    activate RKC
    RKC -> RK: findOrFail(id) [model binding]
    RKC -> RKC: validate(tanggal, nominal >= 0, jenis in [masuk,keluar], deskripsi)

    alt Validation Failed
        RKC --> UI: Redirect Back + Errors
    else Valid
        alt bukti = 'hapus'
            RKC -> RKC: Storage::delete(oldPath)
            RKC -> RKC: bukti = null
        else bukti = base64 image baru
            RKC -> RKC: decode + validate extension + save file baru
            RKC -> RKC: Storage::delete(oldPath) [hapus file lama]
        else Tidak ada perubahan bukti
            RKC -> RKC: unset bukti dari validated data
        end

        RKC -> RK: update(tanggal, nominal, jenis, deskripsi, bukti)
        RK --> RKC: updated
        RKC --> UI: Redirect Back + "Riwayat keuangan berhasil diperbarui"
    end
    deactivate RKC
end

' ============================================
' SCENARIO 4: HAPUS TRANSAKSI
' ============================================
group Scenario 4: Hapus Transaksi
    AD -> UI: Klik "Hapus" pada transaksi
    UI -> RKC: DELETE /keuangan/{id}

    activate RKC
    RKC -> RK: findOrFail(id) [model binding]
    RKC -> RK: delete()
    RK --> RKC: deleted
    RKC --> UI: Redirect Back + "Riwayat keuangan berhasil dihapus"
    deactivate RKC
end

' ============================================
' SCENARIO 5: CATATAN KAS (UANG KAS ASISTEN)
' ============================================
group Scenario 5: Catatan Kas
    AD -> UI: Akses menu Catatan Kas
    UI -> RKC: GET /keuangan/catatan-kas?lab_id=X&tahun_id=Y

    activate RKC
    RKC -> KEP: where(lab_id, tahun_id).with(tahunKepengurusan, laboratorium).first()
    KEP --> RKC: kepengurusanLab

    alt Kepengurusan Tidak Ditemukan
        RKC --> UI: Render View kosong + "Pilih lab dan tahun"
    else Ditemukan
        RKC -> RK: where(kepengurusan_lab_id, jenis=masuk, is_uang_kas=true)\n.orderBy(tanggal, asc).get()
        RK --> RKC: catatanKas

        RKC -> RKC: getOrderedMonths(tahunKepengurusan.mulai, tahunKepengurusan.selesai)

        loop For each kas entry
            RKC -> RKC: Parse tanggal → tentukan bulan (M Y) & minggu ke-berapa (1-4)
            RKC -> RKC: Tambahkan kas.bulan & kas.minggu
            RKC -> RKC: Update counter bulanData[bulan][minggu]++
        end

        RKC -> NK: where(kepengurusan_lab_id).orderBy(created_at, desc).get()
        NK --> RKC: nominalKas
        RKC --> UI: Render CatatanKas View\n(tabel matriks Anggota x Bulan-Minggu)
    end
    deactivate RKC
end

' ============================================
' SCENARIO 6: KELOLA NOMINAL KAS
' ============================================
group Scenario 6: Kelola Nominal Kas
    ' --- Set / Update Nominal Kas ---
    AD -> UI: Isi form nominal kas (nominal, periode, deskripsi)
    UI -> RKC: POST /keuangan/nominal-kas

    activate RKC
    RKC -> RKC: validate(kepengurusan_lab_id, nominal >= 0,\n periode in [mingguan, bulanan], deskripsi nullable)

    alt Validation Failed
        RKC --> UI: Redirect Back + Errors
    else Valid
        RKC -> NK: updateOrCreate(\n {kepengurusan_lab_id},\n {nominal, periode, deskripsi, is_active=true}\n)
        NK --> RKC: NominalKas record
        RKC --> UI: Redirect Back + "Nominal kas berhasil disimpan"
    end
    deactivate RKC

    ' --- Toggle Aktif/Nonaktif ---
    AD -> UI: Toggle status aktif nominal kas
    UI -> RKC: PATCH /keuangan/nominal-kas/{id}/toggle

    activate RKC
    RKC -> NK: findOrFail(id)

    alt is_active = true (nonaktifkan)
        RKC -> NK: update(is_active=false)
    else is_active = false (aktifkan)
        RKC -> NK: where(kepengurusan_lab_id, periode).update(is_active=false) [nonaktifkan yang lain]
        RKC -> NK: update(is_active=true)
    end

    NK --> RKC: updated
    RKC --> UI: Redirect Back + "Status nominal kas berhasil diperbarui"
    deactivate RKC

    ' --- Hapus Nominal Kas ---
    AD -> UI: Klik "Hapus" nominal kas
    UI -> RKC: DELETE /keuangan/nominal-kas/{id}

    activate RKC
    RKC -> NK: findOrFail(id)
    RKC -> NK: delete()
    RKC --> UI: Redirect Back + "Nominal kas berhasil dihapus"
    deactivate RKC
end

' ============================================
' SCENARIO 7: REKAP KEUANGAN BULANAN
' ============================================
group Scenario 7: Rekap Keuangan Bulanan
    KD -> UI: Akses menu Rekap Keuangan
    UI -> RRC: GET /keuangan/rekap?lab_id=X&tahun_id=Y

    activate RRC
    RRC -> KEP: where(lab_id, tahun_id).with(tahunKepengurusan, laboratorium).first()
    KEP --> RRC: kepengurusanLab

    alt Kepengurusan Tidak Ditemukan
        RRC --> UI: Render View kosong
    else Ditemukan
        RRC -> RK: where(kepengurusan_lab_id).whereYear(tanggal, tahun)\n.select(MONTH, YEAR, SUM masuk AS pemasukan, SUM keluar AS pengeluaran)\n.groupBy(tahun, bulan).orderBy().get()
        RK --> RRC: Collection<RekapBulanan>

        loop For each bulan
            RRC -> RRC: saldoBerjalan += (pemasukan - pengeluaran)
            RRC -> RRC: item.saldo = saldoBerjalan
            RRC -> RRC: item.nama_bulan = map bulan Indonesia
        end

        RRC -> RRC: calculateKasPaymentSummary(kepengurusan_lab_id)
        RRC --> UI: Render RekapKeuangan View\n(tabel bulanan + chart tren + kasPaymentSummary)
    end
    deactivate RRC
end

' ============================================
' SCENARIO 8: EXPORT PDF LAPORAN KEUANGAN
' ============================================
group Scenario 8: Export PDF Laporan Keuangan
    KD -> UI: Klik "Export PDF"
    UI -> RKC: GET /keuangan/export?lab_id=X&tahun_id=Y

    activate RKC
    RKC -> KEP: where(lab_id, tahun_id).with(laboratorium, tahunKepengurusan).first()
    KEP --> RKC: kepengurusanLab

    alt lab_id atau tahun_id Kosong
        RKC --> UI: JSON 400: "Laboratorium dan Tahun harus dipilih"
    else Kepengurusan Tidak Ditemukan
        RKC --> UI: JSON 404: "Data kepengurusan tidak ditemukan"
    else Ditemukan
        RKC -> RK: where(kepengurusan_lab_id).orderBy(tanggal, desc).get()
        RK --> RKC: riwayatKeuangan

        alt Data Kosong
            RKC --> UI: JSON 404: "Tidak ada riwayat keuangan"
        else Ada Data
            RKC -> RK: sum(jenis=masuk) → totalPemasukan
            RKC -> RK: sum(jenis=keluar) → totalPengeluaran
            RKC -> RKC: saldo = totalPemasukan - totalPengeluaran
            RKC -> RKC: PDF::loadView('pdf.laporan-keuangan',\n {laboratorium, tahun, riwayat, totals})
            RKC --> UI: Stream PDF download\n(laporan_keuangan_[lab]_[tahun].pdf)
        end
    end
    deactivate RKC
end

@enduml
