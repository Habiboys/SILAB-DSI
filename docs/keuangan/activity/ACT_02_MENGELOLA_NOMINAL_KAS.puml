@startuml ACT_02_MENGELOLA_NOMINAL_KAS
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-02 - Mengelola Nominal Kas\nAktor: Admin

|Admin|
|System|

|Admin|
start
:Buka menu Pengaturan Kas\n/ Nominal Kas;
:Pilih aksi;

if (Aksi?) then (Lihat Nominal Kas Aktif)
  |System|
  :Ambil data nominal kas aktif;
  :Tampilkan nominal kas\n+ status aktif;
  |Admin|
  :Lihat nominal kas;

elseif (Aksi?) then (Set / Tambah Nominal Kas)
  |Admin|
  repeat
    :Isi form\n(nominal, keterangan?);
    |System|
    :Periksa nominal > 0;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin|
      :Perbaiki form;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Simpan data baru;
  :Nonaktifkan nominal kas lama;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Nominal kas baru aktif;

elseif (Aksi?) then (Edit Nominal Kas)
  |Admin|
  repeat
    :Klik Edit, ubah nominal;
    |System|
    :Periksa nominal > 0;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin|
      :Perbaiki form;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Perbarui data;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Nominal kas diperbarui;

elseif (Aksi?) then (Toggle Aktif / Nonaktif)
  |Admin|
  :Klik toggle status aktif;
  |System|
  :Perbarui data;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Status nominal kas berubah;

else (Hapus Nominal Kas)
  |Admin|
  :Klik Hapus, konfirmasi;
  |System|
  :Cek apakah nominal kas\nsedang aktif;
  if (Sedang aktif?) then (ya)
    :Tampilkan peringatan\n(nonaktifkan dulu);
    |Admin|
    :Nonaktifkan dulu;
  else (tidak)
    :Hapus data;
    :Tampilkan notifikasi sukses;
    |Admin|
    :Nominal kas terhapus;
  endif

endif

stop
@enduml
