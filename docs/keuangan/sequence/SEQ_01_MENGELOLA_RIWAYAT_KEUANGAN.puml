@startuml SEQ_01_MENGELOLA_RIWAYAT_KEUANGAN
!theme plain
skinparam defaultFontSize 12
title SEQ-01 · Mengelola Riwayat Keuangan\nAktor: Admin

actor       "Admin"                       as Admin
boundary    "Browser"    as Browser
control     "RiwayatKeuanganController"   as Controller
entity      "RiwayatKeuangan Model"       as Model
entity      "NominalKas Model"            as ModelKas
collections "Storage\n(disk: public)"     as Storage
database    "riwayat_keuangan"            as DB

note over Admin, DB : auth:sanctum\nGET — tanpa middleware tambahan\nPOST/PUT/DELETE — active.kepengurusan:keuangan

' ══════════════════════════════════════════════════════
== Skenario A: Lihat Daftar Riwayat Transaksi ==
' ══════════════════════════════════════════════════════

Admin   ->  Browser    : Buka menu Riwayat Keuangan
Browser ->  Controller : GET /riwayat-keuangan?kepengurusan_lab_id=X

activate Controller
Controller -> Controller : Resolve kepengurusanLab\n(dari kepengurusan_lab_id, atau fallback lab_id+tahun_id)
alt kepengurusanLab Tidak Ditemukan
    Controller --> Browser : Inertia::render('RiwayatKeuangan', [\n  riwayatKeuangan:[], totalPemasukan:0, ...\n])
else Ditemukan
    Controller -> Model : where(kepengurusan_lab_id).with(['user','kepengurusanLab'])\n.orderBy('tanggal','desc').paginate(perPage)
    activate Model
    Model -> DB : SELECT riwayat_keuangan JOIN users\nWHERE kepengurusan_lab_id = ?\nORDER BY tanggal DESC
    DB --> Model : paginated records
    deactivate Model
    Controller -> Model : where(jenis='masuk').sum('nominal') → totalPemasukan
    Controller -> Model : where(jenis='keluar').sum('nominal') → totalPengeluaran
    Controller -> ModelKas : where(kepengurusan_lab_id)\n.orderBy(created_at,'desc').get()
    ModelKas -> DB : SELECT nominal_kas WHERE kepengurusan_lab_id = ?
    DB --> ModelKas : nominalKas list
    Controller --> Browser : Inertia::render('RiwayatKeuangan', [\n  riwayatKeuangan, totalPemasukan,\n  totalPengeluaran, saldo, nominalKas,\n  asisten, laboratorium, filters\n])
    Browser     --> Admin  : Tampilkan tabel transaksi + ringkasan saldo
end
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario B: Tambah Transaksi (Masuk / Keluar) ==
' ══════════════════════════════════════════════════════

Admin   ->  Browser    : Klik "Tambah" → isi form
Browser ->  Controller : POST /riwayat-keuangan\n{tanggal, nominal, jenis, deskripsi, bukti?,\n kepengurusan_lab_id, user_id?, is_uang_kas?, jenis_pembayaran_kas?}\n[active.kepengurusan:keuangan]

activate Controller
Controller -> Controller : validate([\n  tanggal              required|date,\n  nominal              required|numeric|min:500,\n  jenis                required|in:masuk,keluar,\n  deskripsi            required|string,\n  kepengurusan_lab_id  required|exists,\n  user_id              nullable|exists:users,id\n])
alt Validasi Gagal
    Controller --> Browser : redirect()->back()->withErrors()
    Browser     --> Admin  : Tampilkan pesan error
else Validasi Lolos
    opt is_uang_kas = true
        Controller -> ModelKas : getActiveNominalKas(kepengurusan_lab_id)
        alt Nominal Kas Belum Ditetapkan
            Controller --> Browser : redirect()->back()->withErrors(['is_uang_kas': '...'])
        else Ditemukan
            alt nominal < nominalKas.nominal
                Controller --> Browser : redirect()->back()->withErrors(['nominal': '...'])
            else nominal > nominalKas.nominal && jenis_pembayaran_kas kosong
                Controller --> Browser : redirect()->back()->withErrors(['jenis_pembayaran_kas': '...'])
            end
        end
    end
    opt Ada bukti (base64 image)
        Controller -> Controller : Decode base64, validasi extension\n(jpg/jpeg/png/gif)
        Controller -> Storage : put('bukti/' + fileName, decodedData)
        Storage --> Controller : bukti path
    end
    Controller -> Model : create([tanggal, nominal, jenis, deskripsi,\n  bukti, kepengurusan_lab_id, user_id,\n  is_uang_kas, jenis_pembayaran_kas])
    activate Model
    Model -> DB : INSERT INTO riwayat_keuangan
    DB --> Model : created (id)
    deactivate Model
    Controller --> Browser : redirect()->back()->with('message', '...')
    Browser     --> Admin  : Flash sukses — "Riwayat keuangan berhasil ditambahkan"
end
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario C: Edit Transaksi ==
' ══════════════════════════════════════════════════════

Admin   ->  Browser    : Klik "Edit" pada transaksi → ubah data
Browser ->  Controller : PUT /riwayat-keuangan/{id}\n{tanggal, nominal, jenis, deskripsi, bukti?}\n[active.kepengurusan:keuangan]

activate Controller
Controller -> Model : findOrFail(id) ← route model binding
activate Model
Model -> DB : SELECT * FROM riwayat_keuangan WHERE id = ?
DB --> Model : record
deactivate Model
Controller -> Controller : validate([tanggal, nominal>=0, jenis, deskripsi])
alt Validasi Gagal
    Controller --> Browser : redirect()->back()->withErrors()
else Validasi Lolos
    alt bukti = 'hapus'
        Controller -> Storage : delete(oldPath)
        Controller -> Controller : bukti = null
    else bukti = base64 image baru
        Controller -> Storage : delete(oldPath jika ada)
        Controller -> Storage : put('bukti/' + newFileName, decoded)
        Storage --> Controller : new bukti path
    else Tidak Ada Perubahan Bukti
        Controller -> Controller : unset('bukti') dari validated data
    end
    Controller -> Model : update([tanggal, nominal, jenis, deskripsi, bukti?])
    Model -> DB : UPDATE riwayat_keuangan WHERE id = ?
    Controller --> Browser : redirect()->back()->with('message', '...')
    Browser     --> Admin  : Flash sukses — "Riwayat keuangan berhasil diperbarui"
end
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario D: Hapus Transaksi ==
' ══════════════════════════════════════════════════════

Admin   ->  Browser    : Klik "Hapus" pada transaksi
Browser ->  Controller : DELETE /riwayat-keuangan/{id}\n[active.kepengurusan:keuangan]

activate Controller
Controller -> Model : findOrFail(id) ← route model binding
Controller -> Model : delete()
Model -> DB : DELETE FROM riwayat_keuangan WHERE id = ?
Controller --> Browser : redirect()->back()->with('message', '...')
Browser     --> Admin  : Flash sukses — "Riwayat keuangan berhasil dihapus"
deactivate Controller

' ══════════════════════════════════════════════════════
== Skenario E: Export PDF Laporan Keuangan ==
' ══════════════════════════════════════════════════════

Admin   ->  Browser    : Klik "Export PDF"
Browser ->  Controller : GET /riwayat-keuangan/export?lab_id=X&tahun_id=Y

activate Controller
Controller -> Controller : Validasi lab_id & tahun_id tidak kosong
alt Params Kosong
    Controller --> Browser : JSON 400 {error: 'Laboratorium dan Tahun harus dipilih'}
else Params Ada
    Controller -> Controller : KepengurusanLab::where(lab_id,tahun_id).with(...).first()
    alt Kepengurusan Tidak Ditemukan
        Controller --> Browser : JSON 404 {error: 'Data kepengurusan tidak ditemukan'}
    else Ditemukan
        Controller -> Model : where(kepengurusan_lab_id)\n.orderBy('tanggal','desc').get()
        activate Model
        Model -> DB : SELECT * FROM riwayat_keuangan\nWHERE kepengurusan_lab_id = ?\nORDER BY tanggal DESC
        DB --> Model : all records
        deactivate Model
        alt Data Kosong
            Controller --> Browser : JSON 404 {error: 'Tidak ada riwayat keuangan'}
        else Ada Data
            Controller -> Model : where(jenis='masuk').sum('nominal') → totalPemasukan
            Controller -> Model : where(jenis='keluar').sum('nominal') → totalPengeluaran
            Controller -> Controller : PDF::loadView('pdf.laporan-keuangan',\n  {laboratorium, tahun, riwayat, totals})\n(Barryvdh DomPDF)
            Controller --> Browser : pdf->stream(filename,\n  ['Content-Disposition':'attachment; filename="..."'])
            Browser     --> Admin  : File PDF laporan keuangan diunduh
        end
    end
end
deactivate Controller

@enduml
