@startuml SEQ_01_MENGELOLA_RIWAYAT_KEUANGAN
!theme plain
skinparam defaultFontSize 12
skinparam TitleFontSize 14
title Sequence Diagram — SEQ-01: Mengelola Riwayat Keuangan


actor       "Admin / SuperAdmin"                     as Admin
boundary    "Browser"                   as Browser
control     "RiwayatKeuanganController" as Controller
entity      "RiwayatKeuangan Model"     as Model
entity      "NominalKas Model"          as ModelKas

== Lihat Riwayat ==

Admin   -> Browser     : Buka menu riwayat keuangan

Browser -> Controller  : GET /riwayat-keuangan

Controller -> Model    : Query transaksi
Model --> Controller : Hasil query
Controller -> ModelKas : Query nominal kas
ModelKas --> Controller : Hasil proses
Controller --> Browser : Render halaman
Browser --> Admin      : Tampil transaksi dan saldo

== Tambah Transaksi ==

Admin   -> Browser     : Klik "Tambah", isi form

Browser -> Controller  : POST /riwayat-keuangan\n{tanggal, nominal, jenis, deskripsi, bukti?}

Controller -> Model    : create\n({tanggal, nominal, jenis, deskripsi, bukti})
Model --> Controller : Hasil proses
Controller --> Browser : Redirect + notifikasi
Browser --> Admin      : Tampil notifikasi

== Edit Transaksi ==

Admin   -> Browser     : Klik "Edit"

Browser -> Controller  : PUT /riwayat-keuangan/{id}\n{tanggal, nominal, jenis, deskripsi, bukti?}

Controller -> Model    : Query transaksi
Model --> Controller : Hasil query
Controller -> Model    : update\n({tanggal, nominal, jenis, deskripsi, bukti?})
Model --> Controller : Hasil proses
Controller --> Browser : Redirect + notifikasi
Browser --> Admin      : Tampil notifikasi

== Hapus Transaksi ==

Admin   -> Browser     : Klik "Hapus"

Browser -> Controller  : DELETE /riwayat-keuangan/{id}

Controller -> Model    : delete()
Model --> Controller : Hasil proses
Controller --> Browser : Redirect + notifikasi
Browser --> Admin      : Tampil notifikasi

@enduml
