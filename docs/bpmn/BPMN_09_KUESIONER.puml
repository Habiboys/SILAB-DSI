@startuml BPMN_09_KUESIONER
!theme plain
title BPMN - Modul Kuesioner / Survey

|#45b7d1| Admin |
|#95e1d3| User (Responden) |
|#dfe6e9| Sistem |

|Admin|
start

' === BUAT KUESIONER ===
partition "Pembuatan Kuesioner" {
  :Akses menu Kuesioner -> Buat Baru;
  :Input detail kuesioner
  (judul, deskripsi, tanggal mulai/selesai);
  
  if (Tipe kuesioner?) then (Internal)
    :Tambah pertanyaan;
    
    while (masih ada pertanyaan?) is (Ya)
      :Input pertanyaan + tipe
      (text / textarea / radio / checkbox / scale);
      
      if (Tipe = radio/checkbox/scale?) then (Ya)
        :Input opsi jawaban;
      else (Tidak)
      endif
      
      :Set wajib diisi (ya/tidak);
    endwhile (Tidak)
    
  else (Eksternal)
    :Input link Google Form / survei eksternal;
  endif
  
  :Pilih target responden (berdasarkan role);
  :Set status aktif & wajib/opsional;
  
  |Sistem|
  :Simpan kuesioner + pertanyaan;
  :Simpan target role;
  
  |Admin|
  :Kuesioner berhasil dibuat;
}

' === PENGISIAN KUESIONER ===
partition "Pengisian oleh Responden" {
  |User (Responden)|
  :Akses menu Kuesioner;
  :Pilih kuesioner yang tersedia;
  
  |Sistem|
  :Cek role user vs target kuesioner;
  
  if (User termasuk target?) then (Ya)
    :Cek apakah sudah pernah mengisi;
    
    if (Sudah mengisi?) then (Ya)
      |User (Responden)|
      :Notifikasi: Sudah mengisi;
    else (Belum)
      |User (Responden)|
      
      if (Tipe?) then (Internal)
        :Tampilkan form pertanyaan;
        :Isi semua jawaban;
        :Submit jawaban;
        
        |Sistem|
        :Validasi jawaban;
        :Simpan respon + jawaban;
        
      else (Eksternal)
        :Redirect ke link eksternal;
      endif
      
      |User (Responden)|
      :Terima kasih telah mengisi;
    endif
  else (Tidak)
    |User (Responden)|
    :Akses ditolak;
  endif
}

' === HASIL SURVEY ===
partition "Analisis Hasil" {
  |Admin|
  :Akses hasil kuesioner;
  
  |Sistem|
  :Aggregasi semua jawaban;
  :Hitung statistik per pertanyaan;
  
  note right
    Statistik yang dihitung:
    - Radio/Scale: distribusi pilihan
    - Checkbox: frekuensi per opsi
    - Text: daftar semua jawaban
    - Total responden
  end note
  
  :Tampilkan dashboard hasil;
  
  |Admin|
  :Review statistik & data responden;
  
  if (Perlu export?) then (Ya)
    :Klik Export Excel;
    |Sistem|
    :Generate file Excel;
    |Admin|
    :Download file hasil survey;
  else (Tidak)
  endif
}

stop

@enduml
