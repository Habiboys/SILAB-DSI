@startuml BPMN_02_KEUANGAN
!theme plain
title BPMN - Modul Keuangan

|#45b7d1| Admin |
|#dfe6e9| Sistem |
|#4ecdc4| Kadep |

|Admin|
start

:Akses Modul Keuangan;

fork
  :Proses Transaksi;
  
  |Sistem|
  :Cek kepengurusan aktif;
  
  if (Kepengurusan Aktif?) then (Ya)
    |Admin|
    :Pilih jenis transaksi;
    
    if (Jenis?) then (Pemasukan)
      :Input data pemasukan
      (sumber, nominal, metode);
    else (Pengeluaran)
      :Input data pengeluaran
      (tujuan, nominal, bukti);
    endif
    
    :Upload bukti transaksi (opsional);
    
    |Sistem|
    :Validasi data transaksi;
    
    if (Valid?) then (Ya)
      :Simpan transaksi ke database;
      :Auto-update rekap bulanan;
      :Hitung ulang saldo;
      |Admin|
      :Transaksi berhasil dicatat;
    else (Tidak)
      |Admin|
      :Tampilkan error validasi;
    endif
    
  else (Tidak)
    |Admin|
    :Akses ditolak (read-only mode);
  endif

fork again
  :Kelola Nominal Kas;
  
  |Admin|
  :Set/update batas nominal kas;
  
  |Sistem|
  :Simpan konfigurasi nominal;
  :Tandai nominal aktif/nonaktif;

fork again
  :Lihat Rekap & Catatan Kas;
  
  |Admin|
  :Pilih periode (bulan/tahun);
  
  |Sistem|
  :Query data transaksi per periode;
  :Hitung total pemasukan;
  :Hitung total pengeluaran;
  :Hitung saldo akhir;
  
  |Admin|
  :Tampilkan dashboard rekap;

fork again
  :Export Laporan;
  
  |Admin|
  :Pilih periode export;
  :Klik Export Excel;
  
  |Sistem|
  :Generate file Excel;
  :Format tabel transaksi;
  :Hitung summary;
  
  |Admin|
  :Download file laporan;

end fork

|Kadep|
:Monitoring keuangan (View-only);
:Lihat rekap & export laporan;

stop

@enduml
