@startuml BPMN_05_PIKET
!theme plain
title BPMN - Modul Piket (Shift Management)

|#45b7d1| Admin |
|#95e1d3| Asisten |
|#dfe6e9| Sistem |

|Admin|
start

' === SETUP PIKET ===
partition "Setup Piket" {
  :Buat periode piket
  (nama, tanggal mulai, tanggal selesai);
  
  |Sistem|
  :Simpan periode piket;
  
  |Admin|
  :Buat jadwal piket;
  :Assign asisten ke slot
  (hari, jam mulai, jam selesai);
  
  |Sistem|
  :Simpan jadwal piket;
}

' === OPERASIONAL PIKET ===
partition "Operasional Harian" {
  |Asisten|
  :Lihat jadwal piket sendiri;
  
  if (Bisa hadir?) then (Ya)
    :Check-in saat piket;
    
    |Sistem|
    :Catat jam masuk;
    
    |Asisten|
    :Jalankan tugas piket;
    :Check-out selesai piket;
    
    |Sistem|
    :Catat jam keluar;
    :Hitung durasi piket;
    :Update status: Hadir;
    
  else (Tidak bisa hadir)
    ' === GANTI JADWAL ===
    partition "Request Ganti Jadwal" {
      |Asisten|
      :Ajukan request ganti jadwal;
      :Input alasan;
      
      |Sistem|
      :Simpan request
      (status: pending);
      
      |Admin|
      :Review request ganti jadwal;
      
      if (Disetujui?) then (Ya)
        :Approve request;
        |Sistem|
        :Update status -> approved;
        :Notifikasi ke asisten;
      else (Tidak)
        :Reject request + alasan;
        |Sistem|
        :Update status -> rejected;
        :Notifikasi ke asisten;
      endif
    }
  endif
}

' === REKAP ABSENSI ===
partition "Rekap Absensi Piket" {
  |Admin|
  :Lihat rekap absensi piket;
  
  |Sistem|
  :Aggregasi data kehadiran;
  :Hitung statistik per asisten;
  :Tampilkan dashboard rekap;
}

stop

@enduml
