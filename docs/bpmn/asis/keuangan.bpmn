<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_SOP_Keuangan_Lab" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collaboration_1">
    <participant id="Pool_SOP" name="BPMN Keuangan Lab Yang Sedang Berjalan" processRef="Process_SOP" />
  </collaboration>
  <process id="Process_SOP" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_Koordinator" name="Koordinator Lab">
        <flowNodeRef>Task_TerimaLaporan</flowNodeRef>
        <flowNodeRef>End_1</flowNodeRef>
      </lane>
      <lane id="Lane_Bendahara" name="Bendahara Lab">
        <flowNodeRef>Task_TerimaBayaran</flowNodeRef>
        <flowNodeRef>GW_Deadline</flowNodeRef>
        <flowNodeRef>GW_ValidasiBuktiKas</flowNodeRef>
        <flowNodeRef>Task_CatatKas</flowNodeRef>
        <flowNodeRef>Task_ValidasiBuktiReimburse</flowNodeRef>
        <flowNodeRef>GW_BuktiReimburseValid</flowNodeRef>
        <flowNodeRef>Task_CairkanReimburse</flowNodeRef>
        <flowNodeRef>GW_SetujuPermintaan</flowNodeRef>
        <flowNodeRef>Task_TolakPermintaan</flowNodeRef>
        <flowNodeRef>Task_TolakBayaran</flowNodeRef>
        <flowNodeRef>Task_CatatPenolakan</flowNodeRef>
        <flowNodeRef>Task_CatatLaporan</flowNodeRef>
        <flowNodeRef>Task_CairkanUang</flowNodeRef>
        <flowNodeRef>Task_CatatTerlambat</flowNodeRef>
      </lane>
      <lane id="Lane_Asisten" name="Asisten Lab">
        <flowNodeRef>Start_1</flowNodeRef>
        <flowNodeRef>Task_SiapkanKas</flowNodeRef>
        <flowNodeRef>GW_MetodeBayar</flowNodeRef>
        <flowNodeRef>Task_BayarCash</flowNodeRef>
        <flowNodeRef>Task_BayarOnline</flowNodeRef>
        <flowNodeRef>Task_LampirBukti</flowNodeRef>
        <flowNodeRef>GW_AdaKebutuhan</flowNodeRef>
        <flowNodeRef>Task_AjukanPermintaan</flowNodeRef>
        <flowNodeRef>Task_BuatBuktiManual</flowNodeRef>
        <flowNodeRef>Task_KirimBukti</flowNodeRef>
        <flowNodeRef>GW_AdaNota</flowNodeRef>
        <flowNodeRef>Task_GunakanDana</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_TerimaBayaran" name="Bendahara Menerima&#10;Pembayaran Kas">
      <incoming>fCashJoin</incoming>
      <incoming>fOnlineJoin</incoming>
      <outgoing>fDeadline</outgoing>
    </task>
    <exclusiveGateway id="GW_Deadline" name="Tepat&#10;Deadline?">
      <incoming>fDeadline</incoming>
      <outgoing>fTepat</outgoing>
      <outgoing>fLambat</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_ValidasiBuktiKas" name="Bukti Sah &#38;&#10;Atas Nama Asisten?">
      <incoming>fTepat</incoming>
      <outgoing>fSah</outgoing>
      <outgoing>fTidakSah</outgoing>
    </exclusiveGateway>
    <task id="Task_CatatKas" name="Catat Pembayaran Kas&#10;di Buku Kas">
      <incoming>fSah</incoming>
      <outgoing>fKasSelesai</outgoing>
    </task>
    <task id="Task_ValidasiBuktiReimburse" name="Bendahara Memvalidasi&#10;Bukti Reimburse">
      <incoming>fValidasiReimburse</incoming>
      <outgoing>fCekBukti</outgoing>
    </task>
    <exclusiveGateway id="GW_BuktiReimburseValid" name="Bukti&#10;Valid?">
      <incoming>fCekBukti</incoming>
      <outgoing>fBuktiValid</outgoing>
      <outgoing>fBuktiTidakValid</outgoing>
    </exclusiveGateway>
    <task id="Task_CairkanReimburse" name="Cairkan Reimburse ke Asisten&#10;Maks. H+7">
      <incoming>fBuktiValid</incoming>
      <outgoing>fReimburseJoin</outgoing>
    </task>
    <startEvent id="Start_1" name="Ada Kebutuhan&#10;Keuangan Lab">
      <outgoing>f1</outgoing>
    </startEvent>
    <task id="Task_SiapkanKas" name="Asisten Menyiapkan&#10;Uang Kas Rp10.000/Bulan">
      <incoming>f1</incoming>
      <outgoing>f2</outgoing>
    </task>
    <exclusiveGateway id="GW_MetodeBayar" name="Metode&#10;Pembayaran?">
      <incoming>f2</incoming>
      <outgoing>fCash</outgoing>
      <outgoing>fOnline</outgoing>
    </exclusiveGateway>
    <task id="Task_BayarCash" name="Bayar Tunai&#10;ke Bendahara">
      <incoming>fCash</incoming>
      <outgoing>fCashJoin</outgoing>
    </task>
    <task id="Task_BayarOnline" name="Bayar Transfer Bank /&#10;Virtual Account E-Wallet">
      <incoming>fOnline</incoming>
      <outgoing>fLampir</outgoing>
    </task>
    <task id="Task_LampirBukti" name="Lampirkan Bukti&#10;Pembayaran Online">
      <incoming>fLampir</incoming>
      <outgoing>fOnlineJoin</outgoing>
    </task>
    <exclusiveGateway id="GW_AdaKebutuhan" name="Ada Kebutuhan&#10;Operasional Lab?">
      <incoming>fKasSelesai</incoming>
      <incoming>fLambatJoin</incoming>
      <incoming>fTolakJoin</incoming>
      <outgoing>fAda</outgoing>
      <outgoing>fTidakAda</outgoing>
    </exclusiveGateway>
    <task id="Task_AjukanPermintaan" name="Asisten Mengajukan&#10;Permintaan Penggunaan Dana">
      <incoming>fAda</incoming>
      <outgoing>fVerifikasi</outgoing>
    </task>
    <task id="Task_BuatBuktiManual" name="Buat Bukti Manual:&#10;Tulis Nominal + TTD Penjual">
      <incoming>fTidakAdaNota</incoming>
      <outgoing>fManualJoin</outgoing>
    </task>
    <task id="Task_KirimBukti" name="Kirim Bukti ke Bendahara&#10;Maks. H+2">
      <incoming>fAdaNota</incoming>
      <incoming>fManualJoin</incoming>
      <outgoing>fValidasiReimburse</outgoing>
    </task>
    <exclusiveGateway id="GW_AdaNota" name="Ada Nota /&#10;Bukti Resmi?">
      <incoming>fCekNota</incoming>
      <outgoing>fAdaNota</outgoing>
      <outgoing>fTidakAdaNota</outgoing>
    </exclusiveGateway>
    <task id="Task_GunakanDana" name="Asisten Menggunakan Dana&#10;untuk Keperluan Lab">
      <incoming>fGunakanDana</incoming>
      <outgoing>fCekNota</outgoing>
    </task>
    <exclusiveGateway id="GW_SetujuPermintaan" name="Permintaan&#10;Disetujui?">
      <incoming>fVerifikasi</incoming>
      <outgoing>fDisetujui</outgoing>
      <outgoing>fDitolak</outgoing>
    </exclusiveGateway>
    <task id="Task_TolakPermintaan" name="Beritahu Asisten:&#10;Permintaan Ditolak">
      <incoming>fDitolak</incoming>
      <outgoing>fPenolakanJoin</outgoing>
    </task>
    <task id="Task_TolakBayaran" name="Catat Pembayaran&#10;Tidak Sah">
      <incoming>fTidakSah</incoming>
      <outgoing>fTolakJoin</outgoing>
    </task>
    <task id="Task_CatatPenolakan" name="Catat Reimburse&#10;Tidak Sah">
      <incoming>fBuktiTidakValid</incoming>
      <outgoing>fPenolakanReimburseJoin</outgoing>
    </task>
    <task id="Task_TerimaLaporan" name="Koordinator Menerima&#10;Laporan Keuangan">
      <incoming>fKeLaporan</incoming>
      <outgoing>fEnd</outgoing>
    </task>
    <task id="Task_CatatLaporan" name="Bendahara Merekap&#10;Laporan Keuangan">
      <incoming>fTidakAda</incoming>
      <incoming>fPenolakanJoin</incoming>
      <incoming>fReimburseJoin</incoming>
      <incoming>fPenolakanReimburseJoin</incoming>
      <outgoing>fKeLaporan</outgoing>
    </task>
    <endEvent id="End_1" name="Proses Keuangan&#10;Selesai">
      <incoming>fEnd</incoming>
    </endEvent>
    <task id="Task_CairkanUang" name="Bendahara Mencairkan&#10;Uang Kas">
      <incoming>fDisetujui</incoming>
      <outgoing>fGunakanDana</outgoing>
    </task>
    <task id="Task_CatatTerlambat" name="Catat Keterlambatan&#10;Pembayaran">
      <incoming>fLambat</incoming>
      <outgoing>fLambatJoin</outgoing>
    </task>
    <sequenceFlow id="fCashJoin" sourceRef="Task_BayarCash" targetRef="Task_TerimaBayaran" />
    <sequenceFlow id="fOnlineJoin" sourceRef="Task_LampirBukti" targetRef="Task_TerimaBayaran" />
    <sequenceFlow id="fDeadline" sourceRef="Task_TerimaBayaran" targetRef="GW_Deadline" />
    <sequenceFlow id="fTepat" name="Ya" sourceRef="GW_Deadline" targetRef="GW_ValidasiBuktiKas" />
    <sequenceFlow id="fLambat" name="Tidak" sourceRef="GW_Deadline" targetRef="Task_CatatTerlambat" />
    <sequenceFlow id="fSah" name="Sah" sourceRef="GW_ValidasiBuktiKas" targetRef="Task_CatatKas" />
    <sequenceFlow id="fTidakSah" name="Tidak Sah" sourceRef="GW_ValidasiBuktiKas" targetRef="Task_TolakBayaran" />
    <sequenceFlow id="fKasSelesai" sourceRef="Task_CatatKas" targetRef="GW_AdaKebutuhan" />
    <sequenceFlow id="fValidasiReimburse" sourceRef="Task_KirimBukti" targetRef="Task_ValidasiBuktiReimburse" />
    <sequenceFlow id="fCekBukti" sourceRef="Task_ValidasiBuktiReimburse" targetRef="GW_BuktiReimburseValid" />
    <sequenceFlow id="fBuktiValid" name="Valid" sourceRef="GW_BuktiReimburseValid" targetRef="Task_CairkanReimburse" />
    <sequenceFlow id="fBuktiTidakValid" name="Tidak Valid" sourceRef="GW_BuktiReimburseValid" targetRef="Task_CatatPenolakan" />
    <sequenceFlow id="fReimburseJoin" sourceRef="Task_CairkanReimburse" targetRef="Task_CatatLaporan" />
    <sequenceFlow id="f1" sourceRef="Start_1" targetRef="Task_SiapkanKas" />
    <sequenceFlow id="f2" sourceRef="Task_SiapkanKas" targetRef="GW_MetodeBayar" />
    <sequenceFlow id="fCash" name="Cash" sourceRef="GW_MetodeBayar" targetRef="Task_BayarCash" />
    <sequenceFlow id="fOnline" name="Online" sourceRef="GW_MetodeBayar" targetRef="Task_BayarOnline" />
    <sequenceFlow id="fLampir" sourceRef="Task_BayarOnline" targetRef="Task_LampirBukti" />
    <sequenceFlow id="fLambatJoin" sourceRef="Task_CatatTerlambat" targetRef="GW_AdaKebutuhan" />
    <sequenceFlow id="fTolakJoin" sourceRef="Task_TolakBayaran" targetRef="GW_AdaKebutuhan" />
    <sequenceFlow id="fAda" name="Ya" sourceRef="GW_AdaKebutuhan" targetRef="Task_AjukanPermintaan" />
    <sequenceFlow id="fTidakAda" name="Tidak" sourceRef="GW_AdaKebutuhan" targetRef="Task_CatatLaporan" />
    <sequenceFlow id="fVerifikasi" sourceRef="Task_AjukanPermintaan" targetRef="GW_SetujuPermintaan" />
    <sequenceFlow id="fTidakAdaNota" name="Tidak Ada" sourceRef="GW_AdaNota" targetRef="Task_BuatBuktiManual" />
    <sequenceFlow id="fManualJoin" sourceRef="Task_BuatBuktiManual" targetRef="Task_KirimBukti" />
    <sequenceFlow id="fAdaNota" name="Ada" sourceRef="GW_AdaNota" targetRef="Task_KirimBukti" />
    <sequenceFlow id="fCekNota" sourceRef="Task_GunakanDana" targetRef="GW_AdaNota" />
    <sequenceFlow id="fGunakanDana" sourceRef="Task_CairkanUang" targetRef="Task_GunakanDana" />
    <sequenceFlow id="fDisetujui" name="Ya" sourceRef="GW_SetujuPermintaan" targetRef="Task_CairkanUang" />
    <sequenceFlow id="fDitolak" name="Tidak" sourceRef="GW_SetujuPermintaan" targetRef="Task_TolakPermintaan" />
    <sequenceFlow id="fPenolakanJoin" sourceRef="Task_TolakPermintaan" targetRef="Task_CatatLaporan" />
    <sequenceFlow id="fPenolakanReimburseJoin" sourceRef="Task_CatatPenolakan" targetRef="Task_CatatLaporan" />
    <sequenceFlow id="fKeLaporan" sourceRef="Task_CatatLaporan" targetRef="Task_TerimaLaporan" />
    <sequenceFlow id="fEnd" sourceRef="Task_TerimaLaporan" targetRef="End_1" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
