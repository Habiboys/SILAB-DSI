<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_SOPInventarisLab" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collab_Lab">
    <participant id="Pool_Lab" name="BPMN Inventaris Laboratorium Yang Sedang Berjalan" processRef="Process_Lab" />
  </collaboration>
  <process id="Process_Lab" isExecutable="false">
    <laneSet id="LaneSet_Lab">
      <lane id="Lane_Mahasiswa" name="Mahasiswa">
        <flowNodeRef>Task_P5_SerahKTP</flowNodeRef>
        <flowNodeRef>Task_P6_GunakanAlat</flowNodeRef>
        <flowNodeRef>Task_P1_MinForm</flowNodeRef>
        <flowNodeRef>Task_P3_IsiForm</flowNodeRef>
      </lane>
      <lane id="Lane_Departemen" name="Departemen">
        <flowNodeRef>Task_ATK4_Disposisi</flowNodeRef>
        <flowNodeRef>Task_I8_DeptArsip</flowNodeRef>
      </lane>
      <lane id="Lane_KaLab" name="Kepala Lab">
        <flowNodeRef>Task_ATK2_KaLabAjukan</flowNodeRef>
        <flowNodeRef>Task_I7_KaLabTeruskan</flowNodeRef>
        <flowNodeRef>Task_I0_KaLabPerintah</flowNodeRef>
      </lane>
      <lane id="Lane_Asisten" name="Asisten">
        <flowNodeRef>Task_I1_BuatDaftar</flowNodeRef>
        <flowNodeRef>Task_I2_CatatJumlah</flowNodeRef>
        <flowNodeRef>Task_I3_CekKondisi</flowNodeRef>
        <flowNodeRef>Task_I4_TentukanNomor</flowNodeRef>
        <flowNodeRef>GW_AlatBaru</flowNodeRef>
        <flowNodeRef>GW_BahanHabis</flowNodeRef>
        <flowNodeRef>GW_AdaPeminjaman</flowNodeRef>
        <flowNodeRef>End_Selesai</flowNodeRef>
        <flowNodeRef>Task_P2_BeriForm</flowNodeRef>
        <flowNodeRef>Task_P4_BeriBuku</flowNodeRef>
        <flowNodeRef>Task_ATK3_Pengadaan</flowNodeRef>
        <flowNodeRef>Task_ATK1_SiapkanDaftar</flowNodeRef>
        <flowNodeRef>Task_I5_CatatAlatBaru</flowNodeRef>
        <flowNodeRef>Task_I6_SerahLaporan</flowNodeRef>
        <flowNodeRef>Task_P8_KembalikanKTP</flowNodeRef>
        <flowNodeRef>Task_P7_CekKembali</flowNodeRef>
        <flowNodeRef>Start_Mulai</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_I1_BuatDaftar" name="Asisten membuat daftar inventaris alat laboratorium">
      <incoming>F_I0</incoming>
      <outgoing>F_I1</outgoing>
    </task>
    <task id="Task_I2_CatatJumlah" name="Asisten mencatat jumlah alat laboratorium">
      <incoming>F_I1</incoming>
      <outgoing>F_I2</outgoing>
    </task>
    <task id="Task_I3_CekKondisi" name="Asisten memeriksa kondisi alat laboratorium">
      <incoming>F_I2</incoming>
      <outgoing>F_I3</outgoing>
    </task>
    <task id="Task_I4_TentukanNomor" name="Asisten menentukan nomor / label alat">
      <incoming>F_I3</incoming>
      <outgoing>F_I4</outgoing>
    </task>
    <exclusiveGateway id="GW_AlatBaru" name="Ada alat baru?">
      <incoming>F_I4</incoming>
      <outgoing>F_GW1_Ya</outgoing>
      <outgoing>F_GW1_Tidak</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_BahanHabis" name="Bahan habis pakai perlu diadakan?">
      <incoming>F_I8</incoming>
      <outgoing>F_GW2_Ya</outgoing>
      <outgoing>F_GW2_Tidak</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_AdaPeminjaman" name="Ada permintaan peminjaman peralatan?">
      <incoming>F_ATK4</incoming>
      <incoming>F_GW2_Tidak</incoming>
      <outgoing>F_GW3_Ya</outgoing>
      <outgoing>F_GW3_Tidak</outgoing>
    </exclusiveGateway>
    <task id="Task_P5_SerahKTP" name="Mahasiswa menyerahkan Kartu ID sebagai jaminan kepada asisten">
      <incoming>F_P4</incoming>
      <outgoing>F_P5</outgoing>
    </task>
    <task id="Task_P6_GunakanAlat" name="Mahasiswa menggunakan peralatan dengan pengawasan asisten">
      <incoming>F_P5</incoming>
      <outgoing>F_P6</outgoing>
    </task>
    <endEvent id="End_Selesai" name="Proses Selesai">
      <incoming>F_P8</incoming>
      <incoming>F_GW3_Tidak</incoming>
    </endEvent>
    <task id="Task_P1_MinForm" name="Mahasiswa meminta form surat peminjaman kepada asisten">
      <incoming>F_GW3_Ya</incoming>
      <outgoing>F_P1</outgoing>
    </task>
    <task id="Task_P3_IsiForm" name="Mahasiswa mengisi, menandatangani form, lalu menyerahkan ke asisten">
      <incoming>F_P2</incoming>
      <outgoing>F_P3</outgoing>
    </task>
    <task id="Task_P2_BeriForm" name="Asisten memberikan form peminjaman untuk diisi mahasiswa">
      <incoming>F_P1</incoming>
      <outgoing>F_P2</outgoing>
    </task>
    <task id="Task_P4_BeriBuku" name="Asisten memberikan buku peminjaman; mahasiswa mengisi data peminjaman">
      <incoming>F_P3</incoming>
      <outgoing>F_P4</outgoing>
    </task>
    <task id="Task_ATK3_Pengadaan" name="Asisten melakukan pengadaan dan mendistribusikan bahan habis pakai ke laboratorium">
      <incoming>F_ATK3</incoming>
      <outgoing>F_ATK4</outgoing>
    </task>
    <task id="Task_ATK1_SiapkanDaftar" name="Asisten menyiapkan daftar bahan habis pakai yang dibutuhkan">
      <incoming>F_GW2_Ya</incoming>
      <outgoing>F_ATK1</outgoing>
    </task>
    <task id="Task_I5_CatatAlatBaru" name="Asisten mencatat tanda pengenal dan nomor / label alat baru">
      <incoming>F_GW1_Ya</incoming>
      <outgoing>F_I5</outgoing>
    </task>
    <task id="Task_I6_SerahLaporan" name="Asisten menyerahkan laporan daftar inventaris ke Ka. Lab">
      <incoming>F_I5</incoming>
      <incoming>F_GW1_Tidak</incoming>
      <outgoing>F_I6</outgoing>
    </task>
    <task id="Task_ATK2_KaLabAjukan" name="Ka. Lab mengajukan kebutuhan bahan habis pakai ke Departemen">
      <incoming>F_ATK1</incoming>
      <outgoing>F_ATK2</outgoing>
    </task>
    <task id="Task_ATK4_Disposisi" name="Departemen mendisposisi dan menyetujui pengajuan bahan habis pakai">
      <incoming>F_ATK2</incoming>
      <outgoing>F_ATK3</outgoing>
    </task>
    <task id="Task_P8_KembalikanKTP" name="Asisten mengembalikan buku peminjaman dan Kartu ID kepada mahasiswa">
      <incoming>F_P7</incoming>
      <outgoing>F_P8</outgoing>
    </task>
    <task id="Task_P7_CekKembali" name="Mahasiswa mengembalikan peralatan; asisten mengecek kondisi dan mencatat di buku peminjaman (jika rusak, mahasiswa dikenakan sanksi)">
      <incoming>F_P6</incoming>
      <outgoing>F_P7</outgoing>
    </task>
    <task id="Task_I7_KaLabTeruskan" name="Ka. Lab meneruskan laporan inventaris ke Departemen">
      <incoming>F_I6</incoming>
      <outgoing>F_I7</outgoing>
    </task>
    <task id="Task_I8_DeptArsip" name="Departemen menerima dan mengarsipkan laporan inventaris alat laboratorium">
      <incoming>F_I7</incoming>
      <outgoing>F_I8</outgoing>
    </task>
    <startEvent id="Start_Mulai" name="Mulai">
      <outgoing>F_S0</outgoing>
    </startEvent>
    <task id="Task_I0_KaLabPerintah" name="Ka. Lab memerintahkan asisten membuat daftar inventaris alat laboratorium">
      <incoming>F_S0</incoming>
      <outgoing>F_I0</outgoing>
    </task>
    <sequenceFlow id="F_I0" sourceRef="Task_I0_KaLabPerintah" targetRef="Task_I1_BuatDaftar" />
    <sequenceFlow id="F_I1" sourceRef="Task_I1_BuatDaftar" targetRef="Task_I2_CatatJumlah" />
    <sequenceFlow id="F_I2" sourceRef="Task_I2_CatatJumlah" targetRef="Task_I3_CekKondisi" />
    <sequenceFlow id="F_I3" sourceRef="Task_I3_CekKondisi" targetRef="Task_I4_TentukanNomor" />
    <sequenceFlow id="F_I4" sourceRef="Task_I4_TentukanNomor" targetRef="GW_AlatBaru" />
    <sequenceFlow id="F_GW1_Ya" name="Ya" sourceRef="GW_AlatBaru" targetRef="Task_I5_CatatAlatBaru" />
    <sequenceFlow id="F_GW1_Tidak" name="Tidak" sourceRef="GW_AlatBaru" targetRef="Task_I6_SerahLaporan" />
    <sequenceFlow id="F_I8" sourceRef="Task_I8_DeptArsip" targetRef="GW_BahanHabis" />
    <sequenceFlow id="F_GW2_Ya" name="Ya" sourceRef="GW_BahanHabis" targetRef="Task_ATK1_SiapkanDaftar" />
    <sequenceFlow id="F_GW2_Tidak" name="Tidak" sourceRef="GW_BahanHabis" targetRef="GW_AdaPeminjaman" />
    <sequenceFlow id="F_ATK4" sourceRef="Task_ATK3_Pengadaan" targetRef="GW_AdaPeminjaman" />
    <sequenceFlow id="F_GW3_Ya" name="Ya" sourceRef="GW_AdaPeminjaman" targetRef="Task_P1_MinForm" />
    <sequenceFlow id="F_GW3_Tidak" name="Tidak" sourceRef="GW_AdaPeminjaman" targetRef="End_Selesai" />
    <sequenceFlow id="F_P4" sourceRef="Task_P4_BeriBuku" targetRef="Task_P5_SerahKTP" />
    <sequenceFlow id="F_P5" sourceRef="Task_P5_SerahKTP" targetRef="Task_P6_GunakanAlat" />
    <sequenceFlow id="F_P6" sourceRef="Task_P6_GunakanAlat" targetRef="Task_P7_CekKembali" />
    <sequenceFlow id="F_P8" sourceRef="Task_P8_KembalikanKTP" targetRef="End_Selesai" />
    <sequenceFlow id="F_P1" sourceRef="Task_P1_MinForm" targetRef="Task_P2_BeriForm" />
    <sequenceFlow id="F_P2" sourceRef="Task_P2_BeriForm" targetRef="Task_P3_IsiForm" />
    <sequenceFlow id="F_P3" sourceRef="Task_P3_IsiForm" targetRef="Task_P4_BeriBuku" />
    <sequenceFlow id="F_ATK3" sourceRef="Task_ATK4_Disposisi" targetRef="Task_ATK3_Pengadaan" />
    <sequenceFlow id="F_ATK1" sourceRef="Task_ATK1_SiapkanDaftar" targetRef="Task_ATK2_KaLabAjukan" />
    <sequenceFlow id="F_I5" sourceRef="Task_I5_CatatAlatBaru" targetRef="Task_I6_SerahLaporan" />
    <sequenceFlow id="F_I6" sourceRef="Task_I6_SerahLaporan" targetRef="Task_I7_KaLabTeruskan" />
    <sequenceFlow id="F_ATK2" sourceRef="Task_ATK2_KaLabAjukan" targetRef="Task_ATK4_Disposisi" />
    <sequenceFlow id="F_P7" sourceRef="Task_P7_CekKembali" targetRef="Task_P8_KembalikanKTP" />
    <sequenceFlow id="F_I7" sourceRef="Task_I7_KaLabTeruskan" targetRef="Task_I8_DeptArsip" />
    <sequenceFlow id="F_S0" sourceRef="Start_Mulai" targetRef="Task_I0_KaLabPerintah" />
  </process>
