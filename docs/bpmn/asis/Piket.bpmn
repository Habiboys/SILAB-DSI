      <bpmndi:BPMNShape id="S_EvEnd" bpmnElement="Ev_End" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="2297" y="517" width="36" height="36" />
