<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Def_SOP_Piket_LBI" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collab_1">
    <participant id="Pool_1" name="SOP Pelaksanaan Piket Laboratorium" processRef="Proc_1" />
  </collaboration>
  <process id="Proc_1" isExecutable="false">
    <laneSet id="LS_1">
      <lane id="Lane_Asisten" name="Asisten">
        <flowNodeRef>Ev_Start</flowNodeRef>
        <flowNodeRef>T_TerimaJadwal</flowNodeRef>
        <flowNodeRef>T_CheckIn</flowNodeRef>
        <flowNodeRef>T_Piket</flowNodeRef>
        <flowNodeRef>Gw_Pengunjung</flowNodeRef>
        <flowNodeRef>T_Layani</flowNodeRef>
        <flowNodeRef>T_CheckOut</flowNodeRef>
      </lane>
      <lane id="Lane_KoorRT" name="Koordinator Rumah Tangga">
        <flowNodeRef>T_SusunJadwal</flowNodeRef>
        <flowNodeRef>T_UmumkanJadwal</flowNodeRef>
        <flowNodeRef>T_Verifikasi</flowNodeRef>
        <flowNodeRef>Gw_Valid</flowNodeRef>
        <flowNodeRef>T_TidakHadir</flowNodeRef>
        <flowNodeRef>T_Rekap</flowNodeRef>
        <flowNodeRef>T_SerahRekap</flowNodeRef>
        <flowNodeRef>T_UmumHasil</flowNodeRef>
      </lane>
      <lane id="Lane_KaLab" name="Kepala Laboratorium">
        <flowNodeRef>T_TinjauRekap</flowNodeRef>
        <flowNodeRef>T_TindakLanjut</flowNodeRef>
        <flowNodeRef>Ev_End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Ev_Start" name="Periode piket dimulai">
      <outgoing>F01</outgoing>
    </startEvent>
    <task id="T_SusunJadwal" name="Menyusun jadwal piket asisten satu periode">
      <incoming>F01</incoming>
      <outgoing>F02</outgoing>
    </task>
    <task id="T_UmumkanJadwal" name="Mengumumkan jadwal piket kepada seluruh asisten">
      <incoming>F02</incoming>
      <outgoing>F03</outgoing>
    </task>
    <task id="T_TerimaJadwal" name="Menerima dan mencatat jadwal piket">
      <incoming>F03</incoming>
      <outgoing>F04</outgoing>
    </task>
    <task id="T_CheckIn" name="Check-in: mencatat jam masuk pada form absensi">
      <incoming>F04</incoming>
      <outgoing>F05</outgoing>
    </task>
    <task id="T_Piket" name="Melaksanakan piket min. 2 jam (jaga lab, layani, kebersihan)">
      <incoming>F05</incoming>
      <outgoing>F06</outgoing>
    </task>
    <exclusiveGateway id="Gw_Pengunjung" name="Ada pengunjung yang perlu dilayani?">
      <incoming>F06</incoming>
      <outgoing>F07_ya</outgoing>
      <outgoing>F07_tidak</outgoing>
    </exclusiveGateway>
    <task id="T_Layani" name="Melayani pengunjung sesuai SOP terkait">
      <incoming>F07_ya</incoming>
      <outgoing>F08</outgoing>
    </task>
    <task id="T_CheckOut" name="Check-out: mencatat jam keluar pada form absensi">
      <incoming>F07_tidak</incoming>
      <incoming>F08</incoming>
      <outgoing>F09</outgoing>
    </task>
    <task id="T_Verifikasi" name="Memverifikasi absensi (durasi min. 2 jam, check-in/out valid)">
      <incoming>F09</incoming>
      <outgoing>F10</outgoing>
    </task>
    <exclusiveGateway id="Gw_Valid" name="Absensi valid?">
      <incoming>F10</incoming>
      <outgoing>F11_valid</outgoing>
      <outgoing>F11_invalid</outgoing>
    </exclusiveGateway>
    <task id="T_TidakHadir" name="Mencatat asisten sebagai tidak hadir piket">
      <incoming>F11_invalid</incoming>
      <outgoing>F12b</outgoing>
    </task>
    <task id="T_Rekap" name="Membuat rekapitulasi absensi piket (valid &#38; tidak valid)">
      <incoming>F11_valid</incoming>
      <incoming>F12b</incoming>
      <outgoing>F13</outgoing>
    </task>
    <task id="T_SerahRekap" name="Menyerahkan rekap absensi kepada Kepala Lab">
      <incoming>F13</incoming>
      <outgoing>F14</outgoing>
    </task>
    <task id="T_TinjauRekap" name="Meninjau rekap absensi piket yang diterima">
      <incoming>F14</incoming>
      <outgoing>F15</outgoing>
    </task>
    <task id="T_TindakLanjut" name="Mengambil tindak lanjut (teguran/sanksi jika diperlukan)">
      <incoming>F15</incoming>
      <outgoing>F16</outgoing>
    </task>
    <task id="T_UmumHasil" name="Mengumumkan hasil rekap absensi kepada seluruh asisten">
      <incoming>F16</incoming>
      <outgoing>F17</outgoing>
    </task>
    <endEvent id="Ev_End" name="Proses piket selesai">
      <incoming>F17</incoming>
    </endEvent>
    <sequenceFlow id="F01" sourceRef="Ev_Start" targetRef="T_SusunJadwal" />
    <sequenceFlow id="F02" sourceRef="T_SusunJadwal" targetRef="T_UmumkanJadwal" />
    <sequenceFlow id="F03" sourceRef="T_UmumkanJadwal" targetRef="T_TerimaJadwal" />
    <sequenceFlow id="F04" sourceRef="T_TerimaJadwal" targetRef="T_CheckIn" />
    <sequenceFlow id="F05" sourceRef="T_CheckIn" targetRef="T_Piket" />
    <sequenceFlow id="F06" sourceRef="T_Piket" targetRef="Gw_Pengunjung" />
    <sequenceFlow id="F07_ya" name="Ya" sourceRef="Gw_Pengunjung" targetRef="T_Layani" />
    <sequenceFlow id="F07_tidak" name="Tidak" sourceRef="Gw_Pengunjung" targetRef="T_CheckOut" />
    <sequenceFlow id="F08" sourceRef="T_Layani" targetRef="T_CheckOut" />
    <sequenceFlow id="F09" sourceRef="T_CheckOut" targetRef="T_Verifikasi" />
    <sequenceFlow id="F10" sourceRef="T_Verifikasi" targetRef="Gw_Valid" />
    <sequenceFlow id="F11_valid" name="Valid" sourceRef="Gw_Valid" targetRef="T_Rekap" />
    <sequenceFlow id="F11_invalid" name="Tidak valid" sourceRef="Gw_Valid" targetRef="T_TidakHadir" />
    <sequenceFlow id="F12b" sourceRef="T_TidakHadir" targetRef="T_Rekap" />
    <sequenceFlow id="F13" sourceRef="T_Rekap" targetRef="T_SerahRekap" />
    <sequenceFlow id="F14" sourceRef="T_SerahRekap" targetRef="T_TinjauRekap" />
    <sequenceFlow id="F15" sourceRef="T_TinjauRekap" targetRef="T_TindakLanjut" />
    <sequenceFlow id="F16" sourceRef="T_TindakLanjut" targetRef="T_UmumHasil" />
    <sequenceFlow id="F17" sourceRef="T_UmumHasil" targetRef="Ev_End" />
  </process>
  <bpmndi:BPMNDiagram id="Diag_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="S_Pool" bpmnElement="Pool_1" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="2230" height="570" />
