        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Praktikan" bpmnElement="Lane_Praktikan" isHorizontal="true">
        <dc:Bounds x="190" y="545" width="1240" height="185" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="242" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="248" y="180" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_1" bpmnElement="Task_1_DosenSampaikan">
        <dc:Bounds x="320" y="115" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_2" bpmnElement="Task_2_KaLabJadwal">
        <dc:Bounds x="320" y="270" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_3" bpmnElement="Task_3_AsistenDiskusi">
        <dc:Bounds x="320" y="425" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_4" bpmnElement="Task_4_AsistenSediakanMateri">
        <dc:Bounds x="525" y="425" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1dfgd9n_di" bpmnElement="Gateway_1dfgd9n" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="725" y="440" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_084ztas_di" bpmnElement="Gateway_084ztas" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="1035" y="440" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_5" bpmnElement="Task_5_AsistenBimbingan">
        <dc:Bounds x="835" y="425" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_5b" bpmnElement="Task_5b_PraktikanPraktikum">
        <dc:Bounds x="835" y="590" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_6" bpmnElement="Task_6_AsistenKumpulNilai">
        <dc:Bounds x="1135" y="425" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_7" bpmnElement="Task_7_DosenHitungNilai">
        <dc:Bounds x="1135" y="115" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_1" bpmnElement="EndEvent_1" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="1332" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1307" y="180" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="278" y="155" />
        <di:waypoint x="320" y="155" />
      </bpmndi:BPMNEdge>
