<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_PelaksanaanPraktikum" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collaboration_Praktikum">
    <participant id="Pool_Praktikum" name="Pelaksanaan Praktikum" processRef="Process_Praktikum" />
  </collaboration>
  <process id="Process_Praktikum" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_Praktikan" name="Praktikan">
        <flowNodeRef>Task_5b_PraktikanPraktikum</flowNodeRef>
      </lane>
      <lane id="Lane_Asisten" name="Asisten">
        <flowNodeRef>Task_3_AsistenDiskusi</flowNodeRef>
        <flowNodeRef>Task_4_AsistenSediakanMateri</flowNodeRef>
        <flowNodeRef>Gateway_1dfgd9n</flowNodeRef>
        <flowNodeRef>Gateway_084ztas</flowNodeRef>
        <flowNodeRef>Task_5_AsistenBimbingan</flowNodeRef>
        <flowNodeRef>Task_6_AsistenKumpulNilai</flowNodeRef>
      </lane>
      <lane id="Lane_KaLab" name="Kepala Lab">
        <flowNodeRef>Task_2_KaLabJadwal</flowNodeRef>
      </lane>
      <lane id="Lane_Dosen" name="Dosen">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_1_DosenSampaikan</flowNodeRef>
        <flowNodeRef>Task_7_DosenHitungNilai</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1" name="Mulai">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <task id="Task_1_DosenSampaikan" name="Dosen menyampaikan rencana pelaksanaan praktikum ke Ka. Lab">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1_DosenSampaikan" />
    <sequenceFlow id="Flow_2" sourceRef="Task_1_DosenSampaikan" targetRef="Task_2_KaLabJadwal" />
    <sequenceFlow id="Flow_3" sourceRef="Task_2_KaLabJadwal" targetRef="Task_3_AsistenDiskusi" />
    <sequenceFlow id="Flow_4" sourceRef="Task_3_AsistenDiskusi" targetRef="Task_4_AsistenSediakanMateri" />
    <sequenceFlow id="Flow_5" sourceRef="Gateway_1dfgd9n" targetRef="Task_5b_PraktikanPraktikum" />
    <sequenceFlow id="Flow_6" sourceRef="Task_5b_PraktikanPraktikum" targetRef="Gateway_084ztas" />
    <sequenceFlow id="Flow_7" sourceRef="Task_5_AsistenBimbingan" targetRef="Gateway_084ztas" />
    <sequenceFlow id="Flow_8" sourceRef="Task_6_AsistenKumpulNilai" targetRef="Task_7_DosenHitungNilai" />
    <sequenceFlow id="Flow_9" sourceRef="Task_7_DosenHitungNilai" targetRef="EndEvent_1" />
    <task id="Task_2_KaLabJadwal" name="Ka. Lab merencanakan jadwal praktikum kepada asisten">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>
    <sequenceFlow id="Flow_1d7v39u" sourceRef="Task_4_AsistenSediakanMateri" targetRef="Gateway_1dfgd9n" />
    <sequenceFlow id="Flow_0v73aai" sourceRef="Gateway_1dfgd9n" targetRef="Task_5_AsistenBimbingan" />
    <sequenceFlow id="Flow_09wpa0l" sourceRef="Gateway_084ztas" targetRef="Task_6_AsistenKumpulNilai" />
    <task id="Task_3_AsistenDiskusi" name="Asisten diskusi dengan dosen terkait jadwal, materi, dan daftar peserta praktikum">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>
    <task id="Task_4_AsistenSediakanMateri" name="Asisten menyediakan materi praktikum (modul, soal, tugas pre-praktikum, dan jadwal pelaksanaan)">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_1d7v39u</outgoing>
    </task>
    <parallelGateway id="Gateway_1dfgd9n">
      <incoming>Flow_1d7v39u</incoming>
      <outgoing>Flow_5</outgoing>
      <outgoing>Flow_0v73aai</outgoing>
    </parallelGateway>
    <parallelGateway id="Gateway_084ztas">
      <incoming>Flow_6</incoming>
      <incoming>Flow_7</incoming>
      <outgoing>Flow_09wpa0l</outgoing>
    </parallelGateway>
    <task id="Task_5_AsistenBimbingan" name="Asisten melakukan bimbingan kepada praktikan selama praktikum berlangsung">
      <incoming>Flow_0v73aai</incoming>
      <outgoing>Flow_7</outgoing>
    </task>
    <task id="Task_5b_PraktikanPraktikum" name="Praktikan melaksanakan praktikum">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_6</outgoing>
    </task>
    <task id="Task_6_AsistenKumpulNilai" name="Asisten mengumpulkan dan memeriksa hasil praktikum, membuat nilai praktikum, lalu menyerahkan ke dosen">
      <incoming>Flow_09wpa0l</incoming>
      <outgoing>Flow_8</outgoing>
    </task>
    <task id="Task_7_DosenHitungNilai" name="Dosen menghitung nilai akhir praktikum dari asisten">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_9</outgoing>
    </task>
    <endEvent id="EndEvent_1" name="Proses Praktikum Selesai">
      <incoming>Flow_9</incoming>
    </endEvent>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Praktikum">
      <bpmndi:BPMNShape id="Shape_Pool_Praktikum" bpmnElement="Pool_Praktikum" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1270" height="650" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Dosen" bpmnElement="Lane_Dosen" isHorizontal="true">
