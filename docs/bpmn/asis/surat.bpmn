          <dc:Bounds x="400" y="382" width="58" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_GW_SK" bpmnElement="F_GW_SK">
