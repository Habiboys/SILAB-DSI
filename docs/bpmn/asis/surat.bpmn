      <bpmndi:BPMNShape id="Sh_SM4" bpmnElement="Task_SM4_SekSampaikanArahan">
        <dc:Bounds x="1090" y="365" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SM4b" bpmnElement="Task_SM4b_AsistenTindakLanjut">
        <dc:Bounds x="1300" y="495" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SM5" bpmnElement="Task_SM5_SekKirimDivRT">
        <dc:Bounds x="1510" y="365" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SM5b" bpmnElement="Task_SM5b_DivRTArsip">
        <dc:Bounds x="1720" y="625" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SK1" bpmnElement="Task_SK1_KepalaPerintah">
        <dc:Bounds x="460" y="105" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SK2" bpmnElement="Task_SK2_SekBuatKonsep">
        <dc:Bounds x="670" y="365" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SK3" bpmnElement="Task_SK3_KoorPeriksaParaf">
        <dc:Bounds x="880" y="235" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SK4" bpmnElement="Task_SK4_KaLabTandaTangan">
        <dc:Bounds x="1090" y="105" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SK5" bpmnElement="Task_SK5_KoorKirimSurat">
        <dc:Bounds x="1300" y="235" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_End" bpmnElement="End_Selesai" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="1960" y="387" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1940" y="430" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_S0" bpmnElement="F_S0">
        <di:waypoint x="289" y="405" />
        <di:waypoint x="345" y="406" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_GW_SM" bpmnElement="F_GW_SM">
