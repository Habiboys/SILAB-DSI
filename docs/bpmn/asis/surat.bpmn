      <bpmndi:BPMNShape id="Sh_L_KaLab" bpmnElement="Lane_KepalaLab" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1890" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Start" bpmnElement="Start_Mulai" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="253" y="387" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="257" y="430" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_GW_Jenis" bpmnElement="GW_JenisSurat" isMarkerVisible="true" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="345" y="381" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="333" y="438" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_SM1" bpmnElement="Task_SM1_TerimaAgenda">
        <dc:Bounds x="460" y="365" width="150" height="80" />
