@startuml BPMN_07_KEPENGURUSAN
!theme plain
title BPMN - Modul Kepengurusan & Anggota

|#ff6b6b| Superadmin/Kadep |
|#45b7d1| Admin |
|#dfe6e9| Sistem |

' === SETUP PERIODE ===
|Superadmin/Kadep|
start

partition "Setup Periode Kepengurusan" {
  :Buat tahun kepengurusan baru
  (contoh: 2025/2026);
  
  |Sistem|
  :Simpan data tahun kepengurusan;
  
  |Superadmin/Kadep|
  :Buat Kepengurusan Lab
  (mapping Lab + Tahun);
  
  |Sistem|
  :Simpan kepengurusan lab;
  
  |Superadmin/Kadep|
  :Set periode sebagai AKTIF;
  
  |Sistem|
  :Nonaktifkan periode lama;
  :Aktifkan periode baru;
  :Unlock fitur CRUD di semua modul;
  
  if (Ada SK Kepengurusan?) then (Ya)
    |Superadmin/Kadep|
    :Upload file SK;
    |Sistem|
    :Simpan file SK;
  else (Tidak)
  endif
}

' === KELOLA ANGGOTA ===
partition "Kelola Anggota" {
  |Admin|
  :Akses menu Anggota;
  
  if (Metode input?) then (Manual)
    :Tambah anggota baru;
    :Pilih user + jabatan (struktur);
    
    |Sistem|
    :Simpan data anggota;
    :Auto-assign role berdasarkan jabatan;
    :Auto-assign dynamic permissions
    dari tabel struktur_permissions;
    
  elseif (Transfer) then
    :Transfer dari periode lama;
    
    |Sistem|
    :Query anggota aktif dari
    periode sebelumnya;
    
    |Admin|
    :Pilih anggota yang akan ditransfer;
    :Konfirmasi transfer;
    
    |Sistem|
    :Copy data anggota ke periode baru;
    :Re-assign roles & permissions;
    
  else (Edit/Hapus)
    |Admin|
    :Edit jabatan anggota;
    |Sistem|
    :Update struktur & permissions;
    
    |Admin|
    :Atau hapus anggota;
    |Sistem|
    :Revoke role & permissions;
  endif
}

' === READ-ONLY MODE ===
partition "Mode Read-Only (Periode Lama)" {
  |Sistem|
  note right
    Jika kepengurusan TIDAK aktif:
    - Semua modul menjadi READ-ONLY
    - POST/PUT/DELETE diblokir middleware
    - Badge "Read Only" ditampilkan di UI
  end note
}

stop

@enduml
