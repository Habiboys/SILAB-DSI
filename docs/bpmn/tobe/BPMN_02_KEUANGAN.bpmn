    <sequenceFlow id="F_Keu_07" name="Normal" sourceRef="Gw_Keu_JenisBayarKas" targetRef="Task_Keu_KasNormal" />
    <sequenceFlow id="F_Keu_08" name="Lebih" sourceRef="Gw_Keu_JenisBayarKas" targetRef="Task_Keu_KasLebih" />
    <sequenceFlow id="F_Keu_09" sourceRef="Task_Keu_KasNormal" targetRef="Gw_Keu_GabungKas" />
    <sequenceFlow id="F_Keu_10" sourceRef="Task_Keu_KasLebih" targetRef="Gw_Keu_GabungKas" />
    <sequenceFlow id="F_Keu_11" sourceRef="Gw_Keu_GabungKas" targetRef="Gw_Keu_GabungPemasukan" />
    <sequenceFlow id="F_Keu_12" sourceRef="Task_Keu_TransaksiBiasa" targetRef="Gw_Keu_GabungPemasukan" />
    <sequenceFlow id="F_Keu_13" sourceRef="Gw_Keu_GabungPemasukan" targetRef="Gw_Keu_GabungJenisTransaksi" />
    <sequenceFlow id="F_Keu_P03" sourceRef="Task_Keu_Pengeluaran" targetRef="Gw_Keu_GabungJenisTransaksi" />
    <sequenceFlow id="F_Keu_14" sourceRef="Gw_Keu_GabungJenisTransaksi" targetRef="Gw_Keu_PerluKoreksi" />
    <sequenceFlow id="F_Keu_15" name="Ya" sourceRef="Gw_Keu_PerluKoreksi" targetRef="Task_Keu_Koreksi" />
    <sequenceFlow id="F_Keu_16" name="Tidak" sourceRef="Gw_Keu_PerluKoreksi" targetRef="Gw_Keu_Export" />
    <sequenceFlow id="F_Keu_17" sourceRef="Task_Keu_Koreksi" targetRef="Gw_Keu_Export" />
    <sequenceFlow id="F_Keu_18" name="Ya" sourceRef="Gw_Keu_Export" targetRef="Task_Keu_Unduh" />
    <sequenceFlow id="F_Keu_19" name="Tidak" sourceRef="Gw_Keu_Export" targetRef="Task_Keu_Pantau" />
    <sequenceFlow id="F_Keu_20" sourceRef="Task_Keu_Unduh" targetRef="Task_Keu_Pantau" />
    <sequenceFlow id="F_Keu_21" sourceRef="Task_Keu_Pantau" targetRef="End_Keu" />
    <task id="Task_Keu_BayarKas" name="Membayar uang kas">
      <incoming>F_Keu_04</incoming>
      <outgoing>F_Keu_06</outgoing>
    </task>
    <task id="Task_Keu_Pengeluaran" name="Mencatat pengeluaran">
      <incoming>F_Keu_P01</incoming>
      <outgoing>F_Keu_P03</outgoing>
    </task>
    <task id="Task_Keu_Pantau" name="Memantau dashboard keuangan">
      <incoming>F_Keu_19</incoming>
      <incoming>F_Keu_20</incoming>
      <outgoing>F_Keu_21</outgoing>
    </task>
    <endEvent id="End_Keu" name="Siklus keuangan selesai">
      <incoming>F_Keu_21</incoming>
    </endEvent>
    <dataStoreReference id="DataStoreReference_1ge9mbk" name="Database" />
    <task id="Task_Keu_CatatTransaksi" name="Mencatat transaksi">
      <incoming>F_Keu_02</incoming>
      <outgoing>F_Keu_03</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_1iwyryh">
        <targetRef>DataStoreReference_1ge9mbk</targetRef>
      </dataOutputAssociation>
    </task>
  </process>
