    <sequenceFlow id="F_Keu_14" sourceRef="Gw_Keu_GabungJenisTransaksi" targetRef="Gw_Keu_PerluKoreksi" />
    <sequenceFlow id="F_Keu_15" name="Ya" sourceRef="Gw_Keu_PerluKoreksi" targetRef="Task_Keu_Koreksi" />
    <sequenceFlow id="Flow_01geqq9" name="Tidak" sourceRef="Gw_Keu_PerluKoreksi" targetRef="Task_Keu_Unduh" />
    <sequenceFlow id="Flow_0weleeq" sourceRef="Task_Keu_Koreksi" targetRef="Task_Keu_Unduh" />
    <sequenceFlow id="F_Keu_20" sourceRef="Task_Keu_Unduh" targetRef="Task_Keu_Pantau" />
    <sequenceFlow id="F_Keu_21" sourceRef="Task_Keu_Pantau" targetRef="End_Keu" />
  </process>
