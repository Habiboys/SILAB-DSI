  <collaboration id="Collab_Keuangan">
    <participant id="Pool_Keuangan" name="BPMN Keuangan Laboratorium (To-Be)" processRef="Process_Keuangan" />
  </collaboration>
  <process id="Process_Keuangan" isExecutable="false">
    <laneSet id="LaneSet_Keuangan">
      <lane id="Lane_Keu_Admin" name="Admin">
        <flowNodeRef>Task_Keu_Nominal</flowNodeRef>
        <flowNodeRef>Start_Keu</flowNodeRef>
        <flowNodeRef>Task_Keu_Pengeluaran</flowNodeRef>
        <flowNodeRef>Task_Keu_CatatTransaksi</flowNodeRef>
        <flowNodeRef>Gw_Keu_JenisTransaksi</flowNodeRef>
        <flowNodeRef>Gw_Keu_JenisPemasukan</flowNodeRef>
        <flowNodeRef>Task_Keu_TransaksiBiasa</flowNodeRef>
        <flowNodeRef>Gw_Keu_GabungPemasukan</flowNodeRef>
        <flowNodeRef>Gw_Keu_GabungJenisTransaksi</flowNodeRef>
        <flowNodeRef>Gw_Keu_PerluKoreksi</flowNodeRef>
        <flowNodeRef>Task_Keu_Unduh</flowNodeRef>
        <flowNodeRef>Task_Keu_Koreksi</flowNodeRef>
        <flowNodeRef>Task_Keu_KasLebih</flowNodeRef>
      </lane>
      <lane id="Lane_Keu_Asisten" name="Asisten">
        <flowNodeRef>Task_Keu_BayarKas</flowNodeRef>
      </lane>
      <lane id="Lane_Keu_Kadep" name="Kadep">
        <flowNodeRef>Task_Keu_Pantau</flowNodeRef>
        <flowNodeRef>End_Keu</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_Keu_Nominal" name="Menetapkan nominal kas lab">
      <incoming>F_Keu_01</incoming>
      <outgoing>F_Keu_02</outgoing>
    </task>
    <startEvent id="Start_Keu" name="Siklus keuangan dimulai">
      <outgoing>F_Keu_01</outgoing>
    </startEvent>
    <task id="Task_Keu_Pengeluaran" name="Mencatat pengeluaran">
      <incoming>F_Keu_P01</incoming>
      <outgoing>F_Keu_P03</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_1iwyryh">
        <targetRef>DataStoreReference_1ge9mbk</targetRef>
      </dataOutputAssociation>
    </task>
    <task id="Task_Keu_CatatTransaksi" name="Mencatat transaksi">
      <incoming>F_Keu_02</incoming>
      <outgoing>F_Keu_03</outgoing>
    </task>
    <exclusiveGateway id="Gw_Keu_JenisTransaksi" name="Jenis transaksi?">
      <incoming>F_Keu_03</incoming>
      <outgoing>F_Keu_04a</outgoing>
      <outgoing>F_Keu_P01</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gw_Keu_JenisPemasukan" name="Pemasukan uang kas?">
      <incoming>F_Keu_04a</incoming>
      <outgoing>F_Keu_04</outgoing>
      <outgoing>F_Keu_05</outgoing>
    </exclusiveGateway>
    <task id="Task_Keu_BayarKas" name="Membayar uang kas">
      <incoming>F_Keu_04</incoming>
      <outgoing>Flow_0ppvcm0</outgoing>
    </task>
    <task id="Task_Keu_TransaksiBiasa" name="Mencatat pemasukan non-kas">
      <incoming>F_Keu_05</incoming>
      <outgoing>F_Keu_12</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0jl3r2i">
        <targetRef>DataStoreReference_1ge9mbk</targetRef>
      </dataOutputAssociation>
    </task>
    <exclusiveGateway id="Gw_Keu_GabungPemasukan" name="Gabungkan jenis pemasukan">
      <incoming>F_Keu_12</incoming>
      <incoming>Flow_170bh9m</incoming>
      <outgoing>F_Keu_13</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gw_Keu_GabungJenisTransaksi" name="Gabungkan jenis transaksi">
      <incoming>F_Keu_13</incoming>
      <incoming>F_Keu_P03</incoming>
      <outgoing>F_Keu_14</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gw_Keu_PerluKoreksi" name="Perlu koreksi transaksi?">
      <incoming>F_Keu_14</incoming>
      <outgoing>F_Keu_15</outgoing>
      <outgoing>Flow_01geqq9</outgoing>
    </exclusiveGateway>
    <task id="Task_Keu_Unduh" name="Mengekspor laporan keuangan">
      <incoming>Flow_01geqq9</incoming>
      <incoming>Flow_0weleeq</incoming>
      <outgoing>F_Keu_20</outgoing>
      <property id="Property_0vb291j" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_0jsrykf">
        <sourceRef>DataStoreReference_1ge9mbk</sourceRef>
        <targetRef>Property_0vb291j</targetRef>
      </dataInputAssociation>
    </task>
    <task id="Task_Keu_Koreksi" name="Mengoreksi transaksi">
      <incoming>F_Keu_15</incoming>
      <outgoing>Flow_0weleeq</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_1p9mz2q">
        <targetRef>DataStoreReference_1ge9mbk</targetRef>
      </dataOutputAssociation>
    </task>
    <task id="Task_Keu_Pantau" name="Memantau dashboard keuangan">
      <incoming>F_Keu_20</incoming>
      <outgoing>F_Keu_21</outgoing>
    </task>
    <task id="Task_Keu_KasLebih" name="Mencatat Pemasukan Kas">
      <incoming>Flow_0ppvcm0</incoming>
      <outgoing>Flow_170bh9m</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0s8hkaf">
        <targetRef>DataStoreReference_1ge9mbk</targetRef>
      </dataOutputAssociation>
    </task>
    <endEvent id="End_Keu" name="Siklus keuangan selesai">
      <incoming>F_Keu_21</incoming>
    </endEvent>
    <dataStoreReference id="DataStoreReference_1ge9mbk" name="Database" />
    <sequenceFlow id="F_Keu_01" sourceRef="Start_Keu" targetRef="Task_Keu_Nominal" />
    <sequenceFlow id="F_Keu_02" sourceRef="Task_Keu_Nominal" targetRef="Task_Keu_CatatTransaksi" />
    <sequenceFlow id="F_Keu_P01" name="Pengeluaran" sourceRef="Gw_Keu_JenisTransaksi" targetRef="Task_Keu_Pengeluaran" />
    <sequenceFlow id="F_Keu_P03" sourceRef="Task_Keu_Pengeluaran" targetRef="Gw_Keu_GabungJenisTransaksi" />
