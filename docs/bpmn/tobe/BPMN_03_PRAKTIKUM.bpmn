    <sequenceFlow id="F_Prak_11" name="Belum" sourceRef="Gw_Prak_AdaKumpul" targetRef="Task_Prak_Tugas" />
    <sequenceFlow id="F_Prak_09" sourceRef="Task_Prak_Tugas" targetRef="Gw_Prak_AdaKumpul" />
    <sequenceFlow id="F_Prak_10" name="Ya" sourceRef="Gw_Prak_AdaKumpul" targetRef="Task_Prak_DownloadModul" />
    <sequenceFlow id="F_Prak_17" sourceRef="Task_Prak_Absensi" targetRef="Gw_Prak_MetodeNilai" />
