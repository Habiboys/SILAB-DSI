<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_Praktikum_ToBe" targetNamespace="http://silab.local/bpmn/praktikum-tobe" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collab_Praktikum">
    <participant id="Pool_Praktikum" name="BPMN Praktikum (To-Be)" processRef="Process_Praktikum" />
  </collaboration>
  <process id="Process_Praktikum" isExecutable="false">
    <laneSet id="LaneSet_Praktikum">
      <lane id="Lane_Prak_Praktikan" name="Praktikan">
        <flowNodeRef>Task_Prak_DownloadModul</flowNodeRef>
        <flowNodeRef>Task_Prak_Kumpul</flowNodeRef>
        <flowNodeRef>Gw_Prak_Lengkap</flowNodeRef>
        <flowNodeRef>Task_Prak_Perbaiki</flowNodeRef>
        <flowNodeRef>Task_Prak_Unduh</flowNodeRef>
        <flowNodeRef>End_Prak</flowNodeRef>
      </lane>
      <lane id="Lane_Prak_Asisten" name="Asisten">
        <flowNodeRef>Gw_Prak_MetodeNilai</flowNodeRef>
        <flowNodeRef>Task_Prak_NilaiManual</flowNodeRef>
        <flowNodeRef>Task_Prak_NilaiRubrik</flowNodeRef>
        <flowNodeRef>Task_Prak_ImportNilai</flowNodeRef>
        <flowNodeRef>Gw_Prak_GabungNilai</flowNodeRef>
        <flowNodeRef>Task_Prak_Absensi</flowNodeRef>
      </lane>
      <lane id="Lane_Prak_Admin" name="Admin">
        <flowNodeRef>Task_Prak_SubKelas</flowNodeRef>
        <flowNodeRef>Task_Prak_Pertemuan</flowNodeRef>
        <flowNodeRef>Task_Prak_Tugas</flowNodeRef>
        <flowNodeRef>Gw_Prak_AdaKumpul</flowNodeRef>
        <flowNodeRef>Task_Prak_Sertifikat</flowNodeRef>
        <flowNodeRef>Task_Prak_Export</flowNodeRef>
        <flowNodeRef>Gw_Prak_SubKelas</flowNodeRef>
        <flowNodeRef>Task_Prak_Kelas</flowNodeRef>
        <flowNodeRef>Task_Prak_Assign</flowNodeRef>
        <flowNodeRef>Task_Prak_Setup</flowNodeRef>
        <flowNodeRef>Start_Prak</flowNodeRef>
        <flowNodeRef>Task_Prak_Final</flowNodeRef>
        <flowNodeRef>Gw_Prak_Sertifikat</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_Prak_SubKelas" name="Membagi kelas ke sub-kelas">
      <incoming>F_Prak_05</incoming>
      <outgoing>F_Prak_07</outgoing>
    </task>
    <task id="Task_Prak_Pertemuan" name="Menyusun pertemuan dan modul">
      <incoming>F_Prak_06</incoming>
      <incoming>F_Prak_07</incoming>
      <outgoing>F_Prak_08</outgoing>
    </task>
    <task id="Task_Prak_Tugas" name="Menerbitkan tugas praktikum">
      <incoming>F_Prak_08</incoming>
      <incoming>F_Prak_11</incoming>
      <outgoing>F_Prak_09</outgoing>
    </task>
    <exclusiveGateway id="Gw_Prak_AdaKumpul" name="Sudah ada pengumpulan?">
      <incoming>F_Prak_09</incoming>
      <outgoing>F_Prak_10</outgoing>
      <outgoing>F_Prak_11</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gw_Prak_MetodeNilai" name="Metode penilaian?">
      <incoming>F_Prak_17</incoming>
      <outgoing>F_Prak_18</outgoing>
      <outgoing>F_Prak_19</outgoing>
      <outgoing>F_Prak_20</outgoing>
    </exclusiveGateway>
    <task id="Task_Prak_NilaiManual" name="Menilai manual per pengumpulan">
      <incoming>F_Prak_18</incoming>
      <outgoing>F_Prak_21</outgoing>
    </task>
    <task id="Task_Prak_NilaiRubrik" name="Menilai berbasis rubrik">
      <incoming>F_Prak_19</incoming>
      <outgoing>F_Prak_22</outgoing>
    </task>
    <task id="Task_Prak_ImportNilai" name="Mengimpor nilai dari template">
      <incoming>F_Prak_20</incoming>
      <outgoing>F_Prak_23</outgoing>
    </task>
    <exclusiveGateway id="Gw_Prak_GabungNilai" name="Gabungkan hasil penilaian">
      <incoming>F_Prak_21</incoming>
      <incoming>F_Prak_22</incoming>
      <incoming>F_Prak_23</incoming>
      <outgoing>F_Prak_24</outgoing>
    </exclusiveGateway>
    <task id="Task_Prak_DownloadModul" name="Mengunduh modul dan tugas">
      <incoming>F_Prak_10</incoming>
      <outgoing>F_Prak_12</outgoing>
    </task>
    <task id="Task_Prak_Kumpul" name="Mengumpulkan tugas">
      <incoming>F_Prak_12</incoming>
      <incoming>F_Prak_16</incoming>
      <outgoing>F_Prak_13</outgoing>
    </task>
    <exclusiveGateway id="Gw_Prak_Lengkap" name="Berkas lengkap?">
      <incoming>F_Prak_13</incoming>
      <outgoing>F_Prak_14</outgoing>
      <outgoing>F_Prak_15</outgoing>
    </exclusiveGateway>
    <task id="Task_Prak_Perbaiki" name="Memperbaiki dan unggah ulang tugas">
      <incoming>F_Prak_15</incoming>
      <outgoing>F_Prak_16</outgoing>
    </task>
    <task id="Task_Prak_Absensi" name="Menginput absensi praktikan dan aslab">
      <incoming>F_Prak_14</incoming>
      <outgoing>F_Prak_17</outgoing>
    </task>
    <task id="Task_Prak_Sertifikat" name="Menghasilkan sertifikat praktikum">
      <incoming>F_Prak_26</incoming>
      <outgoing>F_Prak_28</outgoing>
    </task>
    <task id="Task_Prak_Export" name="Mengekspor nilai praktikum">
      <incoming>F_Prak_27</incoming>
      <incoming>F_Prak_28</incoming>
      <outgoing>F_Prak_29</outgoing>
    </task>
    <task id="Task_Prak_Unduh" name="Mengunduh hasil dan sertifikat">
      <incoming>F_Prak_29</incoming>
      <outgoing>F_Prak_30</outgoing>
      <property id="Property_1wjakot" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataInputAssociation_04n56k4">
        <sourceRef>DataStoreReference_1s4ma35</sourceRef>
        <targetRef>Property_1wjakot</targetRef>
      </dataInputAssociation>
    </task>
    <endEvent id="End_Prak" name="Siklus praktikum selesai">
      <incoming>F_Prak_30</incoming>
    </endEvent>
    <exclusiveGateway id="Gw_Prak_SubKelas" name="Perlu sub-kelas?">
      <incoming>F_Prak_04</incoming>
      <outgoing>F_Prak_05</outgoing>
      <outgoing>F_Prak_06</outgoing>
    </exclusiveGateway>
    <task id="Task_Prak_Kelas" name="Menyusun kelas dan jadwal">
      <incoming>F_Prak_03</incoming>
      <outgoing>F_Prak_04</outgoing>
    </task>
    <task id="Task_Prak_Assign" name="Menetapkan asisten praktikum">
      <incoming>F_Prak_02</incoming>
      <outgoing>F_Prak_03</outgoing>
    </task>
    <task id="Task_Prak_Setup" name="Membuat praktikum dan data praktikan">
      <incoming>F_Prak_01</incoming>
      <outgoing>F_Prak_02</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0op4wzk">
        <targetRef>DataStoreReference_1s4ma35</targetRef>
      </dataOutputAssociation>
    </task>
    <startEvent id="Start_Prak" name="Siklus praktikum dimulai">
      <outgoing>F_Prak_01</outgoing>
    </startEvent>
    <sequenceFlow id="F_Prak_05" name="Ya" sourceRef="Gw_Prak_SubKelas" targetRef="Task_Prak_SubKelas" />
    <sequenceFlow id="F_Prak_07" sourceRef="Task_Prak_SubKelas" targetRef="Task_Prak_Pertemuan" />
    <sequenceFlow id="F_Prak_06" name="Tidak" sourceRef="Gw_Prak_SubKelas" targetRef="Task_Prak_Pertemuan" />
