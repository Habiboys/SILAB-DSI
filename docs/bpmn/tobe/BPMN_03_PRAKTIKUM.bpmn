    <sequenceFlow id="F_Prak_20" name="Import" sourceRef="Gw_Prak_MetodeNilai" targetRef="Task_Prak_ImportNilai" />
    <sequenceFlow id="F_Prak_21" sourceRef="Task_Prak_NilaiManual" targetRef="Gw_Prak_GabungNilai" />
    <sequenceFlow id="F_Prak_22" sourceRef="Task_Prak_NilaiRubrik" targetRef="Gw_Prak_GabungNilai" />
    <sequenceFlow id="F_Prak_23" sourceRef="Task_Prak_ImportNilai" targetRef="Gw_Prak_GabungNilai" />
    <sequenceFlow id="F_Prak_24" sourceRef="Gw_Prak_GabungNilai" targetRef="Task_Prak_Final" />
    <sequenceFlow id="F_Prak_12" sourceRef="Task_Prak_DownloadModul" targetRef="Task_Prak_Kumpul" />
    <sequenceFlow id="F_Prak_16" sourceRef="Task_Prak_Perbaiki" targetRef="Task_Prak_Kumpul" />
    <sequenceFlow id="F_Prak_13" sourceRef="Task_Prak_Kumpul" targetRef="Gw_Prak_Lengkap" />
    <sequenceFlow id="F_Prak_14" name="Lengkap" sourceRef="Gw_Prak_Lengkap" targetRef="Task_Prak_Absensi" />
    <sequenceFlow id="F_Prak_15" name="Kurang" sourceRef="Gw_Prak_Lengkap" targetRef="Task_Prak_Perbaiki" />
    <sequenceFlow id="F_Prak_25" sourceRef="Task_Prak_Final" targetRef="Gw_Prak_Sertifikat" />
    <sequenceFlow id="F_Prak_26" name="Ya" sourceRef="Gw_Prak_Sertifikat" targetRef="Task_Prak_Sertifikat" />
    <sequenceFlow id="F_Prak_27" name="Tidak" sourceRef="Gw_Prak_Sertifikat" targetRef="Task_Prak_Export" />
    <sequenceFlow id="F_Prak_28" sourceRef="Task_Prak_Sertifikat" targetRef="Task_Prak_Export" />
    <sequenceFlow id="F_Prak_29" sourceRef="Task_Prak_Export" targetRef="Task_Prak_Unduh" />
    <sequenceFlow id="F_Prak_30" sourceRef="Task_Prak_Unduh" targetRef="End_Prak" />
    <sequenceFlow id="F_Prak_04" sourceRef="Task_Prak_Kelas" targetRef="Gw_Prak_SubKelas" />
    <sequenceFlow id="F_Prak_03" sourceRef="Task_Prak_Assign" targetRef="Task_Prak_Kelas" />
    <sequenceFlow id="F_Prak_02" sourceRef="Task_Prak_Setup" targetRef="Task_Prak_Assign" />
    <sequenceFlow id="F_Prak_01" sourceRef="Start_Prak" targetRef="Task_Prak_Setup" />
    <task id="Task_Prak_Final" name="Memfinalisasi nilai akhir">
      <incoming>F_Prak_24</incoming>
      <outgoing>F_Prak_25</outgoing>
    </task>
    <dataStoreReference id="DataStoreReference_1s4ma35" name="Database" />
    <exclusiveGateway id="Gw_Prak_Sertifikat" name="Perlu generate sertifikat?">
      <incoming>F_Prak_25</incoming>
      <outgoing>F_Prak_26</outgoing>
      <outgoing>F_Prak_27</outgoing>
    </exclusiveGateway>
  </process>
