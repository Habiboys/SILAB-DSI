<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Defs_Praktikum"
    targetNamespace="http://silab.local/bpmn/praktikum">

    <bpmn:collaboration id="Collab_Praktikum">
        <bpmn:participant id="Participant_Praktikum" name="Modul Praktikum"
            processRef="Process_Praktikum" />
    </bpmn:collaboration>

    <bpmn:process id="Process_Praktikum" isExecutable="false">
        <bpmn:laneSet id="LaneSet_Praktikum">
            <bpmn:lane id="Lane_Prak_Admin" name="Admin">
                <bpmn:flowNodeRef>Start_Prak</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Setup</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Assign</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Kelas</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gw_Prak_SubKelas</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_SubKelas</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Pertemuan</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Tugas</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gw_Prak_Sertifikat</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Export</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Sertifikat</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Prak_Asisten" name="Asisten">
                <bpmn:flowNodeRef>Task_Prak_Absensi</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gw_Prak_MetodeNilai</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_NilaiManual</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_NilaiRubrik</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_ImportNilai</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gw_Prak_GabungNilai</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Prak_Praktikan" name="Praktikan">
                <bpmn:flowNodeRef>Task_Prak_DownloadModul</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Kumpul</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Perbaiki</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Unduh</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Prak_Sistem" name="Sistem">
                <bpmn:flowNodeRef>Gw_Prak_AdaKumpul</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gw_Prak_Lengkap</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gw_Prak_ParSplit</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gw_Prak_ParJoin</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Final</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_Prak_Simpan</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>End_Prak</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>

        <bpmn:startEvent id="Start_Prak" name="Siklus praktikum dimulai" />
        <bpmn:task id="Task_Prak_Setup" name="Membuat praktikum dan data praktikan" />
        <bpmn:task id="Task_Prak_Assign" name="Menetapkan asisten praktikum" />
        <bpmn:task id="Task_Prak_Kelas" name="Menyusun kelas dan jadwal" />
        <bpmn:exclusiveGateway id="Gw_Prak_SubKelas" name="Perlu sub-kelas?" />
        <bpmn:task id="Task_Prak_SubKelas" name="Membagi kelas ke sub-kelas" />
        <bpmn:task id="Task_Prak_Pertemuan" name="Menyusun pertemuan dan modul" />
        <bpmn:task id="Task_Prak_Tugas" name="Menerbitkan tugas praktikum" />

        <bpmn:exclusiveGateway id="Gw_Prak_AdaKumpul" name="Sudah ada pengumpulan?" />
        <bpmn:task id="Task_Prak_DownloadModul" name="Mengunduh modul dan tugas" />
        <bpmn:task id="Task_Prak_Kumpul" name="Mengumpulkan tugas" />
        <bpmn:exclusiveGateway id="Gw_Prak_Lengkap" name="Berkas lengkap?" />
        <bpmn:task id="Task_Prak_Perbaiki" name="Memperbaiki dan unggah ulang tugas" />

        <bpmn:parallelGateway id="Gw_Prak_ParSplit" name="Proses absensi dan nilai paralel" />
        <bpmn:task id="Task_Prak_Absensi" name="Menginput absensi praktikan dan aslab" />
        <bpmn:exclusiveGateway id="Gw_Prak_MetodeNilai" name="Metode penilaian" />
        <bpmn:task id="Task_Prak_NilaiManual" name="Menilai manual per pengumpulan" />
        <bpmn:task id="Task_Prak_NilaiRubrik" name="Menilai berbasis rubrik" />
        <bpmn:task id="Task_Prak_ImportNilai" name="Mengimpor nilai dari template" />
        <bpmn:exclusiveGateway id="Gw_Prak_GabungNilai" name="Gabungkan hasil penilaian" />
        <bpmn:parallelGateway id="Gw_Prak_ParJoin" name="Sinkronkan absensi dan nilai" />

        <bpmn:task id="Task_Prak_Final" name="Memfinalisasi nilai akhir" />
        <bpmn:exclusiveGateway id="Gw_Prak_Sertifikat" name="Perlu generate sertifikat?" />
        <bpmn:task id="Task_Prak_Sertifikat" name="Menghasilkan sertifikat praktikum" />
        <bpmn:task id="Task_Prak_Export" name="Mengekspor nilai praktikum" />

        <bpmn:task id="Task_Prak_Simpan" name="Menyimpan nilai akhir">
            <bpmn:dataOutputAssociation id="Assoc_Prak_Write">
                <bpmn:targetRef>DS_Prak_DB</bpmn:targetRef>
            </bpmn:dataOutputAssociation>
        </bpmn:task>
        <bpmn:task id="Task_Prak_Unduh" name="Mengunduh hasil dan sertifikat">
            <bpmn:dataInputAssociation id="Assoc_Prak_Read">
                <bpmn:sourceRef>DS_Prak_DB</bpmn:sourceRef>
                <bpmn:targetRef>Task_Prak_Unduh</bpmn:targetRef>
            </bpmn:dataInputAssociation>
        </bpmn:task>

        <bpmn:dataStoreReference id="DS_Prak_DB" name="Database Praktikum" />
        <bpmn:endEvent id="End_Prak" name="Siklus praktikum selesai" />

        <bpmn:sequenceFlow id="F_Prak_01" sourceRef="Start_Prak" targetRef="Task_Prak_Setup" />
        <bpmn:sequenceFlow id="F_Prak_02" sourceRef="Task_Prak_Setup" targetRef="Task_Prak_Assign" />
        <bpmn:sequenceFlow id="F_Prak_03" sourceRef="Task_Prak_Assign" targetRef="Task_Prak_Kelas" />
        <bpmn:sequenceFlow id="F_Prak_04" sourceRef="Task_Prak_Kelas" targetRef="Gw_Prak_SubKelas" />
        <bpmn:sequenceFlow id="F_Prak_05" sourceRef="Gw_Prak_SubKelas"
            targetRef="Task_Prak_SubKelas" name="Ya" />
        <bpmn:sequenceFlow id="F_Prak_06" sourceRef="Gw_Prak_SubKelas"
            targetRef="Task_Prak_Pertemuan" name="Tidak" />
        <bpmn:sequenceFlow id="F_Prak_07" sourceRef="Task_Prak_SubKelas"
            targetRef="Task_Prak_Pertemuan" />
        <bpmn:sequenceFlow id="F_Prak_08" sourceRef="Task_Prak_Pertemuan"
            targetRef="Task_Prak_Tugas" />
        <bpmn:sequenceFlow id="F_Prak_09" sourceRef="Task_Prak_Tugas" targetRef="Gw_Prak_AdaKumpul" />
        <bpmn:sequenceFlow id="F_Prak_10" sourceRef="Gw_Prak_AdaKumpul"
            targetRef="Task_Prak_DownloadModul" name="Ya" />
        <bpmn:sequenceFlow id="F_Prak_11" sourceRef="Gw_Prak_AdaKumpul" targetRef="Task_Prak_Tugas"
            name="Belum" />
        <bpmn:sequenceFlow id="F_Prak_12" sourceRef="Task_Prak_DownloadModul"
            targetRef="Task_Prak_Kumpul" />
        <bpmn:sequenceFlow id="F_Prak_13" sourceRef="Task_Prak_Kumpul" targetRef="Gw_Prak_Lengkap" />
        <bpmn:sequenceFlow id="F_Prak_14" sourceRef="Gw_Prak_Lengkap" targetRef="Gw_Prak_ParSplit"
            name="Lengkap" />
        <bpmn:sequenceFlow id="F_Prak_15" sourceRef="Gw_Prak_Lengkap" targetRef="Task_Prak_Perbaiki"
            name="Kurang" />
        <bpmn:sequenceFlow id="F_Prak_16" sourceRef="Task_Prak_Perbaiki"
            targetRef="Task_Prak_Kumpul" />

        <bpmn:sequenceFlow id="F_Prak_17" sourceRef="Gw_Prak_ParSplit" targetRef="Task_Prak_Absensi" />
        <bpmn:sequenceFlow id="F_Prak_18" sourceRef="Gw_Prak_ParSplit"
            targetRef="Gw_Prak_MetodeNilai" />
        <bpmn:sequenceFlow id="F_Prak_19" sourceRef="Gw_Prak_MetodeNilai"
            targetRef="Task_Prak_NilaiManual" name="Manual" />
        <bpmn:sequenceFlow id="F_Prak_20" sourceRef="Gw_Prak_MetodeNilai"
            targetRef="Task_Prak_NilaiRubrik" name="Rubrik" />
        <bpmn:sequenceFlow id="F_Prak_21" sourceRef="Gw_Prak_MetodeNilai"
            targetRef="Task_Prak_ImportNilai" name="Import" />
        <bpmn:sequenceFlow id="F_Prak_22" sourceRef="Task_Prak_NilaiManual"
            targetRef="Gw_Prak_GabungNilai" />
        <bpmn:sequenceFlow id="F_Prak_23" sourceRef="Task_Prak_NilaiRubrik"
            targetRef="Gw_Prak_GabungNilai" />
        <bpmn:sequenceFlow id="F_Prak_24" sourceRef="Task_Prak_ImportNilai"
            targetRef="Gw_Prak_GabungNilai" />
        <bpmn:sequenceFlow id="F_Prak_25" sourceRef="Task_Prak_Absensi" targetRef="Gw_Prak_ParJoin" />
        <bpmn:sequenceFlow id="F_Prak_26" sourceRef="Gw_Prak_GabungNilai"
            targetRef="Gw_Prak_ParJoin" />

        <bpmn:sequenceFlow id="F_Prak_27" sourceRef="Gw_Prak_ParJoin" targetRef="Task_Prak_Final" />
        <bpmn:sequenceFlow id="F_Prak_28" sourceRef="Task_Prak_Final" targetRef="Gw_Prak_Sertifikat" />
        <bpmn:sequenceFlow id="F_Prak_29" sourceRef="Gw_Prak_Sertifikat"
            targetRef="Task_Prak_Sertifikat" name="Ya" />
        <bpmn:sequenceFlow id="F_Prak_30" sourceRef="Gw_Prak_Sertifikat"
            targetRef="Task_Prak_Export" name="Tidak" />
        <bpmn:sequenceFlow id="F_Prak_31" sourceRef="Task_Prak_Sertifikat"
            targetRef="Task_Prak_Export" />
        <bpmn:sequenceFlow id="F_Prak_32" sourceRef="Task_Prak_Export" targetRef="Task_Prak_Simpan" />
        <bpmn:sequenceFlow id="F_Prak_33" sourceRef="Task_Prak_Simpan" targetRef="Task_Prak_Unduh" />
        <bpmn:sequenceFlow id="F_Prak_34" sourceRef="Task_Prak_Unduh" targetRef="End_Prak" />
    </bpmn:process>

    <bpmndi:BPMNDiagram id="Diag_Praktikum">
        <bpmndi:BPMNPlane id="Plane_Praktikum" bpmnElement="Collab_Praktikum">
            <bpmndi:BPMNShape id="Sh_Part_Prak" bpmnElement="Participant_Praktikum"
                isHorizontal="true">
                <dc:Bounds x="80" y="60" width="5100" height="700" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Lane_Prak_Admin" bpmnElement="Lane_Prak_Admin"
                isHorizontal="true">
                <dc:Bounds x="110" y="60" width="5070" height="170" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Lane_Prak_Asisten" bpmnElement="Lane_Prak_Asisten"
                isHorizontal="true">
                <dc:Bounds x="110" y="230" width="5070" height="160" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Lane_Prak_Praktikan" bpmnElement="Lane_Prak_Praktikan"
                isHorizontal="true">
                <dc:Bounds x="110" y="390" width="5070" height="150" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Lane_Prak_Sistem" bpmnElement="Lane_Prak_Sistem"
                isHorizontal="true">
                <dc:Bounds x="110" y="540" width="5070" height="220" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Sh_Start_Prak" bpmnElement="Start_Prak">
                <dc:Bounds x="140" y="127" width="36" height="36" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Setup" bpmnElement="Task_Prak_Setup">
                <dc:Bounds x="230" y="110" width="200" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Assign" bpmnElement="Task_Prak_Assign">
                <dc:Bounds x="500" y="110" width="200" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Kelas" bpmnElement="Task_Prak_Kelas">
                <dc:Bounds x="770" y="110" width="200" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Prak_SubKelas" bpmnElement="Gw_Prak_SubKelas"
                isMarkerVisible="true">
                <dc:Bounds x="1040" y="120" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_SubKelas" bpmnElement="Task_Prak_SubKelas">
                <dc:Bounds x="1160" y="110" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Pertemuan" bpmnElement="Task_Prak_Pertemuan">
                <dc:Bounds x="1460" y="110" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Tugas" bpmnElement="Task_Prak_Tugas">
                <dc:Bounds x="1750" y="110" width="210" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Prak_AdaKumpul" bpmnElement="Gw_Prak_AdaKumpul"
                isMarkerVisible="true">
                <dc:Bounds x="2030" y="120" width="50" height="50" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Sh_Task_Prak_DownloadModul" bpmnElement="Task_Prak_DownloadModul">
                <dc:Bounds x="2160" y="425" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Kumpul" bpmnElement="Task_Prak_Kumpul">
                <dc:Bounds x="2450" y="425" width="190" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Prak_Lengkap" bpmnElement="Gw_Prak_Lengkap"
                isMarkerVisible="true">
                <dc:Bounds x="2710" y="435" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Perbaiki" bpmnElement="Task_Prak_Perbaiki">
                <dc:Bounds x="2820" y="425" width="240" height="70" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Sh_Gw_Prak_ParSplit" bpmnElement="Gw_Prak_ParSplit"
                isMarkerVisible="true">
                <dc:Bounds x="3100" y="625" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Absensi" bpmnElement="Task_Prak_Absensi">
                <dc:Bounds x="3220" y="245" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Prak_MetodeNilai" bpmnElement="Gw_Prak_MetodeNilai"
                isMarkerVisible="true">
                <dc:Bounds x="3220" y="325" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_NilaiManual" bpmnElement="Task_Prak_NilaiManual">
                <dc:Bounds x="3340" y="230" width="230" height="60" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_NilaiRubrik" bpmnElement="Task_Prak_NilaiRubrik">
                <dc:Bounds x="3340" y="300" width="230" height="60" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_ImportNilai" bpmnElement="Task_Prak_ImportNilai">
                <dc:Bounds x="3340" y="370" width="230" height="60" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Prak_GabungNilai" bpmnElement="Gw_Prak_GabungNilai"
                isMarkerVisible="true">
                <dc:Bounds x="3620" y="325" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Prak_ParJoin" bpmnElement="Gw_Prak_ParJoin"
                isMarkerVisible="true">
                <dc:Bounds x="3780" y="625" width="50" height="50" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Sh_Task_Prak_Final" bpmnElement="Task_Prak_Final">
                <dc:Bounds x="3920" y="615" width="210" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Prak_Sertifikat" bpmnElement="Gw_Prak_Sertifikat"
                isMarkerVisible="true">
                <dc:Bounds x="4180" y="625" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Sertifikat" bpmnElement="Task_Prak_Sertifikat">
                <dc:Bounds x="4310" y="275" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Export" bpmnElement="Task_Prak_Export">
                <dc:Bounds x="4310" y="110" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Simpan" bpmnElement="Task_Prak_Simpan">
                <dc:Bounds x="4310" y="615" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Prak_Unduh" bpmnElement="Task_Prak_Unduh">
                <dc:Bounds x="4630" y="425" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_End_Prak" bpmnElement="End_Prak">
                <dc:Bounds x="4952" y="442" width="36" height="36" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_DS_Prak_DB" bpmnElement="DS_Prak_DB">
                <dc:Bounds x="4880" y="640" width="50" height="50" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="Ed_F_Prak_01" bpmnElement="F_Prak_01">
                <di:waypoint x="176" y="145" />
                <di:waypoint x="230" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_02" bpmnElement="F_Prak_02">
                <di:waypoint x="430" y="145" />
                <di:waypoint x="500" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_03" bpmnElement="F_Prak_03">
                <di:waypoint x="700" y="145" />
                <di:waypoint x="770" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_04" bpmnElement="F_Prak_04">
                <di:waypoint x="970" y="145" />
                <di:waypoint x="1040" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_05" bpmnElement="F_Prak_05">
                <di:waypoint x="1090" y="145" />
                <di:waypoint x="1160" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_06" bpmnElement="F_Prak_06">
                <di:waypoint x="1065" y="170" />
                <di:waypoint x="1570" y="170" />
                <di:waypoint x="1570" y="180" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_07" bpmnElement="F_Prak_07">
                <di:waypoint x="1380" y="145" />
                <di:waypoint x="1460" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_08" bpmnElement="F_Prak_08">
                <di:waypoint x="1680" y="145" />
                <di:waypoint x="1750" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_09" bpmnElement="F_Prak_09">
                <di:waypoint x="1960" y="145" />
                <di:waypoint x="2030" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_10" bpmnElement="F_Prak_10">
                <di:waypoint x="2055" y="170" />
                <di:waypoint x="2270" y="170" />
                <di:waypoint x="2270" y="425" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_11" bpmnElement="F_Prak_11">
                <di:waypoint x="2030" y="145" />
                <di:waypoint x="1960" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_12" bpmnElement="F_Prak_12">
                <di:waypoint x="2380" y="460" />
                <di:waypoint x="2450" y="460" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_13" bpmnElement="F_Prak_13">
                <di:waypoint x="2640" y="460" />
                <di:waypoint x="2710" y="460" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_14" bpmnElement="F_Prak_14">
                <di:waypoint x="2760" y="460" />
                <di:waypoint x="3125" y="460" />
                <di:waypoint x="3125" y="625" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Prak_15" bpmnElement="F_Prak_15">
                <di:waypoint x="2760" y="460" />
