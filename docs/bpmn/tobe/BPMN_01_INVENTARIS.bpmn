                <di:waypoint x="2305" y="145" />
                <di:waypoint x="3040" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_17" bpmnElement="F_Inv_17">
                <di:waypoint x="2620" y="145" />
                <di:waypoint x="2750" y="145" />
                <di:waypoint x="2750" y="275" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_18" bpmnElement="F_Inv_18">
                <di:waypoint x="2860" y="310" />
                <di:waypoint x="2905" y="310" />
                <di:waypoint x="2905" y="170" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_19" bpmnElement="F_Inv_19">
                <di:waypoint x="2930" y="145" />
                <di:waypoint x="3040" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_20" bpmnElement="F_Inv_20">
                <di:waypoint x="2905" y="170" />
