                <di:waypoint x="3290" y="625" />
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Ed_F_Inv_22" bpmnElement="F_Inv_22">
                <di:waypoint x="3330" y="640" />
                <di:waypoint x="3400" y="610" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_23" bpmnElement="F_Inv_23">
                <di:waypoint x="3330" y="660" />
                <di:waypoint x="3400" y="700" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_24" bpmnElement="F_Inv_24">
                <di:waypoint x="3620" y="610" />
                <di:waypoint x="3685" y="640" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_25" bpmnElement="F_Inv_25">
                <di:waypoint x="3620" y="700" />
                <di:waypoint x="3685" y="660" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_26" bpmnElement="F_Inv_26">
                <di:waypoint x="3710" y="625" />
