<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_Inventaris_ToBe_v2" targetNamespace="http://silab.local/bpmn/inventaris-tobe-v2" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <collaboration id="Collab_Inventaris">
    <participant id="Pool_Inventaris" name="BPMN Inventaris Laboratorium (To-Be)" processRef="Process_Inventaris" />
  </collaboration>
  <process id="Process_Inventaris" isExecutable="false">
    <laneSet id="LaneSet_Inventaris">
      <lane id="Lane_Kadep" name="Kepala Departemen">
        <flowNodeRef>Task_AccKadep</flowNodeRef>
        <flowNodeRef>Gw_SetujuKadep</flowNodeRef>
      </lane>
      <lane id="Lane_Kalab" name="Kalab">
        <flowNodeRef>Task_ReviewKalab</flowNodeRef>
        <flowNodeRef>Gw_SetujuKalab</flowNodeRef>
        <flowNodeRef>Task_Pantau</flowNodeRef>
        <flowNodeRef>End_Inv</flowNodeRef>
      </lane>
      <lane id="Lane_Asisten" name="Asisten">
        <flowNodeRef>Task_Pengembalian</flowNodeRef>
        <flowNodeRef>Start_Inv</flowNodeRef>
        <flowNodeRef>Task_BuatDraft</flowNodeRef>
        <flowNodeRef>Task_SubmitPermohonan</flowNodeRef>
        <flowNodeRef>Task_Revisi</flowNodeRef>
      </lane>
      <lane id="Lane_Admin" name="Admin">
        <flowNodeRef>Task_KonversiAset</flowNodeRef>
        <flowNodeRef>Gw_AdaPeminjaman</flowNodeRef>
        <flowNodeRef>Task_KelolaPeminjaman</flowNodeRef>
        <flowNodeRef>Task_CatatKondisi</flowNodeRef>
        <flowNodeRef>Task_Export</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_ReviewKalab" name="Mereview permohonan per item">
      <incoming>F_04</incoming>
      <outgoing>Flow_1e5h1qf</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0wzlvjs">
        <targetRef>DB_Inventaris</targetRef>
      </dataOutputAssociation>
    </task>
    <exclusiveGateway id="Gw_SetujuKalab" name="Permohonan Di setujui?">
      <incoming>Flow_1e5h1qf</incoming>
      <outgoing>F_06_ya</outgoing>
      <outgoing>F_06_tidak</outgoing>
    </exclusiveGateway>
    <task id="Task_AccKadep" name="Memberikan ACC final pengadaan">
      <incoming>F_06_ya</incoming>
      <outgoing>Flow_0u8dc2f</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_084iq79">
        <targetRef>DB_Inventaris</targetRef>
      </dataOutputAssociation>
    </task>
    <exclusiveGateway id="Gw_SetujuKadep" name="Kadep setuju?">
      <incoming>Flow_0u8dc2f</incoming>
      <outgoing>F_08_ya</outgoing>
      <outgoing>F_08_tidak</outgoing>
    </exclusiveGateway>
    <task id="Task_KonversiAset" name="Mendaftarkan aset dari whistlist">
      <incoming>F_08_ya</incoming>
      <outgoing>F_09</outgoing>
      <dataOutputAssociation id="DataOut_KonversiAset">
        <targetRef>DB_Inventaris</targetRef>
      </dataOutputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_1hucmi8">
        <targetRef>DB_Inventaris</targetRef>
      </dataOutputAssociation>
    </task>
    <exclusiveGateway id="Gw_AdaPeminjaman" name="Ada permintaan peminjaman?">
      <incoming>F_09</incoming>
      <outgoing>F_12_ya</outgoing>
      <outgoing>F_12_tidak</outgoing>
    </exclusiveGateway>
    <task id="Task_KelolaPeminjaman" name="Mencatat peminjaman aset">
      <incoming>F_12_ya</incoming>
      <outgoing>F_13</outgoing>
      <dataOutputAssociation id="DataOut_Peminjaman">
        <targetRef>DB_Inventaris</targetRef>
      </dataOutputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_087czb1">
        <targetRef>DB_Inventaris</targetRef>
      </dataOutputAssociation>
    </task>
    <task id="Task_Pengembalian" name="Mencatat pengembalian aset">
      <incoming>F_13</incoming>
      <outgoing>F_14</outgoing>
    </task>
    <task id="Task_CatatKondisi" name="Mencatat riwayat kondisi aset">
      <incoming>F_14</incoming>
      <outgoing>F_15</outgoing>
    </task>
    <task id="Task_Export" name="Mengekspor laporan inventaris">
      <incoming>F_12_tidak</incoming>
      <incoming>F_15</incoming>
      <outgoing>F_16</outgoing>
      <property id="Prop_Export" name="__targetRef_placeholder" />
      <dataInputAssociation id="DataIn_Export">
        <sourceRef>DB_Inventaris</sourceRef>
        <targetRef>Prop_Export</targetRef>
      </dataInputAssociation>
      <dataInputAssociation id="DataInputAssociation_0eb5wnk">
        <sourceRef>DB_Inventaris</sourceRef>
        <targetRef>Prop_Export</targetRef>
      </dataInputAssociation>
    </task>
    <task id="Task_Pantau" name="Memantau ringkasan inventaris">
      <incoming>F_16</incoming>
      <outgoing>F_17</outgoing>
    </task>
    <startEvent id="Start_Inv" name="Siklus inventaris dimulai">
      <outgoing>Flow_0mxfsit</outgoing>
    </startEvent>
    <task id="Task_BuatDraft" name="Membuat draft permohonan aset (wishlist)">
      <incoming>Flow_0mxfsit</incoming>
      <outgoing>F_03</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_0jawpia">
        <targetRef>DB_Inventaris</targetRef>
      </dataOutputAssociation>
    </task>
    <task id="Task_SubmitPermohonan" name="Mengajukan permohonan ke Kalab">
      <incoming>F_03</incoming>
      <incoming>F_Revisi</incoming>
      <outgoing>F_04</outgoing>
    </task>
    <task id="Task_Revisi" name="Merevisi permohonan (asisten)">
      <incoming>F_06_tidak</incoming>
      <outgoing>F_Revisi</outgoing>
    </task>
    <dataStoreReference id="DB_Inventaris" name="Database Inventaris" />
    <endEvent id="End_Inv" name="Siklus inventaris selesai">
      <incoming>F_17</incoming>
      <incoming>F_08_tidak</incoming>
    </endEvent>
    <sequenceFlow id="F_04" sourceRef="Task_SubmitPermohonan" targetRef="Task_ReviewKalab" />
    <sequenceFlow id="Flow_1e5h1qf" sourceRef="Task_ReviewKalab" targetRef="Gw_SetujuKalab" />
    <sequenceFlow id="F_06_ya" name="Ya" sourceRef="Gw_SetujuKalab" targetRef="Task_AccKadep" />
    <sequenceFlow id="F_06_tidak" name="Tidak" sourceRef="Gw_SetujuKalab" targetRef="Task_Revisi" />
    <sequenceFlow id="Flow_0u8dc2f" sourceRef="Task_AccKadep" targetRef="Gw_SetujuKadep" />
    <sequenceFlow id="F_08_ya" name="Ya (ACC)" sourceRef="Gw_SetujuKadep" targetRef="Task_KonversiAset" />
    <sequenceFlow id="F_08_tidak" name="Tidak" sourceRef="Gw_SetujuKadep" targetRef="End_Inv" />
    <sequenceFlow id="F_09" sourceRef="Task_KonversiAset" targetRef="Gw_AdaPeminjaman" />
    <sequenceFlow id="F_12_ya" name="Ya" sourceRef="Gw_AdaPeminjaman" targetRef="Task_KelolaPeminjaman" />
    <sequenceFlow id="F_12_tidak" name="Tidak" sourceRef="Gw_AdaPeminjaman" targetRef="Task_Export" />
    <sequenceFlow id="F_13" sourceRef="Task_KelolaPeminjaman" targetRef="Task_Pengembalian" />
    <sequenceFlow id="F_14" sourceRef="Task_Pengembalian" targetRef="Task_CatatKondisi" />
    <sequenceFlow id="F_15" sourceRef="Task_CatatKondisi" targetRef="Task_Export" />
    <sequenceFlow id="F_16" sourceRef="Task_Export" targetRef="Task_Pantau" />
    <sequenceFlow id="F_17" sourceRef="Task_Pantau" targetRef="End_Inv" />
    <sequenceFlow id="Flow_0mxfsit" sourceRef="Start_Inv" targetRef="Task_BuatDraft" />
    <sequenceFlow id="F_03" sourceRef="Task_BuatDraft" targetRef="Task_SubmitPermohonan" />
    <sequenceFlow id="F_Revisi" sourceRef="Task_Revisi" targetRef="Task_SubmitPermohonan" />
  </process>
