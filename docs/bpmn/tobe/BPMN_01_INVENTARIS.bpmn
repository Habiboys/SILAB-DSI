            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Inv_Setuju" bpmnElement="Gw_Inv_Setuju"
                isMarkerVisible="true">
                <dc:Bounds x="1080" y="625" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_Revisi" bpmnElement="Task_Inv_Revisi">
                <dc:Bounds x="1220" y="275" width="200" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_ProsesPengadaan"
                bpmnElement="Task_Inv_ProsesPengadaan">
                <dc:Bounds x="1220" y="110" width="220" height="70" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Sh_Task_Inv_RegistrasiAset" bpmnElement="Task_Inv_RegistrasiAset">
                <dc:Bounds x="1520" y="110" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_GenerateLabel" bpmnElement="Task_Inv_GenerateLabel">
                <dc:Bounds x="1810" y="110" width="210" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Inv_AdaPeminjaman" bpmnElement="Gw_Inv_AdaPeminjaman"
                isMarkerVisible="true">
                <dc:Bounds x="2100" y="120" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Inv_AsetTersedia" bpmnElement="Gw_Inv_AsetTersedia"
                isMarkerVisible="true">
                <dc:Bounds x="2280" y="120" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_KelolaPeminjaman"
                bpmnElement="Task_Inv_KelolaPeminjaman">
                <dc:Bounds x="2400" y="110" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_Pengembalian" bpmnElement="Task_Inv_Pengembalian">
                <dc:Bounds x="2640" y="275" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Inv_KondisiBerubah" bpmnElement="Gw_Inv_KondisiBerubah"
                isMarkerVisible="true">
                <dc:Bounds x="2880" y="120" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_CatatKondisi" bpmnElement="Task_Inv_CatatKondisi">
                <dc:Bounds x="3040" y="110" width="220" height="70" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Sh_Gw_Inv_ParSplit" bpmnElement="Gw_Inv_ParSplit"
                isMarkerVisible="true">
                <dc:Bounds x="3280" y="625" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_UpdateStatus" bpmnElement="Task_Inv_UpdateStatus">
                <dc:Bounds x="3400" y="575" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_SimpanRiwayat" bpmnElement="Task_Inv_SimpanRiwayat">
                <dc:Bounds x="3400" y="665" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Gw_Inv_ParJoin" bpmnElement="Gw_Inv_ParJoin"
                isMarkerVisible="true">
                <dc:Bounds x="3660" y="625" width="50" height="50" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Sh_Task_Inv_Pantau" bpmnElement="Task_Inv_Pantau">
                <dc:Bounds x="3820" y="425" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_Task_Inv_Export" bpmnElement="Task_Inv_Export">
                <dc:Bounds x="4040" y="110" width="220" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_End_Inv" bpmnElement="End_Inv">
                <dc:Bounds x="4282" y="642" width="36" height="36" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Sh_DS_Inv_DB" bpmnElement="DS_Inv_DB">
                <dc:Bounds x="4140" y="700" width="50" height="50" />
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="Ed_F_Inv_01" bpmnElement="F_Inv_01">
                <di:waypoint x="176" y="145" />
                <di:waypoint x="240" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_02" bpmnElement="F_Inv_02">
                <di:waypoint x="440" y="145" />
                <di:waypoint x="520" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_03" bpmnElement="F_Inv_03">
                <di:waypoint x="545" y="170" />
                <di:waypoint x="745" y="170" />
                <di:waypoint x="745" y="275" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_04" bpmnElement="F_Inv_04">
                <di:waypoint x="570" y="145" />
                <di:waypoint x="1630" y="145" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_05" bpmnElement="F_Inv_05">
                <di:waypoint x="850" y="310" />
                <di:waypoint x="965" y="310" />
                <di:waypoint x="965" y="425" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_06" bpmnElement="F_Inv_06">
                <di:waypoint x="1070" y="460" />
                <di:waypoint x="1105" y="460" />
                <di:waypoint x="1105" y="625" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_07" bpmnElement="F_Inv_07">
                <di:waypoint x="1130" y="625" />
                <di:waypoint x="1330" y="625" />
                <di:waypoint x="1330" y="180" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_08" bpmnElement="F_Inv_08">
                <di:waypoint x="1130" y="650" />
                <di:waypoint x="1320" y="650" />
                <di:waypoint x="1320" y="345" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_09" bpmnElement="F_Inv_09">
                <di:waypoint x="1420" y="310" />
                <di:waypoint x="745" y="310" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Ed_F_Inv_10" bpmnElement="F_Inv_10">
                <di:waypoint x="1440" y="145" />
                <di:waypoint x="1520" y="145" />
            </bpmndi:BPMNEdge>

            <bpmndi:BPMNEdge id="Ed_F_Inv_11" bpmnElement="F_Inv_11">
                <di:waypoint x="1740" y="145" />
