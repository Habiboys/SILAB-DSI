@startuml BPMN_04_KEGIATAN_PROKER
!theme plain
title BPMN - Modul Kegiatan & Program Kerja (v2 - Updated Feb 2026)

|#45b7d1| Koordinator / Admin |
|#95e1d3| Asisten / PJ Proker |
|#a29bfe| Approver\n(Kadep / Superadmin) |
|#f9ca24| Approver Kegiatan\n(Dosen / Kadep / Admin) |
|#dfe6e9| Sistem |

' ╔══════════════════════════════════════════════════════════╗
' ║           ALUR A: PROGRAM KERJA (PROKER)                 ║
' ╚══════════════════════════════════════════════════════════╝
|Koordinator / Admin|
start

partition "A. Buat & Ajukan Program Kerja" {

  :Buat Program Kerja Baru
  (nama_proker, deskripsi, tujuan,
   sasaran, output_kegiatan,
   tanggal_mulai, tanggal_selesai,
   struktur / divisi);

  |Sistem|
  :Simpan Proker
  status: belum_mulai
  status_pengajuan: **draft**;

  |Koordinator / Admin|
  note right
    Upload file_proker (opsional)
    di halaman detail proker
  end note

  :Tambah Parameter Penilaian
  (nama_parameter + bobot %,
   total bobot harus = 100%);

  |Sistem|
  :Validasi total bobot ≤ 100%;

  |Koordinator / Admin|
  :Tentukan Penanggung Jawab (PJ)
  dari anggota divisi;

  :Klik "Ajukan" → kirim ke approver;

  |Sistem|
  :Update status_pengajuan
  draft → **diajukan**;
}

partition "B. Approval Program Kerja" {

  |Approver\n(Kadep / Superadmin)|
  :Review proker yang diajukan;

  if (Keputusan?) then (Disetujui)
    :Approve Proker;
    |Sistem|
    :Update status_pengajuan → **disetujui**
    Update status → belum_mulai;

    ' === PELAKSANAAN PROKER ===
    partition "C. Pelaksanaan & Monitoring" {

      |Koordinator / Admin|
      :Update Status Pelaksanaan
      (belum_mulai → sedang_berjalan
       → selesai / ditunda);

      |Asisten / PJ Proker|
      :Upload Dokumentasi Proker
      (foto, laporan berkala,
       file pendukung lainnya);

      |Sistem|
      :Simpan ProkerDokumentasi
      (judul + file_path + uploaded_by);
    }

    ' === LPJ / EVALUASI ===
    partition "D. LPJ & Evaluasi Akhir" {

      |Asisten / PJ Proker|
      :Isi Capaian per Parameter
      (capaian % 0–100);

      |Sistem|
      :Hitung persentase_capaian tertimbang
      Σ(bobot × capaian) / 100;

      |Asisten / PJ Proker|
      :Isi Evaluasi Proker
      (kendala, solusi, saran);

      |Sistem|
      :Simpan evaluasi
      Update status → **selesai**;
    }

  else (Ditolak)
    :Tolak Proker + catatan;
    |Sistem|
    :Update status_pengajuan → **ditolak**
    Append catatan ke keterangan;

    |Koordinator / Admin|
    :Revisi Proker
    (edit lalu ajukan ulang);
    note right
      Kembali ke alur Ajukan
    end note
  endif
}

' ╔══════════════════════════════════════════════════════════╗
' ║          ALUR B: KEGIATAN                                ║
' ╚══════════════════════════════════════════════════════════╝
partition "E. Pengajuan Kegiatan" {

  fork
    |Koordinator / Admin|
    :Buat Kegiatan Baru;
  fork again
    |Asisten / PJ Proker|
    :Buat Kegiatan Baru;
  end fork

  :Input Detail Kegiatan
  (nama_kegiatan, proker_id,
   tipe_kegiatan, lokasi / link_meeting,
   tanggal_mulai, tanggal_selesai);

  |Sistem|
  :Validasi lab context proker;

  :Simpan Kegiatan
  status_approval: **diajukan**;

  |Approver Kegiatan\n(Dosen / Kadep / Admin)|
  :Review kegiatan yang diajukan;

  if (Keputusan?) then (Disetujui)
    :Approve Kegiatan;
    |Sistem|
    :Update status_approval → **disetujui**
    Simpan approved_by + approved_at;

    ' === PELAKSANAAN KEGIATAN ===
    partition "F. Pelaksanaan Kegiatan" {

      fork
        |Koordinator / Admin|
        :Kelola Peserta & Panitia
        (tambah user, set peran:
         peserta / panitia);
      fork again
        |Asisten / PJ Proker|
        :Daftar sebagai peserta / panitia;
      end fork

      |Sistem|
      :Simpan KegiatanPeserta
      (kegiatan_id, user_id, peran, is_lulus);

      fork
        |Koordinator / Admin|
        :Upload Dokumentasi Kegiatan
        (foto, video, berkas);
      fork again
        |Asisten / PJ Proker|
        :Upload Dokumentasi Kegiatan;
      end fork

      |Sistem|
      :Simpan DokumentasiKegiatan
      (judul + file_path + uploaded_by);
    }

    ' === LAPORAN & SERTIFIKAT ===
    partition "G. Laporan & Sertifikat Kegiatan" {

      fork
        |Koordinator / Admin|
        :Upload Laporan Kegiatan (LPJ)
        (jenis_laporan, periode,
         deskripsi_capaian, file_lpj);
      fork again
        |Asisten / PJ Proker|
        :Upload LPJ Kegiatan;
      end fork

      |Sistem|
      :Simpan LaporanKegiatan;

      |Koordinator / Admin|
      if (Perlu Sertifikat?) then (Ya)

        :Upload Template Sertifikat (.docx);

        |Sistem|
        :Simpan SertifikatTemplate
        (kategori: kegiatan, ref_id);

        |Koordinator / Admin|
        :Pilih penerima sertifikat
        (semua / pilihan user_id[]);

        :Klik "Generate Sertifikat";

        |Sistem|
        :Loop setiap peserta:
         - Generate nomor: SRT-YYYY-KGT-NNN
         - Replace placeholder pada template
         - Simpan file .docx
         - Update KegiatanPeserta.no_sertifikat
         - Insert Sertifikat record;

        :Return "{n} sertifikat berhasil digenerate";

      else (Tidak)
        :Selesai tanpa sertifikat;
      endif
    }

  else (Ditolak)
    :Tolak Kegiatan;
    |Sistem|
    :Update status_approval → **ditolak**;

    |Asisten / PJ Proker|
    :Perbaiki & ajukan ulang;
  endif
}

' === KALENDER KEGIATAN ===
partition "H. Kalender Kegiatan" {
  |Koordinator / Admin|
  :Akses Halaman Kalender;

  |Sistem|
  :Ambil semua kegiatan
  status: diajukan + disetujui;
  :Render event di kalender
  (warna kuning = diajukan,
   biru = disetujui);
}

stop

@enduml
