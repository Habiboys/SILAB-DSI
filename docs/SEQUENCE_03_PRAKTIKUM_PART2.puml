@startuml SEQUENCE_03_PRAKTIKUM_PART2
scale 0.7
!theme plain
title Sequence Diagram - Modul Praktikum (Part 2: Praktikan & Pertemuan)

' ============================================
' 7. TAMBAH PRAKTIKAN MANUAL
' ============================================
== 7. Tambah Praktikan Manual ==
actor Admin
participant "Browser" as Browser
participant "Praktikan\nController" as Controller
participant "User\nModel" as User
participant "Praktikan\nModel" as Praktikan
database "Database" as DB

Admin -> Browser: Klik "Tambah Praktikan"
Browser -> Admin: Tampilkan form search user
Admin -> Browser: Cari user by NIM/email
Browser -> Controller: GET /users/search?q=...
Controller -> User: where('nim', 'LIKE', '%q%')->get()
User -> DB: SELECT * WHERE nim LIKE ?
DB --> User: Users
User --> Controller: Collection
Controller --> Browser: List users hasil search
Browser --> Admin: Tampilkan hasil

Admin -> Browser: Pilih user + set kelas
Browser -> Controller: POST /praktikum/{id}/praktikan
activate Controller
Controller -> Controller: Check permission:\npraktikan.create\n+ active.kepengurusan
Controller -> Controller: Validate:\n- user_id exists\n- not already registered
alt User sudah terdaftar
    Controller --> Browser: Error: User sudah\nterdaftar di praktikum ini
else Not registered
    Controller -> Praktikan: create([\n  user_id,\n  praktikum_id,\n  kelas,\n  tahun_ajaran: current\n])
    Praktikan -> DB: INSERT INTO praktikan
    Controller --> Browser: Success
    Browser --> Admin: Praktikan berhasil ditambah
end
deactivate Controller

' ============================================
' 8. EDIT DATA PRAKTIKAN
' ============================================
== 8. Edit Data Praktikan ==
Admin -> Browser: Klik "Edit" pada praktikan
Browser -> Controller: GET /praktikan/{id}/edit
Controller -> Praktikan: find(id)
Praktikan -> DB: SELECT *
DB --> Praktikan: Record
Controller --> Browser: Render form
Browser --> Admin: Tampilkan form

Admin -> Browser: Update kelas
Browser -> Controller: PUT /praktikan/{id}
activate Controller
Controller -> Controller: Check permission:\npraktikan.update\n+ active.kepengurusan
Controller -> Praktikan: update(id, {kelas})
Praktikan -> DB: UPDATE praktikan\nSET kelas = ?
Controller --> Browser: Success
deactivate Controller

' ============================================
' 9. ASSIGN KELAS
' ============================================
== 9. Assign Kelas (Bulk) ==
Admin -> Browser: Select multiple praktikan
Admin -> Browser: Pilih kelas baru
Browser -> Controller: POST /praktikan/bulk-assign-kelas
activate Controller
Controller -> Controller: Check permission\n+ active.kepengurusan
Controller -> Controller: Validate:\n- praktikan_ids array\n- kelas required
loop For each praktikan_id
    Controller -> Praktikan: update(id, {kelas})
    Praktikan -> DB: UPDATE kelas
end
Controller --> Browser: Success:\n"{count} praktikan updated"
deactivate Controller

' ============================================
' 10. BUAT PERTEMUAN
' ============================================
== 10. Buat Pertemuan ==
Admin -> Browser: Klik "Buat Pertemuan"
Browser -> Admin: Form:\n- Pertemuan ke-\n- Judul\n- Tanggal
Admin -> Browser: Submit
Browser -> Controller: POST /praktikum/{id}/pertemuan
activate Controller
Controller -> Controller: Check permission:\npraktikum.create\n+ active.kepengurusan
participant "PertemuanPraktikum\nModel" as Pertemuan
Controller -> Pertemuan: create([\n  praktikum_id,\n  pertemuan_ke,\n  judul, tanggal\n])
Pertemuan -> DB: INSERT INTO pertemuan_praktikum
DB --> Pertemuan: pertemuan_id
Pertemuan --> Controller: Instance

note right of Controller: Auto-create absensi records\nuntuk semua praktikan
participant "Absensi\nModel" as Absensi
Controller -> Praktikan: where(praktikum_id, id)->get()
Praktikan -> DB: SELECT * FROM praktikan
DB --> Praktikan: All praktikans
loop For each praktikan
    Controller -> Absensi: create([\n  praktikan_id,\n  pertemuan_praktikum_id,\n  status: null (belum diisi)\n])
    Absensi -> DB: INSERT INTO absensi
end

Controller --> Browser: Success
Browser --> Admin: Pertemuan berhasil dibuat
deactivate Controller

' ============================================
' 11. INPUT ABSENSI
' ============================================
== 11. Input Absensi (Admin/Asisten) ==
actor Asisten
Asisten -> Browser: Akses pertemuan
Browser -> Controller: GET /pertemuan/{id}/absensi
Controller -> Pertemuan: with('absensi.praktikan.user')-> find(id)
Pertemuan -> DB: SELECT pertemuan.*, absensi.*,\npraktikan.*, users.*
DB --> Pertemuan: Data complete
Controller --> Browser: Render absensi form
Browser --> Asisten: List praktikan dengan:\n☐ Hadir ☐ Izin ☐ Sakit ☐ Alpha

Asisten -> Browser: Isi absensi untuk semua praktikan
Browser -> Controller: POST /pertemuan/{id}/absensi
activate Controller
Controller -> Controller: Check permission:\nabsensi.create
Controller -> Controller: Validate:\n- absensi array[praktikan_id => status]
loop For each praktikan
    Controller -> Absensi: updateOrCreate(\n  [praktikan_id, pertemuan_id],\n  {status: input_status}\n)
    Absensi -> DB: INSERT/UPDATE absensi
end
Controller --> Browser: Success
Browser --> Asisten: Absensi berhasil disimpan
deactivate Controller

' ============================================
' 12. BUAT TUGAS
' ============================================
== 12. Buat Tugas ==
Asisten -> Browser: Klik "Buat Tugas"
Browser -> Admin: Form:\n- Judul\n- Deskripsi\n- Deadline
Asisten -> Browser: Submit
Browser -> Controller: POST /praktikum/{id}/tugas
activate Controller
Controller -> Controller: Check permission:\ntugas.create\n+ active.kepengurusan
participant "TugasPraktikum\nModel" as Tugas
Controller -> Tugas: create([\n  praktikum_id,\n  judul, deskripsi,\n  deadline\n])
Tugas -> DB: INSERT INTO tugas_praktikum
DB --> Tugas: tugas_id

opt Kirim Notifikasi ke Praktikan
    Controller -> Controller: Send notification\nto all praktikan in praktikum
    participant "Notification\nService" as Notif
    Controller -> Notif: sendTugasCreated(\n  praktikan_ids,\n  tugas_data\n)
end

Controller --> Browser: Success
deactivate Controller

' ============================================
' 13. SUBMIT TUGAS (Praktikan)
' ============================================
== 13. Submit Tugas ==
actor Praktikan
Praktikan -> Browser: Akses detail tugas
Browser -> Controller: GET /tugas/{id}
Controller -> Tugas: find(id)
Controller --> Browser: Render detail tugas
Browser --> Praktikan: Show:\n- Deskripsi\n- Deadline\n- Status pengumpulan

Praktikan -> Browser: Upload file jawaban
Browser -> Controller: POST /tugas/{id}/submit
activate Controller
Controller -> Controller: Check auth:sanctum
Controller -> Controller: Check permission:\ntugas.submit
Controller -> Controller: Check user is praktikan\nof this praktikum
alt Not registered
    Controller --> Browser: Error 403:\nAnda bukan praktikan di\npraktikum ini
else Is praktikan
    Controller -> Controller: Validate:\n- file required|max:5MB\n- deadline not passed
    alt Deadline passed
        Controller --> Browser: Error: Deadline sudah lewat
    else Before deadline
        Controller -> Controller: Store file to storage
        participant "PengumpulanTugas\nModel" as Pengumpulan
        Controller -> Pengumpulan: updateOrCreate(\n  [tugas_id, praktikan_id],\n  {\n    file_path,\n    keterangan,\n    status: 'pending',\n    submitted_at: now()\n  }\n)
        Pengumpulan -> DB: INSERT/UPDATE\npengumpulan_tugas
        Controller --> Browser: Success
        Browser --> Praktikan: Tugas berhasil dikumpulkan
    end
end
deactivate Controller

@enduml
