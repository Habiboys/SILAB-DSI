@startuml ACT_02_MENGELOLA_JADWAL_PIKET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-02 - Mengelola Jadwal Piket

|SuperAdmin / Admin|
|System|

|SuperAdmin / Admin|
start
:Buka menu Jadwal Piket;
|System|
:Query & Tampilkan jadwal piket;
|SuperAdmin / Admin|
:Lihat jadwal piket;

if (Aksi?) then (Assign)
  :Tekan tombol Assign;
  |System|
  :Tampilkan Form Jadwal;
  |SuperAdmin / Admin|
  :Pilih anggota + hari + periode piket;

elseif (Aksi?) then (Hapus)
  :Pilih jadwal, klik Hapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |SuperAdmin / Admin|
  :Konfirmasi penghapusan;

else (Generate)
  :Pilih periode + anggota + aturan rotasi;
  |System|
  :Generate jadwal otomatis\n(distribusi merata per hari);
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |SuperAdmin / Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
