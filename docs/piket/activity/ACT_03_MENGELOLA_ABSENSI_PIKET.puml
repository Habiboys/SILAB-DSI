@startuml ACT_03_MENGELOLA_ABSENSI_PIKET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-03 - Mengambil Absen Piket

|Asisten|
|System|

|Asisten|
start
:Buka menu Absensi Piket;
|System|
:Query & Tampilkan daftar absensi piket;
|Asisten|
:Lihat daftar absensi piket;
:Pilih aksi;

if (Aksi?) then (Check-in)
  |Asisten|
  repeat
    :Ambil foto + isi kegiatan;
    |System|
    :Validasi jadwal & cek duplikat;
    |Asisten|
  repeat while (Valid?) is (tidak) not (ya)

  |System|
  :Simpan check-in;
  :Tampilkan pesan sukses;
  |Asisten|
  :Check-in berhasil tercatat;

elseif (Aksi?) then (Check-out)
  |Asisten|
  repeat
    :Ambil foto checkout + konfirmasi;
    |System|
    :Cek absensi & validasi durasi;
    |Asisten|
  repeat while (Valid?) is (tidak) not (ya)

  |System|
  :Simpan check-out;
  :Tampilkan pesan sukses;
  |Asisten|
  :Check-out berhasil tercatat;

else (Tidak Hadir / Izin)
  |Asisten|
  repeat
    :Pilih anggota + tanggal + isi alasan;
    |System|
    :Validasi data;
    |Asisten|
  repeat while (Valid?) is (tidak) not (ya)

  |System|
  :Simpan status tidak hadir / izin;
  :Tampilkan pesan sukses;
  |Asisten|
  :Status absensi berhasil dicatat;

endif

stop
@enduml
