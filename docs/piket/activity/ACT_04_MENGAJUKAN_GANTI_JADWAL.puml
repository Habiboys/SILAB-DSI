@startuml ACT_04_MENGAJUKAN_GANTI_JADWAL
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-04 - Mengajukan Ganti Jadwal Piket

|Asisten|
|System|

|Asisten|
start
:Buka menu Ganti Jadwal Piket;
:Klik "Ajukan Ganti Jadwal";

repeat
  :Isi form permintaan ganti;
  |System|
  :Periksa input;
  if (Form valid?) then (tidak)
    :Tampilkan pesan kesalahan;
    |Asisten|
    :Perbaiki form;
  endif
repeat while (Form valid?) is (tidak) not (ya)
:Simpan data baru;
:Kirim notifikasi ke Admin;
:Tampilkan notifikasi sukses;
|Asisten|
:Permintaan ganti jadwal terkirim;
:Tunggu persetujuan Admin;

stop
@enduml
