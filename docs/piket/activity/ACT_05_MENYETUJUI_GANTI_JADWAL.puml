@startuml ACT_05_MENYETUJUI_GANTI_JADWAL
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-05 - Menyetujui / Menolak Ganti Jadwal Piket

|SuperAdmin / Admin|
|System|

|SuperAdmin / Admin|
start
:Buka menu Ganti Jadwal Piket\n(filter: status pending);

|System|
:Ambil data permintaan ganti jadwal;
:Tampilkan daftar permintaan\nganti jadwal;

|SuperAdmin / Admin|
:Pilih permintaan, baca detail\n(siapa, jadwal lama, alasan,\ntanggal pengganti);
:Ambil keputusan;

if (Keputusan?) then (Setuju)
  |SuperAdmin / Admin|
  :Klik Setujui\n;
  |System|
  :Perbarui data;
  :Kirim notifikasi ke Asisten;
  :Tampilkan notifikasi sukses;
  |SuperAdmin / Admin|
  :Permintaan ganti jadwal disetujui;

else (Tolak)
  |SuperAdmin / Admin|
  repeat
    :Klik Tolak, isi alasan penolakan;
    |System|
    :Periksa alasan tidak kosong;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |SuperAdmin / Admin|
      :Isi alasan;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Perbarui data;
  :Kirim notifikasi ke Asisten;
  :Tampilkan notifikasi sukses;
  |SuperAdmin / Admin|
  :Permintaan ditolak;

endif

stop
@enduml
