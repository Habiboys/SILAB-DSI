@startuml ACT_01_MENGELOLA_PERIODE_PIKET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-01 - Mengelola Periode Piket\nAktor: Admin

|Admin|
|System|

|Admin|
start
:Buka menu Periode Piket;
|System|
:Query & Tampilkan daftar periode piket;
|Admin|
:Lihat daftar periode piket;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Periode;
  |Admin|
  :Isi form periode\n(nama, tgl mulai, tgl selesai,\nstatus aktif, kepengurusan lab);

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih periode yang diubah;
  |System|
  :Tampilkan Form Edit Periode;
  |Admin|
  :Ubah data periode;

else (Hapus)
  :Klik Hapus, konfirmasi;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
  |Admin|
endif

stop
@enduml
