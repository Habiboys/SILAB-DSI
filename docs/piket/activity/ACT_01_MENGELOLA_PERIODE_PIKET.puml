@startuml ACT_01_MENGELOLA_PERIODE_PIKET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200

skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-01 ? Mengelola Periode Piket\nAktor: Admin

|Admin|
|System|

|Admin|
start
:Buka menu Periode Piket;
:Pilih aksi;

if (Aksi?) then (Lihat Daftar Periode)
  |System|
  :Ambil data kepengurusan lab aktif;
  :Ambil data periode piket;
  :Tampilkan daftar periode\n+ status aktif;
  |Admin|
  :Lihat daftar periode piket;

elseif (Aksi?) then (Tambah Periode)
  |Admin|
  :Isi form periode\n(nama, tgl mulai, tgl selesai,\nstatus aktif, kepengurusan lab);
  |System|
  :Periksa input\n(tanggal valid, tidak overlap);
  if (Form valid?) then (tidak)
    :Tampilkan pesan error\n(overlap / tanggal tidak valid);
    |Admin|
    :Perbaiki form;
  else (ya)
    if (Tandai aktif?) then (ya)
      :Nonaktifkan periode aktif lainnya;
    endif
    :Simpan data baru;
    :Tampilkan notifikasi sukses;
    |Admin|
    :Periode baru muncul di daftar;
  endif

elseif (Aksi?) then (Edit Periode / Toggle Aktif)
  |Admin|
  :Klik Edit atau toggle switch aktif;
  |System|
  :Periksa input\n(tanggal tidak overlap dengan lainnya);
  if (Form valid?) then (tidak)
    :Tampilkan pesan kesalahan;
  else (ya)
    if (Diaktifkan?) then (ya)
      :Nonaktifkan periode aktif lainnya;
    endif
    :Perbarui data;
    :Tampilkan notifikasi sukses;
    |Admin|
    :Periode diperbarui;
  endif

elseif (Aksi?) then (Hapus Periode)
  |Admin|
  :Klik Hapus ? konfirmasi;
  |System|
  :Cek apakah ada jadwal\nterkait periode ini;
  if (Ada jadwal terkait?) then (ya)
    :Tampilkan peringatan;
    |Admin|
    :Hapus jadwal dulu;
  else (tidak)
    :Hapus data;
    :Tampilkan notifikasi sukses;
    |Admin|
    :Periode terhapus dari daftar;
  endif

endif

stop
@enduml
