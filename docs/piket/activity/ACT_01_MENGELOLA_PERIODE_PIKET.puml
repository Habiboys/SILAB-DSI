@startuml ACT_01_MENGELOLA_PERIODE_PIKET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-01 - Mengelola Periode Piket

|SuperAdmin / Admin|
|System|

|SuperAdmin / Admin|
start
:Buka menu Periode Piket;
|System|
:Query & Tampilkan daftar periode piket;
|SuperAdmin / Admin|
:Lihat daftar periode piket;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Periode;
  |SuperAdmin / Admin|
  :Isi form periode;

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih periode yang diubah;
  |System|
  :Tampilkan Form Edit Periode;
  |SuperAdmin / Admin|
  :Ubah data periode;

else (Hapus)
  :Klik Hapus, konfirmasi;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |SuperAdmin / Admin|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |SuperAdmin / Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
