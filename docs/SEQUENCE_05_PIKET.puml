@startuml SEQUENCE_05_PIKET
scale 0.7
!theme plain
title Sequence Diagram - Modul Piket

actor "Admin/Kadep" as AD
actor "Asisten" as AS
boundary "Browser" as UI
control "PeriodePiketController" as PPC
control "JadwalPiketController" as JPC
control "GantiJadwalPiketController" as GJC
entity "PeriodePiket" as PP
entity "JadwalPiket" as JP
entity "GantiJadwalPiket" as GJP
entity "Absensi" as AB
entity "KepengurusanLab" as KEP

' ============================================
' SCENARIO 1: KELOLA PERIODE PIKET
' ============================================
group Scenario 1: Kelola Periode Piket
    AD -> UI: Akses menu Periode Piket
    UI -> PPC: GET /piket/periode-piket?kepengurusan_lab_id=X

    activate PPC
    PPC -> KEP: with(tahunKepengurusan, laboratorium).find(kepengurusan_lab_id)
    KEP --> PPC: kepengurusanLab
    PPC -> PP: where(kepengurusan_lab_id).orderBy(tanggal_mulai, desc).paginate()
    PP --> PPC: Paginated<PeriodePiket>
    PPC --> UI: Render PeriodePiket View + daftar periode
    deactivate PPC

    ' --- Tambah Periode ---
    AD -> UI: Klik "Tambah Periode" -> Isi Form
    AD -> UI: Input Nama, Tanggal Mulai, Tanggal Selesai, Is Active
    UI -> PPC: POST /piket/periode-piket

    activate PPC
    PPC -> PPC: validate(nama, tanggal_mulai, tanggal_selesai\n after_or_equal, kepengurusan_lab_id)

    alt Validation Failed
        PPC --> UI: Redirect Back + Error Messages
    else Valid
        PPC -> PPC: validateWeekdayPeriod(tanggal_mulai, tanggal_selesai)
        PPC -> PPC: checkOverlappingPeriods(null, mulai, selesai, kepengurusan_lab_id)

        alt Periode Tumpang Tindih
            PPC --> UI: Error: "Terdapat periode yang tumpang tindih"
        else Tidak Ada Overlap
            opt isactive = true
                PPC -> PP: where(kepengurusan_lab_id, isactive=true).update(isactive=false)
            end
            PPC -> PP: create(nama, tanggal_mulai, tanggal_selesai, isactive, kepengurusan_lab_id)
            PP --> PPC: periode_id
            PPC --> UI: Redirect Index + "Periode piket berhasil ditambahkan"
        end
    end
    deactivate PPC

    ' --- Toggle Active ---
    AD -> UI: Toggle status aktif pada periode
    UI -> PPC: PUT /piket/periode-piket/{id} {isactive: true}

    activate PPC
    PPC -> PP: findOrFail(id)
    PP --> PPC: PeriodePiket

    opt isactive = true
        PPC -> PP: where(kepengurusan_lab_id, isactive=true).update(isactive=false)
    end
    PPC -> PP: update(isactive)
    PP --> PPC: updated
    PPC --> UI: Redirect + "Periode berhasil diperbarui"
    deactivate PPC

    ' --- Hapus Periode ---
    AD -> UI: Klik "Hapus" pada periode
    UI -> PPC: DELETE /piket/periode-piket/{id}

    activate PPC
    PPC -> PP: findOrFail(id)
    PPC -> PP: absensi().exists()

    alt Memiliki Data Absensi
        PPC --> UI: Error: "Tidak dapat menghapus periode yang memiliki absensi"
    else Tidak Ada Absensi
        opt periode.isactive = true
            PPC -> PP: where(kepengurusan_lab_id, id != X).orderBy(tanggal_mulai, desc).first()
            PPC -> PP: update(isactive=true) [set periode terbaru menjadi aktif]
        end
        PPC -> PP: delete()
        PPC --> UI: Redirect + "Periode piket berhasil dihapus"
    end
    deactivate PPC
end

' ============================================
' SCENARIO 2: KELOLA JADWAL PIKET
' ============================================
group Scenario 2: Kelola Jadwal Piket
    AD -> UI: Akses menu Jadwal Piket
    UI -> JPC: GET /piket/jadwal-piket?kepengurusan_lab_id=X

    activate JPC
    JPC -> KEP: with(tahunKepengurusan, laboratorium).find(id)
    KEP --> JPC: kepengurusanLab

    alt kepengurusanLab Tidak Ditemukan
        JPC --> UI: Render View kosong + "Pilih lab dan tahun kepengurusan"
    else Ditemukan
        JPC -> JP: where(kepengurusan_lab_id).with(user.profile).get()
        JP --> JPC: Collection<JadwalPiket>
        JPC -> JPC: groupBy(hari) → senin, selasa, rabu, kamis, jumat
        JPC --> UI: Render JadwalPiket View (matriks Hari x Asisten)
    end
    deactivate JPC

    AD -> UI: Assign asisten ke slot hari -> Submit
    UI -> JPC: POST /piket/jadwal-piket

    activate JPC
    JPC -> JPC: validate(user_id, hari in [senin..jumat], kepengurusan_lab_id)

    alt Validation Failed
        JPC --> UI: Redirect Back + Errors
    else Valid
        JPC -> JP: create(user_id, hari, kepengurusan_lab_id)
        JP --> JPC: jadwal_id
        JPC --> UI: Redirect + "Jadwal berhasil ditambahkan"
    end
    deactivate JPC

    AD -> UI: Klik "Hapus" jadwal asisten
    UI -> JPC: DELETE /piket/jadwal-piket/{id}

    activate JPC
    JPC -> JP: findOrFail(id)
    JPC -> JP: delete()
    JPC --> UI: Redirect + "Jadwal berhasil dihapus"
    deactivate JPC
end

' ============================================
' SCENARIO 3: REQUEST GANTI JADWAL (ASISTEN)
' ============================================
group Scenario 3: Request Ganti Jadwal (Asisten)
    AS -> UI: Akses menu Ganti Jadwal Piket
    UI -> GJC: GET /piket/ganti-jadwal-piket

    activate GJC
    GJC -> GJC: getCurrentLab(auth()->user())

    alt Tidak Terdaftar di Lab Manapun
        GJC --> UI: Render View + "Anda tidak terdaftar di laboratorium manapun"
    else Terdaftar
        GJC -> PP: where(isactive=true, kepengurusan_lab_id).with(kepengurusanLab).first()

        alt Tidak Ada Periode Aktif
            GJC --> UI: Render View + "Tidak ada periode piket aktif saat ini"
        else Ada Periode Aktif
            GJC -> JP: where(user_id, kepengurusan_lab_id).get()
            GJC -> GJC: getHariTersedia(kepLabId, periodeId, userId)
            GJC -> GJP: where(user_id).with(jadwalPiket, periodePiket, approvedBy).paginate()
            GJP --> GJC: Paginated<GantiJadwalPiket>
            GJC --> UI: Render GantiJadwalPiket View (form + riwayat permintaan)
        end
    end
    deactivate GJC

    AS -> UI: Pilih jadwal, pilih hari baru, isi alasan -> Submit
    UI -> GJC: POST /piket/ganti-jadwal-piket

    activate GJC
    GJC -> GJC: validate(jadwal_piket_id, hari_baru in [senin..jumat], alasan min:10)
    GJC -> JP: findOrFail(jadwal_piket_id)

    rect rgb(255, 230, 230)
        note right of GJC: Ownership & Periode Check
        alt jadwalPiket.user_id != auth()->id()
            GJC --> UI: Error: "Anda tidak memiliki akses untuk mengubah jadwal ini"
        end
        alt Tidak ada periode piket aktif
            GJC --> UI: Error: "Tidak ada periode piket aktif saat ini"
        end
    end

    GJC -> GJC: getHariTersedia(kepengurusan_lab_id, periodeAktif.id)

    alt Hari Baru Tidak Tersedia
        GJC --> UI: Error: "Hari yang dipilih tidak tersedia"
    else Hari Tersedia
        GJC -> GJP: where(jadwal_piket_id, status=pending).first()

        alt Sudah Ada Permintaan Pending
            GJC --> UI: Error: "Sudah ada permintaan yang menunggu persetujuan"
        else Belum Ada
            GJC -> GJP: create(jadwal_piket_id, periode_piket_id, user_id,\n hari_lama, hari_baru, alasan, status=pending)
            GJP --> GJC: request_id
            GJC --> UI: Redirect Back + "Permintaan berhasil dikirim. Menunggu persetujuan admin"
        end
    end
    deactivate GJC
end

' ============================================
' SCENARIO 4: APPROVE/REJECT GANTI JADWAL (ADMIN)
' ============================================
group Scenario 4: Approve / Reject Ganti Jadwal (Admin)
    AD -> UI: Akses Dashboard Kelola Ganti Jadwal
    UI -> GJC: GET /piket/ganti-jadwal-piket/admin-dashboard

    activate GJC
    GJC -> GJC: getCurrentLab(auth()->user())

    alt Superadmin / Kadep (all_access)
        GJC -> KEP: with(laboratorium).find(kepengurusan_lab_id dari request)
    else Admin Lab Biasa
        GJC -> GJC: Ambil kepengurusan_lab_id dari getCurrentLab()
    end

    GJC -> GJP: whereHas(periodePiket, kepengurusan_lab_id)\n.with(user, jadwalPiket, periodePiket, approvedBy)\n.orderBy(created_at, desc).get()
    GJP --> GJC: Collection<GantiJadwalPiket>
    GJC --> UI: Render KelolaGantiJadwal View + list permintaan
    deactivate GJC

    AD -> UI: Klik "Approve" atau "Reject" + isi catatan (opsional)
    UI -> GJC: POST /piket/ganti-jadwal-piket/{id}/approve-reject

    activate GJC
    GJC -> GJC: validate(action in [approve, reject], catatan_admin nullable)
    GJC -> GJP: findOrFail(id)

    alt Status Bukan Pending
        GJC --> UI: JSON 400: "Permintaan ini sudah diproses sebelumnya"
    else Status Pending
        rect rgb(255, 230, 230)
            note right of GJC: Lab Access Check
            alt kepengurusan_lab_id tidak cocok dengan lab admin
                GJC --> UI: JSON 403: "Tidak memiliki akses untuk memproses permintaan ini"
            end
        end

        GJC -> GJP: update(status, approved_by=auth()->id(), approved_at=now(), catatan_admin)
        GJP --> GJC: updated

        alt action = approve
            GJC --> UI: JSON 200: "Permintaan ganti jadwal berhasil disetujui"
        else action = reject
            GJC --> UI: JSON 200: "Permintaan ganti jadwal ditolak"
        end
    end
    deactivate GJC
end

' ============================================
' SCENARIO 5: REKAP ABSENSI PIKET
' ============================================
group Scenario 5: Rekap Absensi Piket
    AD -> UI: Akses menu Rekap Piket
    UI -> PPC: GET /piket/absensi-rekap?kepengurusan_lab_id=X

    activate PPC
    PPC -> KEP: find(kepengurusan_lab_id)
    KEP --> PPC: kepengurusanLab

    alt Kepengurusan Tidak Ditemukan
        PPC --> UI: Render View kosong + "Pilih lab dan tahun"
    else Ditemukan
        PPC -> AB: where(kepengurusan_lab_id).with(user, jadwalPiket)\n.orderBy(tanggal, desc).paginate()
        AB --> PPC: Paginated<Absensi>
        PPC -> PPC: Calculate per user:\n- total hadir / izin / alpha\n- persentase kehadiran
        PPC --> UI: Render AbsensiRekap View + tabel rekap + statistik
    end
    deactivate PPC
end

@enduml
