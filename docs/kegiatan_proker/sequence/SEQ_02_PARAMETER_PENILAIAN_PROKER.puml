@startuml SEQ_02_PARAMETER_PENILAIAN_PROKER
!theme plain
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
title Sequence Diagram — SEQ-02: Mengelola Parameter Penilaian Proker

actor       "Admin / Asisten"           as Admin
boundary    "ProkerPage"                as Page
control     "ProkerParameterController" as Ctrl
entity      "ProkerParameter"           as ModelParam
database    "proker_parameter"          as DB

== Tambah Parameter Penilaian ==

Admin -> Page         : Isi form parameter & submit
Page  -> Ctrl         : POST /proker/{id}/parameter {nama_parameter, bobot, keterangan}
Ctrl  -> ModelParam   : Query total bobot saat ini
ModelParam -> DB      : SELECT SUM(bobot) FROM proker_parameter WHERE proker_id = ?
DB    --> ModelParam  : Total bobot saat ini
ModelParam --> Ctrl   : Total bobot saat ini
alt Total bobot melebihi 100%
  Ctrl --> Page  : Pesan error total bobot melebihi 100%
  Page --> Admin : Tampil pesan validasi
else Total masih <= 100%
  Ctrl  -> ModelParam : create({proker_id, nama_parameter, bobot, keterangan})
  ModelParam -> DB    : INSERT INTO proker_parameter
  DB    --> ModelParam : Berhasil
  Ctrl  --> Page      : Redirect dengan notifikasi sukses
  Page  --> Admin     : Tampil parameter baru di tabel
end

== Edit Parameter ==

Admin -> Page         : Klik Edit parameter & submit
Page  -> Ctrl         : PUT /proker-parameter/{id} {nama_parameter, bobot, keterangan}
Ctrl  -> ModelParam   : Query total bobot parameter lain
ModelParam -> DB      : SELECT SUM(bobot) FROM proker_parameter WHERE proker_id = ? AND id != {id}
DB    --> ModelParam  : Total bobot lain
ModelParam --> Ctrl   : Total bobot lain
alt Total melebihi 100%
  Ctrl --> Page  : Pesan error total bobot melebihi 100%
  Page --> Admin : Tampil pesan validasi
else Total <= 100%
  Ctrl  -> ModelParam : update({nama_parameter, bobot, keterangan})
  ModelParam -> DB    : UPDATE proker_parameter SET ... WHERE id = {id}
  DB    --> ModelParam : Berhasil
  Ctrl  --> Page      : Redirect dengan notifikasi sukses
  Page  --> Admin     : Tampil notifikasi sukses
end

== Update Capaian Parameter ==

Admin -> Page         : Isi nilai capaian & submit
Page  -> Ctrl         : PATCH /proker-parameter/{id}/capaian {capaian}
Ctrl  -> ModelParam   : update({capaian})
ModelParam -> DB      : UPDATE proker_parameter SET capaian = ? WHERE id = {id}
DB    --> ModelParam  : Berhasil
Ctrl  --> Page        : Redirect dengan notifikasi sukses
Page  --> Admin       : Tampil nilai capaian diperbarui

== Hapus Parameter ==

Admin -> Page         : Klik Hapus parameter & konfirmasi
Page  -> Ctrl         : DELETE /proker-parameter/{id}
Ctrl  -> ModelParam   : delete()
ModelParam -> DB      : DELETE FROM proker_parameter WHERE id = {id}
DB    --> ModelParam  : Berhasil
Ctrl  --> Page        : Redirect dengan notifikasi sukses
Page  --> Admin       : Tampil notifikasi sukses

@enduml
