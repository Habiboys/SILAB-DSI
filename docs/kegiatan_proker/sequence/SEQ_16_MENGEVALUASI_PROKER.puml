@startuml SEQ_16_MENGEVALUASI_PROKER
!theme plain
skinparam defaultFontSize 12
skinparam TitleFontSize 14
title Sequence Diagram — SEQ-16: Mengevaluasi Proker

actor       "Admin / Dosen / Kadep" as Evaluator
boundary    "ProkerPage"            as Page
control     "ProkerController"      as Ctrl
entity      "Proker"                as ModelProker

== Membuka Form Evaluasi Proker ==

Evaluator -> Page        : Buka detail proker, klik "Evaluasi Proker"

Page      -> Ctrl        : GET /proker/{id}

Ctrl      -> ModelProker : Query detail proker
ModelProker --> Ctrl     : Data proker
Ctrl      --> Page       : Render halaman detail proker + form evaluasi
Page      --> Evaluator  : Form evaluasi: kendala, solusi, saran

== Menyimpan Hasil Evaluasi ==

Evaluator -> Page        : Isi form evaluasi {kendala, solusi, saran} & submit

Page      -> Ctrl        : PATCH /proker/{id}/evaluasi {kendala, solusi, saran}

Ctrl -> ModelProker      : update({kendala, solusi, saran})
ModelProker --> Ctrl     : Berhasil
Ctrl --> Page            : Redirect dengan notifikasi sukses
Page --> Evaluator       : Notifikasi sukses, hasil evaluasi tampil di detail proker

@enduml