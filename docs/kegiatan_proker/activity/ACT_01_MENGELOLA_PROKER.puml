@startuml ACT_01_MENGELOLA_PROKER
!theme plain
!pragma useVerticalIf on
scale max 1400 width
skinparam wrapWidth 180
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-01 - Mengelola Proker (CRUD)

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka menu Proker;

|System|
:Ambil dan tampilkan daftar proker;

|Admin / Asisten|
:Pilih aksi;

if (Aksi?) then (Tambah)
  :Klik Tambah;
  :Isi form;
  |System|
  :Validasi input;
  if (Valid?) then (ya)
    :Simpan data proker;
    :Tampilkan notifikasi sukses;
  else (tidak)
    :Tampilkan pesan error;
  endif
elseif (Aksi?) then (Edit)
  |Admin / Asisten|
  :Klik Edit;
  :Ubah data;
  |System|
  :Validasi input;
  if (Valid?) then (ya)
    :Perbarui data proker;
    :Tampilkan notifikasi sukses;
  else (tidak)
    :Tampilkan pesan error;
  endif
else (Hapus)
  |Admin / Asisten|
  :Klik Hapus dan konfirmasi;
  |System|
  :Hapus data proker;
  :Tampilkan notifikasi sukses;
endif

|Admin / Asisten|
:Lihat hasil perubahan;
stop
@enduml
