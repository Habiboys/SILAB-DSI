@startuml ACT_01_MENGELOLA_PROKER
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-01 - Mengelola Proker / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka menu Proker;
|System|
:Query & Tampilkan daftar proker;
|Admin|
:Lihat daftar proker;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Proker;
  |Admin / Asisten|
  :Isi form proker;

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih proker yang diubah;
  |System|
  :Tampilkan Form Edit Proker;
  |Admin / Asisten|
  :Ubah data proker;

elseif (Aksi?) then (Hapus)
  :Klik Hapus, konfirmasi;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin / Asisten|
  :Konfirmasi penghapusan;

else (Ajukan)
  :Klik Ajukan, ubah status;
  |System|
  :Perbarui data;
  :Kirim notifikasi ke Kadep/Dosen;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
