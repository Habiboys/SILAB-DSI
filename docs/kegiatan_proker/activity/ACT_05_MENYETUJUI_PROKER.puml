@startuml ACT_05_MENYETUJUI_PROKER
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-05 - Menyetujui / Menolak Proker / Dosen / Kadep

|Admin / Dosen / Kadep|
|System|

|Admin / Dosen / Kadep|
start
:Buka menu Daftar Proker\n(filter: status diajukan);

|System|
:Ambil data proker;
:Tampilkan daftar proker\nyang perlu review;

|Admin / Dosen / Kadep|
:Pilih proker, baca detail;
:Ambil keputusan;

if (Keputusan?) then (Setuju)
  |Admin / Dosen / Kadep|
  :Klik Setujui\n;
  |System|
  :Perbarui data;
  :Kirim notifikasi ke Admin;
  :Tampilkan notifikasi sukses;
  |Admin / Dosen / Kadep|
  :Proker ditandai disetujui;

else (Tolak)
  |Admin / Dosen / Kadep|
  repeat
    :Klik Tolak, isi alasan penolakan;
    |System|
    :Periksa alasan tidak kosong;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin / Dosen / Kadep|
      :Isi alasan penolakan;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Perbarui data;
  :Kirim notifikasi ke Admin;
  :Tampilkan notifikasi sukses;
  |Admin / Dosen / Kadep|
  :Proker ditandai ditolak;

endif

stop
@enduml
