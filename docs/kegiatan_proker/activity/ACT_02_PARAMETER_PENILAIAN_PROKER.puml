@startuml ACT_02_PARAMETER_PENILAIAN_PROKER
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-02 - Mengelola Parameter Penilaian Proker / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka menu Parameter Penilaian Proker;
:Pilih aksi;

if (Aksi?) then (Lihat Daftar Parameter)
  |System|
  :Ambil data parameter penilaian proker;
  :Tampilkan daftar parameter;
  |Admin / Asisten|
  :Lihat daftar parameter;

elseif (Aksi?) then (Tambah Parameter)
  |Admin|
  repeat
    :Isi form;
    |System|
    :Periksa input;
    |Admin|
  repeat while (Form valid?) is (tidak) not (ya)

  |System|
  :Simpan data baru;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Parameter baru tersimpan;

elseif (Aksi?) then (Edit Parameter)
  |Admin|
  repeat
    :Klik Edit, ubah nama/bobot;
    |System|
    :Periksa kelengkapan form;
    |Admin|
  repeat while (Form valid?) is (tidak) not (ya)

  |System|
  :Perbarui data;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Parameter diperbarui;

else (Hapus Parameter)
  |Admin|
  :Klik Hapus, konfirmasi;
  |System|
  :Hapus data;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Parameter terhapus;

endif

stop
@enduml
