@startuml ACT_02_PARAMETER_PENILAIAN_PROKER
!theme plain
!pragma useVerticalIf on
scale max 1400 width
skinparam wrapWidth 180
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-02 - Mengelola Parameter Penilaian Proker

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka menu Parameter Penilaian;

|System|
:Ambil dan tampilkan daftar parameter;

|Admin / Asisten|
:Pilih aksi;

if (Aksi?) then (Tambah)
  :Klik Tambah;
  :Isi form;
  |System|
  :Validasi input;
  if (Valid?) then (ya)
    :Simpan parameter;
    :Tampilkan notifikasi sukses;
  else (tidak)
    :Tampilkan pesan error;
  endif
elseif (Aksi?) then (Edit)
  |Admin / Asisten|
  :Klik Edit;
  :Ubah data;
  |System|
  :Validasi input;
  if (Valid?) then (ya)
    :Perbarui parameter;
    :Tampilkan notifikasi sukses;
  else (tidak)
    :Tampilkan pesan error;
  endif
else (Hapus)
  |Admin / Asisten|
  :Klik Hapus dan konfirmasi;
  |System|
  :Hapus parameter;
  :Tampilkan notifikasi sukses;
endif

|Admin / Asisten|
:Lihat hasil perubahan;
stop
@enduml
