@startuml ACT_06_MENGELOLA_KEGIATAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200

skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-06 · Mengelola Kegiatan\nAktor: Admin

|Admin|
|System|

|Admin|
start
:Buka menu Kegiatan;
:Pilih aksi;

if (Aksi?) then (Lihat Daftar)
  |System|
  :Tampilkan daftar kegiatan;
  |Admin|
  :Lihat daftar kegiatan;

elseif (Aksi?) then (Tambah Kegiatan)
  |Admin|
  :Isi form kegiatan\n(nama, proker?, deskripsi,\ntanggal, tempat, target_peserta?);
  |System|
  :Periksa kelengkapan form;
  if (Form valid?) then (tidak)
    :Tampilkan pesan kesalahan;
    |Admin|
    :Perbaiki form;
  else (ya)
    :Simpan data baru;
    :Tampilkan notifikasi sukses;
    |Admin|
    :Kegiatan baru muncul di daftar;
  endif

elseif (Aksi?) then (Edit Kegiatan)
  |Admin|
  :Klik Edit ? ubah data;
  |System|
  :Periksa kelengkapan form;
  if (Form valid?) then (tidak)
    :Tampilkan pesan kesalahan;
  else (ya)
    :Perbarui data;
    :Tampilkan notifikasi sukses;
    |Admin|
    :Data kegiatan diperbarui;
  endif

elseif (Aksi?) then (Hapus Kegiatan)
  |Admin|
  :Klik Hapus ? konfirmasi;
  |System|
  :Hapus data;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Kegiatan terhapus dari daftar;

elseif (Aksi?) then (Ajukan Kegiatan)
  |Admin|
  :Klik Ajukan;
  |System|
  :Perbarui data;
  :Kirim notifikasi ke Kadep/Dosen;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Status kegiatan berubah menjadi Diajukan;

endif

stop
@enduml
