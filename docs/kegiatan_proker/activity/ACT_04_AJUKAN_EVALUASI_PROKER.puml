@startuml ACT_04_AJUKAN_EVALUASI_PROKER
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-04 - Mengajukan Evaluasi Proker\nAktor: Admin

|Admin|
|System|

|Admin|
start
:Buka detail proker\n(status: disetujui / selesai);
:Klik "Ajukan untuk Evaluasi";

repeat
  :Isi form evaluasi\n(capaian, kendala,\ncatatan evaluasi, bukti?);
  |System|
  :Periksa kelengkapan form;
  if (Form valid?) then (tidak)
    :Tampilkan pesan kesalahan;
    |Admin|
    :Perbaiki form;
  endif
repeat while (Form valid?) is (tidak) not (ya)
:Perbarui data;
:Simpan data evaluasi ke evaluasi_proker;
:Kirim notifikasi ke Dosen/Kadep;
:Tampilkan notifikasi sukses;
|Admin|
:Status proker berubah\nmenjadi Menunggu Evaluasi;

stop
@enduml
