@startuml ACT_08_PESERTA_KEGIATAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-08 - Mengelola Peserta Kegiatan / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail kegiatan, tab Peserta;
:Pilih aksi;

if (Aksi?) then (Lihat Daftar Peserta)
  |System|
  :Ambil data peserta_kegiatan;
  :Tampilkan daftar peserta\n+ kehadiran;
  |Admin / Asisten|
  :Lihat daftar peserta;

elseif (Aksi?) then (Tambah Peserta)
  |Admin / Asisten|
  repeat
    :Pilih peserta dari daftar anggota\natau input manual (nama, institusi?);
    |System|
    :Validasi\n(cek duplikat peserta);
    |Admin / Asisten|
  repeat while (Form valid?) is (tidak) not (ya)

  |System|
  :Simpan data baru;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Peserta ditambahkan ke daftar;

elseif (Aksi?) then (Import Peserta dari CSV)
  |Admin / Asisten|
  repeat
    :Upload file CSV peserta;
    |System|
    :Parse CSV;
    :Periksa format & data;
    |Admin / Asisten|
  repeat while (Form valid?) is (tidak) not (ya)

  |System|
  :Simpan data peserta secara massal;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Daftar peserta diperbarui;

else (Hapus Peserta)
  |Admin / Asisten|
  :Pilih peserta, klik Hapus;
  |System|
  :Hapus data;
  :Tampilkan notifikasi sukses;
  |Admin / Asisten|
  :Peserta dihapus dari daftar;

endif

stop
@enduml
