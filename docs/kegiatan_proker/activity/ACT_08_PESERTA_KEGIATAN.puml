@startuml ACT_08_PESERTA_KEGIATAN
!theme plain
!pragma useVerticalIf on
scale max 1400 width
skinparam wrapWidth 180
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-08 - Mengelola Peserta Kegiatan

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka detail kegiatan (tab Peserta);

|System|
:Ambil dan tampilkan daftar peserta;

|Admin / Asisten|
:Pilih aksi;

if (Aksi?) then (Tambah)
  :Klik Tambah;
  :Isi form;
  |System|
  :Validasi input;
  if (Valid?) then (ya)
    :Simpan data peserta;
    :Tampilkan notifikasi sukses;
  else (tidak)
    :Tampilkan pesan error;
  endif
elseif (Aksi?) then (Import)
  |Admin / Asisten|
  :Upload file peserta;
  |System|
  :Validasi format file;
  if (Valid?) then (ya)
    :Simpan data peserta;
    :Tampilkan notifikasi sukses;
  else (tidak)
    :Tampilkan pesan error;
  endif
else (Hapus)
  |Admin / Asisten|
  :Klik Hapus dan konfirmasi;
  |System|
  :Hapus data peserta;
  :Tampilkan notifikasi sukses;
endif

|Admin / Asisten|
:Lihat hasil perubahan;
stop
@enduml
