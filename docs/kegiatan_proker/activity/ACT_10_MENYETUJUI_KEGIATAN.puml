@startuml ACT_10_MENYETUJUI_KEGIATAN
!theme plain
!pragma useVerticalIf on
scale max 1500 width
skinparam wrapWidth 180
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-10 - Approval Kegiatan (Dosen dan Kadep)

|Dosen / Kadep|
|System|

|Dosen / Kadep|
start
:Buka daftar kegiatan
(status: diajukan);

|System|
:Ambil dan tampilkan daftar kegiatan;

|Dosen / Kadep|
:Pilih kegiatan;
:Ambil keputusan;

if (Keputusan?) then (Setuju)
  :Klik Setujui;
  |System|
  if (Approver = Dosen?) then (ya)
    :Perbarui status menjadi
menunggu_persetujuan_kadep;
    :Kirim notifikasi ke Kadep;
  else (tidak)
    :Perbarui status menjadi disetujui;
    :Kirim notifikasi ke pengaju;
  endif
  :Tampilkan notifikasi sukses;
  |Dosen / Kadep|
  :Persetujuan berhasil diproses;
else (Tolak)
  :Klik Tolak;
  :Isi alasan penolakan;
  |System|
  :Validasi alasan;
  if (Valid?) then (ya)
    :Perbarui status menjadi ditolak;
    :Simpan alasan;
    :Kirim notifikasi ke pengaju;
    :Tampilkan notifikasi sukses;
    |Dosen / Kadep|
    :Penolakan berhasil diproses;
  else (tidak)
    :Tampilkan pesan error;
    |Dosen / Kadep|
    :Perbaiki alasan;
  endif
endif

stop
@enduml
