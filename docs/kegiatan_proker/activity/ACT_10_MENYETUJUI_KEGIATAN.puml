@startuml ACT_10_MENYETUJUI_KEGIATAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-10 - Menyetujui / Menolak Kegiatan / Dosen / Kadep

|Admin / Dosen / Kadep|
|System|

|Admin / Dosen / Kadep|
start
:Buka menu Daftar Kegiatan\n(filter: status diajukan);

|System|
:Ambil data kegiatan;
:Tampilkan daftar kegiatan\nyang perlu review;

|Admin / Dosen / Kadep|
:Pilih kegiatan, baca detail;
:Ambil keputusan;

if (Keputusan?) then (Setuju)
  |Admin / Dosen / Kadep|
  :Klik Setujui\n;
  |System|
  :Perbarui data;
  :Kirim notifikasi ke Admin;
  :Tampilkan notifikasi sukses;
  |Admin / Dosen / Kadep|
  :Kegiatan ditandai disetujui;

else (Tolak)
  |Admin / Dosen / Kadep|
  repeat
    :Klik Tolak, isi alasan penolakan;
    |System|
    :Periksa alasan tidak kosong;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Admin / Dosen / Kadep|
      :Isi alasan penolakan;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  :Perbarui data;
  :Kirim notifikasi ke Admin;
  :Tampilkan notifikasi sukses;
  |Admin / Dosen / Kadep|
  :Kegiatan ditandai ditolak;

endif

stop
@enduml
