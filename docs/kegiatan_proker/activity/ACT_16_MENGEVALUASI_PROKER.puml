@startuml ACT_16_MENGEVALUASI_PROKER
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-16 - Mengevaluasi Proker\nAktor: Dosen / Kadep

|Dosen / Kadep|
|System|

|Dosen / Kadep|
start
:Buka menu Daftar Proker\n(filter: status menunggu_evaluasi);

|System|
:Ambil data proker;
:Tampilkan daftar proker\nyang perlu dievaluasi;

|Dosen / Kadep|
:Pilih proker, baca detail\n+ laporan evaluasi;

repeat
  :Isi form evaluasi\n(nilai per parameter,\ncatatan evaluator);
  |System|
  :Periksa input\n(semua parameter terisi);
  if (Form valid?) then (tidak)
    :Tampilkan pesan kesalahan;
    |Dosen / Kadep|
    :Lengkapi nilai;
  endif
repeat while (Form valid?) is (tidak) not (ya)
:Simpan data baru;
:Hitung nilai total\n(rata-rata berbobot per parameter);
:Perbarui data;
:Tampilkan notifikasi sukses;
|Dosen / Kadep|
:Evaluasi tersimpan;
:Proker ditandai sudah dievaluasi;

stop
@enduml
