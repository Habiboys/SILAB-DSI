@startuml ACT_12_MENGELOLA_KEPENGURUSAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-12 - Mengelola Kepengurusan\nAktor: Admin

|Admin|
|System|

|Admin|
start
:Buka menu Kepengurusan;
|System|
:Query & Tampilkan daftar kepengurusan;
|Admin|
:Lihat daftar kepengurusan;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Kepengurusan;
  |Admin|
  :Isi form kepengurusan\n(tahun_kepengurusan, lab,\ntanggal_mulai, tanggal_selesai);

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih data yang diubah;
  |System|
  :Tampilkan Form Edit Kepengurusan;
  |Admin|
  :Ubah data kepengurusan;

elseif (Aksi?) then (Hapus)
  :Klik Hapus, konfirmasi;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin|
  :Konfirmasi penghapusan;

else (Set Aktif)
  :Toggle status aktif kepengurusan;
  |System|
  :Perbarui data;
  |Admin|
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
  |Admin|
endif

stop
@enduml
