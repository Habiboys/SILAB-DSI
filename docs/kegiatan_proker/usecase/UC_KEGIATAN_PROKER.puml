@startuml UC_KEGIATAN_PROKER
!theme plain
skinparam defaultFontSize 12
skinparam TitleFontSize 14
title Use Case Diagram — Modul Kegiatan & Proker
left to right direction

actor "Admin"   as Admin
actor "Asisten" as Asisten
actor "Dosen"   as Dosen
actor "Kadep"   as Kadep
Admin --|> Asisten

rectangle "Modul Kegiatan & Proker" {
  usecase "UC01\nMengelola Proker" as UC01
  usecase "UC02\nMengelola Parameter Penilaian Proker" as UC02
  usecase "UC04\nMengajukan Proker" as UC04
  usecase "UC05\nMenyetujui / Menolak Proker" as UC05
  usecase "UC14\nMelihat Daftar Proker" as UC14
  usecase "UC16\nMengevaluasi Proker" as UC16

  usecase "UC06\nMengelola Kegiatan" as UC06
  usecase "UC07\nMengelola Laporan & Dokumentasi Kegiatan" as UC07
  usecase "UC08\nMengelola Peserta Kegiatan" as UC08
  usecase "UC09\nMengelola Sertifikat Kegiatan" as UC09
  usecase "UC10\nMenyetujui / Menolak Kegiatan" as UC10
  usecase "UC10A\nApproval Final Kegiatan (Kadep)" as UC10A
  usecase "UC11\nMelihat Kalender Kegiatan" as UC11
  usecase "UC15\nMelihat Daftar Kegiatan" as UC15

  usecase "UC12\nMengelola Kepengurusan" as UC12
  usecase "UC13\nMengelola Anggota" as UC13
}

Admin   --> UC01
Admin   --> UC02
Admin   --> UC04
Admin   --> UC06
Admin   --> UC07
Admin   --> UC08
Admin   --> UC09
Admin   --> UC12
Admin   --> UC13

Asisten --> UC01
Asisten --> UC02
Asisten --> UC04
Asisten --> UC07
Asisten --> UC08
Asisten --> UC11
Asisten --> UC14

Dosen   --> UC05
Dosen   --> UC10
Dosen   --> UC11
Dosen   --> UC14
Dosen   --> UC15
Dosen   --> UC16

Kadep   --> UC05
Kadep   --> UC10
Kadep   --> UC10A
Kadep   --> UC11
Kadep   --> UC14
Kadep   --> UC15
Kadep   --> UC16

UC10 .> UC10A : <<include>>

@enduml
