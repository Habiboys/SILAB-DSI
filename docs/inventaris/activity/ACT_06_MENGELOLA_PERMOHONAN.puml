@startuml ACT_06_MENGELOLA_PERMOHONAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-06 - Mengelola Permohonan Pengadaan

|Admin|
|System|

|Admin|
start
:Buka menu Permohonan Pengadaan;
|System|
:Query & Tampilkan daftar permohonan;
|Admin|
:Lihat daftar & status permohonan;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Permohonan;
  |Admin|
  :Isi form;

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih permohonan yang diubah;
  |System|
  :Tampilkan Form Edit Permohonan;
  |Admin|
  :Ubah data permohonan;

else (Hapus)
  :Pilih permohonan, klik Hapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
