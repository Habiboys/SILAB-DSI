@startuml ACT_11_REVIEW_PERMOHONAN_PENGADAAN_KALAB
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-11 - Mereview Permohonan Pengadaannu Permohonan Pengadaan;

|System|
:Tampilkan daftar permohonan menunggu review;

|Kalab|
:Pilih permohonan, baca detail;
:Berikan hasil review;

if (Hasil review?) then (Layak)
  |System|
  :Ubah status menjadi "direview_kalab";
  :Kirim notifikasi ke Kadep;
  |Kalab|
  :Review selesai;
else (Tidak layak)
  |Kalab|
  repeat
    :Isi alasan penolakan review;
    |System|
    :Periksa alasan tidak kosong;
    if (Form valid?) then (tidak)
      :Tampilkan pesan kesalahan;
      |Kalab|
      :Perbaiki alasan;
    endif
  repeat while (Form valid?) is (tidak) not (ya)
  |System|
  :Ubah status menjadi "ditolak_kalab";
  :Kirim notifikasi ke pengaju;
  |Kalab|
  :Review selesai;
endif

stop
@enduml
