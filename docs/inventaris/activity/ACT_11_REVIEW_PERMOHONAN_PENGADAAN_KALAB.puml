@startuml ACT_11_REVIEW_PERMOHONAN_PENGADAAN_KALAB
!theme plain
!pragma useVerticalIf on
scale max 1400 width
skinparam wrapWidth 180
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 200
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-11 - Review Permohonan Pengadaan (Kalab)

|Kalab|
|System|

|Kalab|
start
:Buka daftar permohonan
(status: menunggu_review_kalab);

|System|
:Ambil dan tampilkan data permohonan;

|Kalab|
:Pilih permohonan;
:Tinjau detail permohonan;
:Ambil keputusan review;

if (Hasil review?) then (Layak)
  :Klik Layak;
  |System|
  :Perbarui status menjadi direview_kalab;
  :Kirim notifikasi ke Kadep;
  :Tampilkan notifikasi sukses;
  |Kalab|
  :Review selesai (layak);
else (Tidak layak)
  repeat
    :Klik Tidak layak;
    :Isi alasan penolakan;
    |System|
    :Validasi form penolakan;
    if (Valid?) then (tidak)
      :Tampilkan pesan error;
      |Kalab|
      :Perbaiki alasan;
    endif
  repeat while (Valid?) is (tidak) not (ya)

  |System|
  :Perbarui status menjadi ditolak_kalab;
  :Simpan alasan penolakan;
  :Kirim notifikasi ke pengaju;
  :Tampilkan notifikasi sukses;
  |Kalab|
  :Review selesai (ditolak);
endif

stop
@enduml
