@startuml ACT_07_MENGAJUKAN_PERMOHONAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-07 - Mengajukan Permohonan Pengadaan\nAktor: Asisten

|Asisten|
|System|

|Asisten|
start
:Buka menu Permohonan Pengadaan;
:Klik "Ajukan Permohonan";

repeat
  :Isi form permohonan\n(nama_barang, qty, alasan,\nspesifikasi?, anggaran?);
  |System|
  :Periksa kelengkapan form;
  if (Form valid?) then (tidak)
    :Tampilkan pesan kesalahan;
    |Asisten|
    :Perbaiki form;
  endif
repeat while (Form valid?) is (tidak) not (ya)
:Simpan data baru;
:Tampilkan notifikasi sukses;
|Asisten|
:Permohonan terkirim;
:Tunggu review Admin / Kadep;

stop
@enduml
