@startuml ACT_08_APPROVAL_PERMOHONAN_KADEP
!theme plain
!pragma useVerticalIf on
scale max 1200 width
skinparam wrapWidth 160
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 200
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-08 - Approval Permohonan Pengadaan (Kadep)

|Kadep|
|System|

|Kadep|
start
:Buka daftar permohonan
(status: direview_kalab);

|System|
:Ambil dan tampilkan data permohonan;

|Kadep|
:Pilih permohonan;
:Ambil keputusan;

if (Keputusan?) then (Setuju)
  :Klik Setujui;
  |System|
  :Perbarui status menjadi disetujui_kadep;
  :Kirim notifikasi hasil;
  :Tampilkan notifikasi sukses;
  |Kadep|
  :Permohonan disetujui;
else (Tolak)
  repeat
    :Klik Tolak;
    :Isi alasan penolakan;
    |System|
    :Validasi form penolakan;
    if (Valid?) then (tidak)
      :Tampilkan pesan error;
      |Kadep|
      :Perbaiki alasan;
    endif
  repeat while (Valid?) is (tidak) not (ya)

  |System|
  :Perbarui status menjadi ditolak_kadep;
  :Simpan alasan penolakan;
  :Kirim notifikasi hasil;
  :Tampilkan notifikasi sukses;
  |Kadep|
  :Permohonan ditolak;
endif

stop
@enduml
