@startuml ACT_09_MENGELOLA_KATEGORI_ASET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-09 - Mengelola Kategori Aset

|Admin|
|System|

|Admin|
start
:Buka menu Kategori Aset\n(Data Master);
|System|
:Query & Tampilkan daftar kategori aset;
|Admin|
:Lihat daftar kategori;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Kategori;
  |Admin|
  :Isi form;

elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih kategori yang diubah;
  |System|
  :Tampilkan Form Edit Kategori;
  |Admin|
  :Ubah nama/deskripsi;

else (Hapus)
  :Pilih kategori, klik Hapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |Admin|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
