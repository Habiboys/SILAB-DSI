@startuml ACT_04_MENGELOLA_KONDISI_ASET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
title ACT-04 - Mengelola Kondisi Aset\nAktor: Admin

|Admin|
|System|

|Admin|
start
:Buka halaman detail aset;
|System|
:Query & Tampilkan riwayat kondisi;
|Admin|
:Lihat kondisi & riwayat;

if (Aksi?) then (Perbarui)
  :Tekan tombol Perbarui;
  |System|
  :Tampilkan Form Kondisi;
  |Admin|
  :Pilih kondisi baru\n(baik / rusak_ringan /\nrusak_berat / hilang)\n+ isi keterangan;

else (Lihat Riwayat)
  :Lihat histori perubahan kondisi;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
  |Admin|
endif

stop
@enduml
