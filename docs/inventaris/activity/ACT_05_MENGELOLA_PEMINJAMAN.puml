@startuml ACT_05_MENGELOLA_PEMINJAMAN
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12\nskinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-05 - Mengelola Peminjaman Aset / Asisten

|Admin / Asisten|
|System|

|Admin / Asisten|
start
:Buka menu Peminjaman Aset;
|System|
:Query & Tampilkan daftar peminjaman;
|Admin / Asisten|
:Lihat status peminjaman;

if (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Peminjaman;
  |Admin / Asisten|
  :Isi form;

elseif (Aksi?) then (Pengembalian)
  :Pilih peminjaman, klik Kembalikan;
  |System|
  :Tampilkan Form Pengembalian;
  |Admin / Asisten|
  :Isi form;

endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |Admin / Asisten|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
