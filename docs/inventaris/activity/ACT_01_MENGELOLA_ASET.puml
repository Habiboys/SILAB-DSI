@startuml ACT_01_MENGELOLA_ASET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black

title ACT-01 - Mengelola Aset\nAktor: Admin

|Admin|
|System|

|Admin|
start
:Buka menu Inventaris;
:Pilih aksi;

if (Aksi?) then (Lihat Daftar)
  |System|
  :Query daftar aset;
  :Tampilkan daftar aset;
  |Admin|
  :Lihat daftar aset;

elseif (Aksi?) then (Tambah Aset)
  |Admin|
  repeat
    :Isi form tambah aset;
    |System|
    :Validasi input;
    if (Valid?) then (gagal)
      :Tampilkan pesan error;
    endif
    |Admin|
  repeat while (Valid?) is (gagal) not (berhasil)
  |System|
  :Buat kode QR aset;
  :Simpan data aset;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Lihat aset baru di daftar;

elseif (Aksi?) then (Edit Aset)
  |Admin|
  repeat
    :Ubah data aset;
    |System|
    :Validasi input;
    if (Valid?) then (gagal)
      :Tampilkan pesan error;
    endif
    |Admin|
  repeat while (Valid?) is (gagal) not (berhasil)
  |System|
  :Perbarui data aset;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Lihat data yang diperbarui;

elseif (Aksi?) then (Hapus Aset)
  |Admin|
  :Klik Hapus & konfirmasi;
  |System|
  :Hapus data aset;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Aset hilang dari daftar;

else (Export / Label QR)
  |Admin|
  :Pilih aset & klik Export;
  |System|
  :Generate label QR;
  :Unduh file label;
  |Admin|
  :File label QR terunduh;

endif

stop
@enduml
