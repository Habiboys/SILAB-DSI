@startuml ACT_01_MENGELOLA_ASET
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200
skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 260
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline

title ACT-01 - Mengelola Aset

|SuperAdmin / Admin|
|System|

|SuperAdmin / Admin|
start
:Buka menu Inventaris;
|System|
:Query & Tampilkan daftar aset;
|SuperAdmin / Admin|
:Lihat daftar aset;

if (Aksi?) then (Export / Label QR)
  :Pilih aset & klik Export;
  |System|
  :Generate label QR;
  |SuperAdmin / Admin|
  :Unduh label QR;
elseif (Aksi?) then (Tambah)
  :Tekan tombol Tambah;
  |System|
  :Tampilkan Form Tambah;
  |SuperAdmin / Admin|
  :Isi data aset sesuai ketentuan;
elseif (Aksi?) then (Edit)
  :Tekan tombol Edit,\npilih data yang ingin diubah;
  |System|
  :Tampilkan Form Edit;
  |SuperAdmin / Admin|
  :Ubah data yang diinginkan;
else (Hapus)
  :Tekan tombol Hapus,\npilih data yang ingin dihapus;
  |System|
  :Tampilkan Konfirmasi Hapus;
  |SuperAdmin / Admin|
  :Konfirmasi penghapusan;
endif

|System|
:Melakukan Validasi;
if (Valid?) then (tidak)
  :Tampilkan Pesan Error;
  |SuperAdmin / Admin|
  :Perbaiki data;
  |System|
else (ya)
  :Tampilkan Pesan Sukses;
endif

stop
@enduml
