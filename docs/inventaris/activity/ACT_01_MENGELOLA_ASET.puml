@startuml ACT_01_MENGELOLA_ASET
!theme plain
skinparam defaultFontSize 12
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionStyle diamond

title ACT-01 - Mengelola Aset\nAktor: Admin

|Admin|
start
:Buka menu Inventaris;

switch (Pilih Aksi?)

case (Lihat Daftar)
  |System|
  :Query daftar aset;
  :Tampilkan daftar aset;
  |Admin|
  :Lihat daftar aset;

case (Tambah Aset)
  |Admin|
  repeat
    :Isi form tambah aset;
    |System|
    :Validasi input;
    if (Valid?) then (gagal)
      :Tampilkan pesan error;
    endif
    |Admin|
  repeat while (Perlu perbaiki?) is (Ya) not (Tidak)
  |System|
  :Buat kode QR aset;
  :Simpan data aset;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Lihat aset baru di daftar;

case (Edit Aset)
  |Admin|
  repeat
    :Ubah data aset;
    |System|
    :Validasi input;
    if (Valid?) then (gagal)
      :Tampilkan pesan error;
    endif
    |Admin|
  repeat while (Perlu perbaiki?) is (Ya) not (Tidak)
  |System|
  :Perbarui data aset;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Lihat data yang diperbarui;

case (Hapus Aset)
  |Admin|
  :Klik Hapus & konfirmasi;
  |System|
  :Hapus data aset;
  :Tampilkan notifikasi sukses;
  |Admin|
  :Aset hilang dari daftar;

case (Export / Label QR)
  |Admin|
  :Pilih aset & klik Export;
  |System|
  :Generate label QR;
  :Unduh file label;
  |Admin|
  :File label QR terunduh;

endswitch

stop
@enduml
