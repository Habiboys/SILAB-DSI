@startuml ACT_03_SCAN_QR_PUBLIK
!theme plain
!pragma useVerticalIf on
scale max 1600 width
skinparam wrapWidth 200

skinparam defaultFontSize 12
skinparam TitleFontSize 14
skinparam swimlaneWidth 220
skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ConditionEndStyle hline
title ACT-03 - Melihat Detail Aset Publik (Scan QR)

|Publik|
|System|

|Publik|
start
:Scan QR Code pada aset;

|System|
:Terima permintaan akses halaman aset publik;
:Cari data aset berdasarkan kode QR;

if (Aset ditemukan?) then (tidak)
  :Tampilkan pesan aset tidak ditemukan;
  |Publik|
  :Lihat pesan aset tidak ditemukan;
else (ya)
  :Ambil data aset publik;
  :Tampilkan halaman detail aset\n(tanpa login);
  |Publik|
  :Lihat detail aset\n(kondisi, lokasi, spesifikasi);
endif

stop
@enduml
