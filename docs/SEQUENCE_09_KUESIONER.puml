@startuml SEQUENCE_09_KUESIONER
scale 0.7
!theme plain
title Sequence Diagram - Modul Kuesioner/Survey

actor "Admin/Kadep" as AD
actor "User (Target)" as US
boundary "Browser" as UI
control "KuesionerController" as KC
control "ResponKuesionerController" as RKC
entity "Kuesioner" as KUE
entity "PertanyaanKuesioner" as PK
entity "TargetKuesioner" as TK
entity "ResponKuesioner" as RK
entity "JawabanKuesioner" as JK

' ============================================
' SCENARIO 1: MEMBUAT KUESIONER BARU
' ============================================
group Scenario 1: Membuat Kuesioner Baru
    AD -> UI: Akses menu Kuesioner -> Create
    UI -> KC: GET /kuesioner/create
    KC -> UI: Return Form View (Create.jsx)
    
    AD -> UI: Input Judul, Deskripsi, Tipe, Pertanyaan, Target
    UI -> KC: POST /kuesioner
    
    activate KC
    KC -> KC: validate(request)
    
    alt Validation Failed
        KC --> UI: Redirect Back + Error msg
    else Validation Success
        note over KC: DB Transaction Start
        KC -> KUE: create(judul, deskripsi, tipe, dll)
        activate KUE
        KUE --> KC: kuesioner_id
        deactivate KUE
        
        loop For each pertanyaan (if tipe=internal)
            KC -> PK: create(kuesioner_id, text, type, options)
        end
        
        loop For each target role
            KC -> TK: create(kuesioner_id, role_name)
        end
        
        note over KC: DB Transaction Commit
        KC --> UI: Redirect to Index + Success msg
    end
    deactivate KC
end

' ============================================
' SCENARIO 2: USER MENGISI KUESIONER
' ============================================
group Scenario 2: User Mengisi Kuesioner
    US -> UI: Klik Link / Menu Kuesioner
    UI -> KC: GET /kuesioner/{id}/participate
    
    activate KC
    KC -> KUE: findOrFail(id)
    KC -> TK: where(kuesioner_id).get()
    
    rect rgb(255, 230, 230)
        note right of KC: Authorization Check
        alt User Role NOT in Target Roles
             KC --> UI: Redirect Home + "Access Denied"
        end
    end

    KC -> RK: where(user_id, current_user).exists()
    
    alt Already Submitted
        KC --> UI: Redirect Home + "Already submitted"
    else Allowed
        KC --> UI: Return Participation View (Partisipasi.jsx)
    end
    deactivate KC
    
    US -> UI: Isi Form Jawaban -> Submit
    UI -> RKC: POST /kuesioner/{id}/submit
    
    activate RKC
    RKC -> RKC: validate(jawaban)
    
    note over RKC: DB Transaction Start
    RKC -> RK: create(kuesioner_id, user_id, now())
    activate RK
    RK --> RKC: respon_id
    deactivate RK
    
    loop For each jawaban
        RKC -> JK: create(respon_id, pertanyaan_id, text_jawaban)
    end
    
    note over RKC: DB Transaction Commit
    RKC --> UI: Redirect Dashboard + "Terima kasih"
    deactivate RKC
end

' ============================================
' SCENARIO 3: MELIHAT HASIL KUESIONER (ADMIN)
' ============================================
group Scenario 3: Admin Melihat Hasil Survey
    AD -> UI: Klik Detail Kuesioner -> Tab Results
    UI -> KC: GET /kuesioner/{id}/results
    
    activate KC
    KC -> KUE: with(['pertanyaan.jawaban', 'respon.user']).findOrFail(id)
    
    note right of KC: Statistic Calculation
    KC -> KC: calculateStats(kuesioner)
    note right of KC
        - Count total respondents
        - Aggregate radio/checkbox/scale answers
        - Collect text answers
    end note

    KC --> UI: Return Results View (Results.jsx)
    deactivate KC
    
    opt Export Data to Excel
        AD -> UI: Klik tombol "Export Excel"
        UI -> KC: GET /kuesioner/{id}/export
        activate KC
        KC -> KC: Generate Spreadsheet
        KC --> UI: Download Response (XLSX file)
        deactivate KC
    end
end

@enduml
